[Unit]
Description=Push seat-usage numbers to the phone widget's secret gist

[Service]
Type=oneshot
# gh and seat-usage live under ~/.local/bin and /usr/bin; systemd --user has a bare PATH.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/seat-usage-push

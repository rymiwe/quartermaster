[Unit]
Description=Pull seat-usage numbers from the secret gist

[Service]
Type=oneshot
# gh and seat-usage-push live under ~/.local/bin; systemd --user has a bare PATH.
Environment=PATH=%h/.local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/seat-usage-push --pull

#!/usr/bin/env python3
"""Push the seat-usage cache to a secret gist for the phone widget. Report-only.

The payload is an allowlist: per-seat percent, reset time, window, exhausted
flag and reading time, grouped into the status line's pools with their hues.
No token, cookie, email, plan line or `lines` text leaves the machine. The gist
is secret (unlisted), so anyone holding its id can read these numbers.

  seat-usage-push --setup     create the secret gist, print its id
  seat-usage-push             refresh a stale cache, then push if it changed;
                              logs one 'refresh' line to stderr per run
  seat-usage-push --dry-run   print the payload, push nothing
  seat-usage-push --pull      reader side: copy the gist's numbers into this
                              machine's cache; never runs seat-usage
  seat-usage-push --dry-run --cache   print the cache copy, push nothing

A systemd --user timer runs it every 5 minutes (systemd/ in quartermaster).
The widget is quartermaster's android/ and reads the gist through api.github.com.

The same gist also carries CACHE_FILE, a copy of latest.json cut to
CACHE_NUMBERS (numbers only), CACHE_FLAGS (true/false only) and as_of stamps
for known seats. No string from the cache is copied: no plan, status, lines,
errors, cookie flag or burn text. One machine (BLD) does every reading and
pushes; a reader (the shared VM) runs --pull and draws meters from that copy
without any vendor login. --pull filters again, so a gist edited by hand
still cannot put a string into the reader's cache. It also writes Muse's
muse-usage.json from the muse_* numbers so seat-meters can draw Muse.
"""
import hashlib, json, os, re, signal, subprocess, sys, tempfile, time

H = os.path.expanduser("~")
CACHE_DIR = os.environ.get("SEAT_USAGE_CACHE_DIR") or f"{H}/.cache/seat-usage"
CACHE = f"{CACHE_DIR}/latest.json"
LOCK = f"{CACHE_DIR}/.lock"
SEAT_USAGE = f"{H}/.local/bin/seat-usage"
CONFIG = f"{H}/.config/seat-usage/gist.json"
STATE = f"{H}/.local/state/seat-usage/push.json"
FILE = "seats.json"
CACHE_FILE = "latest.json"
MUSE_FILE = os.environ.get("SEAT_USAGE_MUSE_FILE") or f"{H}/.cache/quartermaster/muse-usage.json"
STALE_S = 600          # same threshold as the status line
HEARTBEAT_S = 1800     # push an unchanged payload this often so the widget's age stays honest
WEEK = 7 * 86400

# The status line's pools, in its order: id, name, hue (an xterm-256 index), the as_of
# key, then each seat's cache keys. The widget draws its rows from this.
POOLS = [
    ("cl", "Claude", 208, "claude", [
        dict(id="claude_5h", short="5h", label="Claude · 5h", pct="claude_5h",
             reset="claude_5h_reset_ts", window=5 * 3600, optional=True),
        dict(id="claude_week", short="wk", label="Claude · weekly", pct="claude_week",
             reset="claude_week_reset_ts", window=WEEK, pace="claude_week_pace", optional=True),
        dict(id="claude_fable", short="fable", label="Claude · Fable slice", pct="fable",
             reset="fable_reset_ts", window=WEEK, pace="fable_pace", optional=True),
    ]),
    ("cx", "Codex", 141, "chatgpt", [
        dict(id="codex", short="wk", label="Codex · weekly", pct="codex",
             reset="codex_reset_ts", window="codex_window_s", pace="codex_pace"),
    ]),
    ("cu", "Cursor", 43, "cursor", [
        dict(id="cursor_models", short="models", label="Cursor · Cursor Models", pct="cursor_auto_pct",
             reset="cursor_reset_ts", window="cursor_window_s", pace="cursor_auto_pace"),
        dict(id="cursor_other", short="other", label="Cursor · Other Models", pct="cursor_api_pct",
             reset="cursor_reset_ts", window="cursor_window_s", pace="cursor_api_pace"),
        dict(id="grokbot", short="bot", label="Grok Bot · weekly", pct="bot_pct",
             reset="bot_reset_ts", window="bot_window_s", pace="bot_pace",
             exhausted="bot_exhausted", optional=True, as_of="grokbot"),
    ]),
    ("gk", "SuperGrok", 75, "grok", [
        dict(id="supergrok", short="wk", label="SuperGrok · weekly", pct="grok_pct",
             reset="grok_reset_ts", window="grok_window_s", pace="grok_pace",
             exhausted="grok_exhausted"),
    ]),
]


# The reader's copy of latest.json: an allowlist, numbers only. Anything not
# named here, and any value of the wrong type, is dropped.
_GOOGLE = [f"google_{p}_{s}" for p in ("argon", "gemini", "claudegpt")
           for s in ("week", "week_reset_ts", "5h", "5h_reset_ts")]
CACHE_NUMBERS = frozenset([
    "ts", "v",
    "claude_5h", "claude_5h_reset_ts", "claude_week", "claude_week_reset_ts",
    "fable", "fable_reset_ts", "claude_renews_ts",
    "codex", "codex_reset_ts", "codex_window_s", "codex_5h", "codex_5h_reset_ts",
    "codex_age_h", "codex_renews_ts",
    "cursor_pct", "cursor_auto_pct", "cursor_api_pct", "cursor_reset_ts", "cursor_window_s",
    "cursor_ondemand", "cursor_ondemand_limit",
    "bot_pct", "bot_reset_ts", "bot_window_s",
    "grok_pct", "grok_reset_ts", "grok_window_s", "grok_402_h", "grok_renews_ts",
    "muse_5h", "muse_5h_reset_ts", "muse_week", "muse_week_reset_ts",
] + _GOOGLE)
CACHE_FLAGS = frozenset(["bot_exhausted", "grok_exhausted", "claude_renews", "codex_renews",
                         "cursor_renews", "grok_renews"])
AS_OF_SEATS = frozenset(["claude", "chatgpt", "cursor", "grokbot", "grok", "muse", "google"])


def _finite(v):
    return (isinstance(v, (int, float)) and not isinstance(v, bool)
            and v == v and v not in (float("inf"), float("-inf")))


def build_cache_copy(cache):
    """latest.json cut to the allowlist. Pure. Strings never survive."""
    cache = cache if isinstance(cache, dict) else {}
    out = {k: cache[k] for k in CACHE_NUMBERS if _finite(cache.get(k))}
    out.update({k: cache[k] for k in CACHE_FLAGS if isinstance(cache.get(k), bool)})
    as_of = cache.get("as_of") if isinstance(cache.get("as_of"), dict) else {}
    out["as_of"] = {k: v for k, v in as_of.items() if k in AS_OF_SEATS and _finite(v)}
    out["v"] = 1
    return out


def muse_doc(copy):
    """Muse's own file, rebuilt from the copied muse_* numbers. None without both windows."""
    p5, r5, pw, rw = (copy.get(k) for k in ("muse_5h", "muse_5h_reset_ts", "muse_week", "muse_week_reset_ts"))
    if not all(_finite(v) for v in (p5, r5, pw, rw)):
        return None
    at = (copy.get("as_of") or {}).get("muse") or copy.get("ts")
    iso = lambda t: time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))
    return {"captured_at": iso(at) if _finite(at) else None,
            "window": {"used_percent": p5, "window_duration_mins": 300, "resets_at": iso(r5)},
            "weekly": {"used_percent": pw, "resets_at": iso(rw)}}


def num(v):
    if isinstance(v, bool) or v is None or v == "":
        return None
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def build_payload(cache):
    """The widget's view of the cache. Pure: the same cache gives the same payload."""
    as_of = cache.get("as_of") if isinstance(cache.get("as_of"), dict) else {}
    pools = []
    for pid, name, hue, as_of_key, specs in POOLS:
        seats = []
        for sp in specs:
            pct = num(cache.get(sp["pct"]))
            exhausted = bool(sp.get("exhausted") and cache.get(sp["exhausted"]) is True)
            if pct is None and not exhausted and sp.get("optional"):
                continue   # the status line drops these rather than showing "?"
            w = sp["window"]
            window = w if isinstance(w, int) else num(cache.get(w))
            pace = cache.get(sp["pace"]) if sp.get("pace") else None
            seats.append({
                "id": sp["id"], "short": sp["short"], "label": sp["label"],
                "pct": 100.0 if exhausted else pct,
                "reset_ts": num(cache.get(sp["reset"])),
                "window_s": window if window and window > 0 else None,
                "pace": pace if pace in ("under", "on", "ahead") else "",
                "exhausted": exhausted,
                "as_of": num(as_of.get(sp.get("as_of", as_of_key))),
            })
        if seats:
            pools.append({"id": pid, "name": name, "hue": hue, "seats": seats})
    return {"v": 1, "ts": num(cache.get("ts")), "pools": pools}


def read_json(path):
    try:
        with open(path) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except Exception:
        return None


def write_json(path, d):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, path)


LOCK_WAIT_S = 60       # flock -w: wait this long for the status line's run, then give up
RUN_TIMEOUT_S = 90     # timeout(1) around seat-usage once the lock is held
KILL_AFTER_S = 10      # then SIGKILL, so a child ignoring SIGTERM cannot keep the lock
FUTURE_TS_S = 300      # a ts further ahead than this is unusable (skew, wrong unit); use mtime

# Shapes that may be a credential in seat-usage's stderr tail: cookie and
# authorization headers (to the end of the line), URL query values, key=value or "key": "value"
# pairs named like one, bearer/basic values, known token prefixes, JWTs, and any
# long run of token characters.
_KEY = (r"[\w.-]*(?:token|cookie|session|secret|passw\w*|api[_-]?key|sso|csrf)[\w.-]*"
        r"|auth|authorization|key|sid|pat")
_SECRET_RES = [re.compile(p, re.I) for p in (
    r"\b(?:set-)?cookie\b\s*[=:].*$",
    r"\b(?:proxy-)?authorization\b\s*[=:].*$",
    r"\b(?:bearer|basic)\s+\S+",
    r"[\"']?\b(?:" + _KEY + r")\b[\"']?\s*[=:]\s*(?:\"[^\"]*\"?|'[^']*'?|[^\s,;&}]+)",
    r"\b(?:sk|pk|rk|ops|ghp|gho|ghs|ghu|ghr|github_pat|xox[a-z])[-_][\w-]+",
    r"\beyJ[\w-]{10,}(?:\.[\w-]*)*",
    r"(?<=[?&])[^=\s&#]+=[^\s&#]*",         # URL query values
    r"(?<=://)[^/\s@]+@",                    # URL userinfo
    r"[A-Za-z0-9_\-+/=.%]{24,}",
)]


def scrub(line, cap=160):
    """One stderr line with anything token-shaped replaced by <redacted>, cut to cap."""
    line = "".join(c if c.isprintable() else " " for c in line).strip()
    for r in _SECRET_RES:
        line = r.sub("<redacted>", line)
    return line[:cap]


def cache_age(now=None):
    """(age of the reading in seconds or None, where it came from, age of the file's mtime or None).

    The reading's own ts wins; a cache without a usable ts falls back to mtime.
    """
    now = time.time() if now is None else now
    try:
        mtime_age = now - os.stat(CACHE).st_mtime
    except OSError:
        mtime_age = None
    d = read_json(CACHE)
    ts = d.get("ts") if d else None
    if _finite(ts) and 0 < ts <= now + FUTURE_TS_S:
        return now - ts, "ts", mtime_age
    by = "mtime(bad-ts)" if _finite(ts) and ts > now + FUTURE_TS_S else "mtime"
    return mtime_age, (by if mtime_age is not None else "none"), mtime_age


def _s(v):
    return "none" if v is None else f"{v:.0f}s"


def _log(msg):
    print(f"seat-usage-push: refresh {msg}", file=sys.stderr, flush=True)


def refresh_if_stale():
    """Refresh a stale cache under the status line's lock. Logs one line per call.

    Waits up to LOCK_WAIT_S (flock -w) for a status-line run holding the lock,
    then rechecks the age so a run that just landed a reading is not repeated.
    seat-usage inherits the held lock descriptor and adopts it. Only seat-usage's
    exit code and a scrubbed last stderr line are logged; stdout is discarded.
    """
    seen = "age=? by=?"
    try:
        age, by, mage = cache_age()
        seen = f"age={_s(age)} by={by} mtime_age={_s(mage)} stale_after={STALE_S}s"
        _refresh(age, seen)
    except Exception as e:   # still one line, and the push goes on with whatever cache there is
        _log(f"skip why=error exc={type(e).__name__} {seen}")


def _refresh(age, seen):
    if age is not None and age <= STALE_S:
        return _log(f"skip why=fresh {seen}")
    if not os.access(SEAT_USAGE, os.X_OK):
        return _log(f"skip why=not-executable {seen}")
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        fd = os.open(LOCK, os.O_RDWR | os.O_CREAT, 0o644)
    except OSError as e:
        return _log(f"skip why=lock-open-failed errno={e.errno} {seen}")
    try:
        t0 = time.monotonic()
        try:
            r = subprocess.run(["flock", "-w", str(LOCK_WAIT_S), "-E", "75", str(fd)], pass_fds=(fd,),
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                               timeout=LOCK_WAIT_S + 15)
            frc = r.returncode
        except (OSError, subprocess.TimeoutExpired) as e:
            frc = type(e).__name__
        wait = f"wait={time.monotonic() - t0:.1f}s"
        if frc != 0:
            if frc == 75:
                return _log(f"skip why=lock-busy lock=timeout {wait} {seen}")
            return _log(f"skip why=lock-error lock=error({frc}) {wait} {seen}")
        age2, by2, mage2 = cache_age()
        if age2 is not None and age2 <= STALE_S:
            return _log(f"skip why=fresh-after-wait lock=got {wait} {seen} new_age={_s(age2)} new_by={by2}")
        t1 = time.monotonic()
        tail = ""
        with tempfile.TemporaryFile() as err:   # a file, not a pipe: a lingering child cannot hang us
            try:
                # Its own session, so the backstop below can kill seat-usage too, not just timeout(1);
                # a survivor would keep the inherited lock and starve the status line.
                p = subprocess.Popen(["timeout", "-k", str(KILL_AFTER_S), str(RUN_TIMEOUT_S), SEAT_USAGE, "--quiet"],
                                     pass_fds=(fd,), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=err, start_new_session=True)
                try:
                    rc = p.wait(timeout=RUN_TIMEOUT_S + KILL_AFTER_S + 15)
                except subprocess.TimeoutExpired as e:
                    try:
                        os.killpg(p.pid, signal.SIGKILL)
                    except OSError:
                        pass
                    p.wait()
                    rc = type(e).__name__
            except OSError as e:
                rc = type(e).__name__
            err.seek(0, os.SEEK_END)
            start = max(0, err.tell() - 4096)
            err.seek(start)
            lines = err.read().decode("utf-8", "replace").splitlines()
            if start > 0 and lines:
                lines = lines[1:]   # a cut line may have lost the key that marks its value secret
            lines = [ln for ln in lines if ln.strip()]
            if lines:
                tail = scrub(lines[-1])
            elif start > 0:
                tail = "<truncated>"
        dur = f"dur={time.monotonic() - t1:.1f}s"
        # 124: timeout sent TERM; 137 or -9: it had to KILL the process group.
        timed = " timed-out" if rc == 124 else " killed" if rc in (137, -9) else ""
        age3, by3, _ = cache_age()
        msg = (f"ran rc={rc}{timed} {dur} lock=got {wait} {seen} new_age={_s(age3)} new_by={by3}")
        if tail:
            msg += f" stderr={json.dumps(tail)}"
        _log(msg)
    finally:
        os.close(fd)


def gh_api(method, path, body):
    r = subprocess.run(["gh", "api", "-X", method, path, "--input", "-"],
                       input=json.dumps(body), capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        msg = (r.stderr or r.stdout).strip().splitlines()
        raise RuntimeError(msg[-1] if msg else f"gh exited {r.returncode}")
    return json.loads(r.stdout or "{}")


def content(payload):
    return json.dumps(payload, separators=(",", ":"), sort_keys=True)


def setup():
    cfg = read_json(CONFIG)
    if cfg and cfg.get("id"):
        print(f"gist already set up: {cfg['id']}")
        return 0
    cache = read_json(CACHE) or {}
    try:
        g = gh_api("POST", "gists", {"public": False, "description": "seat-usage for the phone widget",
                                     "files": {FILE: {"content": content(build_payload(cache))}}})
    except Exception as e:
        print(f"seat-usage-push: gist create failed: {e}\n  the gh token needs the gist scope: gh auth refresh -s gist",
              file=sys.stderr)
        return 1
    write_json(CONFIG, {"id": g["id"]})
    print(f"secret gist created: {g['id']}\nenter this id (or {g.get('html_url')}) in the widget")
    return 0


def push():
    cfg = read_json(CONFIG)
    if not cfg or not cfg.get("id"):
        print("seat-usage-push: no gist yet; run seat-usage-push --setup", file=sys.stderr)
        return 1
    refresh_if_stale()
    cache = read_json(CACHE)
    if cache is None:
        print("seat-usage-push: no seat-usage cache", file=sys.stderr)
        return 1
    body = content(build_payload(cache))
    copy = content(build_cache_copy(cache))
    digest = hashlib.sha256((body + "\n" + copy).encode()).hexdigest()
    state = read_json(STATE) or {}
    now = time.time()
    if state.get("sha") == digest and now - (state.get("pushed_at") or 0) < HEARTBEAT_S:
        return 0
    payload = json.loads(body)
    payload["pushed_at"] = now
    # Seconds between the reading and this push; null without a usable reading time.
    # Kept out of the digest, like pushed_at, so it alone never forces a push.
    ts = payload.get("ts")
    payload["age_s"] = round(now - ts) if _finite(ts) and 0 < ts <= now + FUTURE_TS_S else None
    try:
        gh_api("PATCH", f"gists/{cfg['id']}", {"files": {FILE: {"content": content(payload)},
                                                         CACHE_FILE: {"content": copy}}})
    except Exception as e:
        print(f"seat-usage-push: push failed: {e}", file=sys.stderr)
        return 1
    write_json(STATE, {"sha": digest, "pushed_at": now})
    return 0


def gh_get(path):
    r = subprocess.run(["gh", "api", path], capture_output=True, text=True, timeout=30)
    if r.returncode != 0:
        msg = (r.stderr or r.stdout).strip().splitlines()
        raise RuntimeError(msg[-1] if msg else f"gh exited {r.returncode}")
    return json.loads(r.stdout or "{}")


def land(raw):
    """Write the filtered copy (and Muse's file) on the reader. Returns the copy."""
    copy = build_cache_copy(raw)
    # Set here, after the filter, so only --pull marks a copy (the allowlist
    # drops any pulled_ts that arrives in the gist). seat-usage's routes allow
    # a pulled reading ROUTE_FRESH_PULLED_S instead of ROUTE_FRESH_S.
    copy["pulled_ts"] = time.time()
    write_json(CACHE, copy)
    m = muse_doc(copy)
    if m is not None:
        write_json(MUSE_FILE, m)
    return copy


def pull():
    """Reader side. Never runs seat-usage and never needs a vendor login."""
    cfg = read_json(CONFIG)
    if not cfg or not cfg.get("id"):
        print(f"seat-usage-push: no gist id; put {{\"id\": \"<gist id>\"}} in {CONFIG}", file=sys.stderr)
        return 1
    try:
        f = (gh_get(f"gists/{cfg['id']}").get("files") or {}).get(CACHE_FILE) or {}
        raw = json.loads(f.get("content") or "null")
    except Exception as e:
        print(f"seat-usage-push: pull failed: {e}", file=sys.stderr)
        return 1
    if not isinstance(raw, dict) or not _finite(raw.get("ts")):
        print(f"seat-usage-push: gist has no {CACHE_FILE} yet; the pushing machine has not run", file=sys.stderr)
        return 1
    land(raw)
    return 0


def main():
    if "--setup" in sys.argv:
        return setup()
    if "--pull" in sys.argv:
        return pull()
    if "--dry-run" in sys.argv:
        cache = read_json(CACHE) or {}
        print(json.dumps(build_cache_copy(cache) if "--cache" in sys.argv else build_payload(cache), indent=2))
        return 0
    return push()


if __name__ == "__main__":
    sys.exit(main())

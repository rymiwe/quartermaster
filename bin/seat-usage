# Chair and builder are selected in _route_worker. The rule table no longer
# walls SuperGrok off from those roles (Ryan, 2026-10-08, routing principles).

def _is_number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)

def _fmt_pct(v):
    n = round(float(v), 1)
    text = f"{n:.1f}"
    return text[:-2] if text.endswith(".0") else text

def _window(meta, s):
    w = meta["window"]
    return s.get(w) if isinstance(w, str) else w

def pool_status(pool_id, s, now):
    """'unknown' | 'capped' | 'near_cap' | 'open' | 'under' | 'on' | 'ahead', plus why when unknown.

    The Fable slice is near_cap from 95% used until it caps. That band outranks pace.

    unknown when the seat has no as_of, the reading is older than 10 minutes,
    used% is absent or not a number (absent is never 0%), or the reset is
    missing or already past. grok is also capped when grok_exhausted.
    The 5h pool (pace False) is open when a fresh used% is 0 and reset is None
    (no session started). It returns 'open' when it is known and not capped.
    """
    meta = POOLS[pool_id]
    as_of = s.get("as_of") if isinstance(s.get("as_of"), dict) else {}
    stamp = as_of.get(meta["seat"])
    if not stamp:
        return "unknown", "no reading"
    # A term that ended before the reset leaves nothing to spend. Billing fact,
    # not a usage reading, so its age does not matter.
    reset = s.get(meta["reset"])
    end = effective_end(s, meta["seat"], reset)
    if _is_number(end) and end != reset and end <= now:
        return "capped", "term ended"
    age = now - stamp
    if age > ROUTE_FRESH_S:
        return "unknown", f"reading {int(age // 60)}m old"
    used = s.get(meta["used"])
    if not _is_number(used):
        return "unknown", "no used %"
    if not meta.get("pace", True) and used == 0 and reset is None:
        return "open", None
    if not _is_number(reset) or reset <= now:
        return "unknown", "reset passed"
    reset = end
    if (meta.get("exhausted") and s.get(meta["exhausted"])) or used >= 100:
        return "capped", None
    if pool_id == "fable" and used >= NEAR_CAP:
        return "near_cap", None
    if not meta.get("pace", True):
        return "open", None
    code = pace_code(used, reset, _window(meta, s), now)
    if not code:
        return "unknown", "no used %"
    if pool_id == "codex":
        five, five_at = s.get("codex_5h"), s.get("codex_5h_reset_ts")
        if _is_number(five) and five >= 100 and _is_number(five_at) and five_at > now:
            return "capped", _reopen(five_at, now)
    return code, None

def _pool_burning(pool_id, s, now):
    meta = POOLS[pool_id]
    for e in burn_entries(s, now):
        if e["seat"] == meta["seat"] and e["pool"] == meta.get("burn"):
            return True
    return False

def _reading_age(pool_id, s, now):
    seat = POOLS[pool_id]["seat"]
    as_of = s.get("as_of") if isinstance(s.get("as_of"), dict) else {}
    stamp = as_of.get(seat)
    if not stamp:
        return None
    return now - stamp

def _row(role, s, now, mode, reason, **over):
    base = ROLES[role]["default"]
    out = {"role": role, "seat": base["seat"], "family": base["family"], "effort": base["effort"],
           "variant": base["variant"], "mode": mode, "reason": reason,
           "reading_age_s": _reading_age(ROLES[role]["primary"], s, now)}
    for k in ("seat", "family", "effort", "variant"):
        if k in over:
            out[k] = over[k]
    return out

def _has_room(pool_id, states, s):
    """Known, under the near-cap line, and not capped. Pace does not matter."""
    if states[pool_id][0] not in ("under", "on", "ahead", "open"):
        return False
    used = s.get(POOLS[pool_id]["used"])
    return _is_number(used) and used < NEAR_CAP

def _rule_matches(rule, states, s, now):
    for pool, expected in rule["when"]:
        if expected == "burn":
            if not _pool_burning(pool, s, now):
                return False
        elif expected == "not_capped":
            if states[pool][0] not in ("under", "on", "ahead", "open"):
                return False
        elif expected == "room":
            if not _has_room(pool, states, s):
                return False
        elif states[pool][0] != expected:
            return False
    return True

def _apply_rule(role, rule, s, now, states):
    over = {k: rule[k] for k in ("seat", "family", "effort", "variant") if k in rule}
    reason = rule.get("reason")
    if reason is None and rule.get("ask_pools"):
        unknown = [POOLS[p]["label"] for p in rule["ask_pools"] if states[p][0] == "unknown"]
        capped = [POOLS[p]["label"] for p in rule["ask_pools"] if states[p][0] == "capped"]
        if unknown:
            reason = f"{', '.join(unknown)} reading unknown: {_FIX_ASK}"
        else:
            reason = f"{', '.join(capped) or 'no fallback'} capped: {_ASK}"
    if reason and "{pct}" in reason:
        reason = reason.format(pct=_fmt_pct(s.get(POOLS[ROLES[role]["primary"]]["used"])))
    notes = [f"{POOLS[p]['label']} reading unknown: fix the failed reading"
             for p in rule.get("note_unknown") or () if states[p][0] == "unknown"]
    if notes and reason is not None:
        reason = reason + "; " + "; ".join(notes)
    session = states.get("codex", (None, None))[1]
    names_codex_cap = any(pool == "codex" and expected == "capped" for pool, expected in rule["when"])
    if names_codex_cap and isinstance(session, str) and session.startswith("resets ") and reason:
        reason = f"{reason}, {session}"
    return _row(role, s, now, rule["mode"], reason or "", **over)

def route(role, s, now):
    """One role's routing row from a SUMMARY-shaped dict. Pure: does not read the network or the clock."""
    if role in ("chair", "builder"):
        return _route_worker(role, s, now)
    states = {pid: pool_status(pid, s, now) for pid in POOLS}
    primary = ROLES[role]["primary"]
    st, why = states[primary]
    for rule in ROUTE_RULES:
        if rule["role"] != role:
            continue
        if st == "unknown" and any(pool == primary for pool, _expected in rule["when"]):
            continue
        if _rule_matches(rule, states, s, now):
            return _apply_rule(role, rule, s, now, states)
    if st == "unknown":
        label = POOLS[primary]["label"]
        return _row(role, s, now, "default", f"{label}: {why}")
    return _row(role, s, now, "default", f"{st}: no rule")

def format_route(row):
    age = row.get("reading_age_s")
    shown = "unknown" if age is None else f"{int(age // 60)}m"
    return (f"route: {row['role']} | {row['seat']} | {row['family']} | {row['effort']} | "
            f"{row['variant']} | {row['mode']} | {row['reason']} | reading {shown}")

def line_seat(line):
    return line.split("|", 1)[0].strip()

def merge_summary(base, fresh, seats, now=None):
    """Replace seats that succeeded in fresh; drop as_of on a failed reread and keep old numbers."""
    if now is None:
        now = NOW
    out = dict(base)
    out["as_of"] = dict(base.get("as_of") or {})
    fresh_as_of = fresh.get("as_of") or {}
    seat_set = list(seats)
    kept_base = set()
    for seat in seat_set:
        if seat in fresh_as_of:
            base_stamp = out["as_of"].get(seat)
            fresh_stamp = fresh_as_of[seat]
            if _is_number(base_stamp) and _is_number(fresh_stamp) and fresh_stamp < base_stamp:
                kept_base.add(seat)
                continue
            for k in SEAT_KEYS[seat]:
                if k in fresh:
                    out[k] = fresh[k]
                else:
                    out.pop(k, None)
            out["as_of"][seat] = fresh_as_of[seat]
        else:
            out["as_of"].pop(seat, None)
            if seat == "grok":
                out["grok_exhausted"] = bool(out.get("grok_exhausted") or fresh.get("grok_exhausted"))
                if "grok_402_h" in fresh:
                    out["grok_402_h"] = fresh["grok_402_h"]
                if "grok_cookie_ok" in fresh:
                    out["grok_cookie_ok"] = fresh["grok_cookie_ok"]
    fresh_lines, old_lines = {}, {}
    for ln in fresh.get("lines") or []:
        fresh_lines.setdefault(line_seat(ln), []).append(ln)
    for ln in base.get("lines") or []:
        old_lines.setdefault(line_seat(ln), []).append(ln)
    merged, seen = [], set()
    for seat in LINE_SEATS:
        seen.add(seat)
        if seat in seat_set and seat in fresh_lines and seat not in kept_base:
            merged.extend(fresh_lines[seat])
        elif seat in old_lines:
            merged.extend(old_lines[seat])
    for seat, lns in old_lines.items():
        if seat not in seen:
            merged.extend(lns)
    out["lines"] = merged
    out["burn"] = burn_entries(out, now)
    base_ts = base.get("ts")
    out["ts"] = base_ts if _is_number(base_ts) else fresh.get("ts", now)
    out["v"] = 1
    return out

def _load_cache():
    try:
        with open(CACHE) as f:
            d = json.load(f)
        if isinstance(d, dict):
            d.setdefault("as_of", {})
            d.setdefault("lines", [])
            return d
    except Exception:
        pass
    return {"ts": 0, "as_of": {}, "v": 1, "lines": []}

LOCK_TIMEOUT = 30

class _LockHandle:
    """Cache lock. owned=False is an inherited descriptor and must not be unlocked."""

    def __init__(self, fh, owned):
        self.fh = fh
        self.owned = owned

def _fd_stat(fd):
    try:
        return os.stat(f"/proc/self/fd/{fd}")
    except OSError:
        return None

def _snapshot_inherited_fds():
    """Identity of every fd open at import.

    The status line runs `( flock -n 9 && seat-usage ) 9>cache/.lock`, so the
    child inherits fd 9 on the same open file description that already holds
    LOCK_EX. Opening .lock again and flocking that new descriptor blocks against
    the parent until the parent exits. A fd this process opens later is a
    different description; recording the startup inode keeps a reused fd number
    from being treated as the parent's lock.
    """
    found = {}
    try:
        names = os.listdir("/proc/self/fd")
    except OSError:
        return found
    for name in names:
        if not name.isdigit():
            continue
        fd = int(name)
        st = _fd_stat(fd)
        if st is not None:
            found[fd] = (st.st_dev, st.st_ino)
    return found

_INHERITED_FDS = _snapshot_inherited_fds()

def _targets_lock(fd, path, path_dev_ino):
    st = _fd_stat(fd)
    if st is not None and path_dev_ino is not None and (st.st_dev, st.st_ino) == path_dev_ino:
        return st
    try:
        if os.path.realpath(os.readlink(f"/proc/self/fd/{fd}")) == os.path.realpath(path):
            return st
    except OSError:
        return None
    return None

def _adopt_inherited_lock(path):
    """Use an inherited fd on the lock file if that description already holds it."""
    try:
        st = os.stat(path)
        path_dev_ino = (st.st_dev, st.st_ino)
    except OSError:
        path_dev_ino = None
    try:
        names = os.listdir("/proc/self/fd")
    except OSError:
        return None
    for name in names:
        if not name.isdigit():
            continue
        fd = int(name)
        ident = _INHERITED_FDS.get(fd)
        if ident is None:
            continue
        st = _targets_lock(fd, path, path_dev_ino)
        if st is None or (st.st_dev, st.st_ino) != ident:
            continue
        try:
            # Succeeds when this open file description already holds LOCK_EX.
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            continue
        return _LockHandle(fd, owned=False)
    return None

def _acquire_lock(timeout):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
    except Exception:
        return None
    path = f"{CACHE_DIR}/.lock"
    inherited = _adopt_inherited_lock(path)
    if inherited is not None:
        return inherited
    try:
        fh = open(path, "a+")
    except Exception:
        return None
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return _LockHandle(fh, owned=True)
        except OSError:
            if time.monotonic() >= deadline:
                try:
                    fh.close()
                except Exception:
                    pass
                return None
            time.sleep(0.05)

def _release_lock(held):
    if held is None or not held.owned:
        return
    fh = held.fh
    try:
        fcntl.flock(fh, fcntl.LOCK_UN)
    except Exception:
        pass
    try:
        fh.close()
    except Exception:
        pass

def _read_jobs(jobs):
    lines = []
    for fn in jobs:
        try:
            lines += fn() or []
        except Exception as e:
            lines.append(f"{fn.__name__:8} | error {e.__class__.__name__}")
    return lines

def _store_merged(base, lines, seats, now, stamp_now):
    """Merge seat reads into base, write the cache, and stamp mtime to ts."""
    global SUMMARY
    fresh = dict(SUMMARY)
    fresh["as_of"] = dict(SUMMARY.get("as_of") or {})
    fresh["lines"] = lines
    fresh["ts"] = now
    merged = merge_summary(base, fresh, seats, now=now)
    if stamp_now:
        merged["ts"] = now
    SUMMARY = merged
    write_cache()
    try:
        os.utime(CACHE, (merged["ts"], merged["ts"]))
    except Exception:
        pass
    return merged

def refresh(seats):
    """Reread the named seats under the status-line lock and merge them into the cache.

    Seats are claude, chatgpt (codex), cursor (also grokbot), grok. Waits up to 30s
    for ~/.cache/seat-usage/.lock; on timeout returns the cache unchanged.
    """
    global SUMMARY
    wanted = set(seats)
    lock = _acquire_lock(LOCK_TIMEOUT)
    base = _load_cache()
    if lock is None:
        return base
    try:
        SUMMARY = {"ts": time.time(), "as_of": {}, "v": 1}
        jobs, merge_seats = [], []
        if "claude" in wanted:
            jobs.append(claude)
            merge_seats.append("claude")
        if "chatgpt" in wanted or "codex" in wanted:
            jobs.append(codex)
            merge_seats.append("chatgpt")
        if "cursor" in wanted or "grokbot" in wanted:
            jobs.append(cursor)
            merge_seats.extend(("cursor", "grokbot"))
        if "grok" in wanted:
            jobs.append(grok)
            merge_seats.append("grok")
        lines = _read_jobs(jobs)
        return _store_merged(base, lines, merge_seats, time.time(), stamp_now=False)
    finally:
        _release_lock(lock)

# Vendor is the model provider, not the seat that is billed (Ryan, 2026-10-08).
FAMILY_VENDOR = {
    "grok": "xai",
    "opus": "anthropic",
    "fable": "anthropic",
    "astra": "openai",
    "sol": "openai",
}
_VENDOR_NAME = {"xai": "xAI", "anthropic": "Anthropic", "openai": "OpenAI"}
_FAMILY_NAME = {"fable": "Fable", "astra": "Astra", "grok": "Grok", "opus": "Opus"}

# Voter effort follows the same burn rule as chair and builder. Grok is on the
# roster and is excluded when its vendor chairs or builds, and is not seated
# on a pool that is over pace.
VOTER_ROSTER = (
    {"family": "fable", "seat": "claude", "pools": ("fable", "claude_week", "claude_5h")},
    {"family": "astra", "seat": "chatgpt", "pools": ("codex",)},
    {"family": "grok", "seat": "grok", "pools": ("grok",)},
)
# lineup and host are not in ROLES: `--route` with no role stays the four
# launch roles the hook already prints.
LINEUP_SEATS = ("cursor", "claude", "chatgpt", "grok")
HOST_SEATS = ("grokbot", "claude")


def _with_vendor(row):
    out = dict(row)
    out["vendor"] = FAMILY_VENDOR.get(out.get("family"))
    return out


def _voter_state(spec, states):
    seen = [states[pool][0] for pool in spec["pools"]]
    if "unknown" in seen:
        return "unknown"
    if "capped" in seen:
        return "capped"
    return "open"


def _join_open(a, b):
    """unknown if either reading is unknown, capped if either is capped, else the first state."""
    if a == "unknown" or b == "unknown":
        return "unknown"
    if a == "capped" or b == "capped":
        return "capped"
    return a


def _usage_snapshot(states, s):
    out = {}
    for pid, meta in POOLS.items():
        out[pid] = {"state": states[pid][0], "used_pct": s.get(meta["used"])}
    return out


def _stalest_age(pool_ids, s, now):
    ages = [age for pid in pool_ids if (age := _reading_age(pid, s, now)) is not None]
    if not ages:
        return None
    return max(ages)


def _party(row):
    return {"role": row.get("role"), "seat": row.get("seat"), "family": row.get("family"),
            "vendor": row.get("vendor"), "effort": row.get("effort"), "variant": row.get("variant", "-")}


def _rule_text(chair, builder, voters):
    names = " and ".join(_FAMILY_NAME.get(v["family"], v["family"]) for v in voters)
    chair_name = _VENDOR_NAME.get(chair["vendor"], chair["vendor"])
    builder_name = _VENDOR_NAME.get(builder["vendor"], builder["vendor"])
    if chair["vendor"] == builder["vendor"]:
        return f"{chair_name} chairs and builds: {names} vote"
    return f"{chair_name} chairs and {builder_name} builds: {names} vote"


def _snapshot_age(s, now):
    """Age of the oldest pool the usage object includes. None when none are stamped."""
    return _stalest_age(tuple(POOLS), s, now)


def _lineup_ask(s, now, states, reason, alternatives):
    age = _snapshot_age(s, now)
    return {"role": "lineup", "mode": "ask", "reason": reason, "rule": reason, "lineup": None,
            "legal_candidates": [], "alternatives": alternatives,
            "reading_age_s": age, "usage": _usage_snapshot(states, s), "usage_age_s": age}


def _unknown_text(label, why):
    """An aged reading says it is old. A missing stamp or used% is a failed reading."""
    why = why or "unknown"
    if why.startswith("reading ") and why.endswith(" old"):
        return f"{label} {why}: {_ASK}"
    return f"{label} reading unknown: {_FIX_ASK}"


def _reopen(ts, now):
    """When a window reopens, from the caller's clock. No new threshold."""
    if not _is_number(ts) or ts <= now:
        return "reset already passed"
    d = ts - now
    if d < 86400:
        return f"resets in {d / 3600:.1f}h"
    return f"resets in {d / 86400:.1f}d"


def _serving(family):
    return [pid for pid, meta in POOLS.items() if family in meta.get("serves", ())]


def _effort_for(pool_id, s, now, states, default="high"):
    """High, xhigh on an existing burn, low when the pool is ahead of pace.

    near_cap still has a pace (the band only outranks pace in the bounded-question
    rules). Builder and chair pass their own default.
    """
    if _pool_burning(pool_id, s, now):
        return "xhigh", "burn"
    state = states[pool_id][0]
    if state == "near_cap":
        meta = POOLS[pool_id]
        state = pace_code(s.get(meta["used"]), s.get(meta["reset"]), _window(meta, s), now) or state
    if state == "ahead":
        return "low", "suggest"
    return default, "default"


def _spend_first(band, s, now):
    """Burning pools first (soonest reset), then a pool with nothing unique to keep."""
    def key(pid):
        reset = s.get(POOLS[pid]["reset"])
        reset = reset if _is_number(reset) else 0
        unique = 1 if POOLS[pid].get("only") else 0
        if _pool_burning(pid, s, now):
            return (0, reset, unique)
        return (1, unique, 0)
    return sorted(band, key=key)[0]


def _grok_pools(states):
    """'pool' plus a pool id, 'ask' plus unknown ids, 'over', or 'capped'.

    A pool that is under or on pace wins over an unknown sibling. Opus is reached
    only when every Grok pool is known and over pace, or every one is capped.
    One ahead pool with a capped sibling stays on that ahead pool: both are not
    over pace, so Opus does not take over.
    """
    pools = _serving("grok")
    known, unknown = [], []
    for pid in pools:
        state = states[pid][0]
        if state == "unknown":
            unknown.append(pid)
        else:
            known.append((pid, state))
    under = [pid for pid, state in known if state == "under"]
    on = [pid for pid, state in known if state == "on"]
    ahead = [pid for pid, state in known if state == "ahead"]
    if under:
        return "pool", under
    if on:
        return "pool", on
    if ahead and not unknown:
        if len(known) == len(pools) and all(state == "ahead" for _, state in known):
            return "over", None
        return "pool", ahead
    if unknown:
        return "ask", unknown
    return "capped", None


def _ask_row(role, s, now, reason):
    return _row(role, s, now, "ask", reason)


def _grok_reason(pid, state, effort, mode):
    where = "Cursor" if pid == "cursor_models" else "SuperGrok"
    label = POOLS[pid]["label"]
    if mode == "burn":
        return f"Grok on {where}: {label} burn, effort {effort}"
    if state == "ahead":
        return f"Grok on {where}: {label} ahead of pace, effort {effort}"
    if state == "under":
        return f"Grok on {where}: {label} under pace"
    if state == "on":
        return f"Grok on {where}: {label} on pace"
    return f"Grok on {where}: {label} {state}"


def _grok_row(role, pid, s, now, states):
    effort, mode = _effort_for(pid, s, now, states, default="high")
    variant = "fast" if POOLS[pid]["seat"] == "cursor" else "-"
    reason = _grok_reason(pid, states[pid][0], effort, mode)
    row = _row(role, s, now, mode, reason, seat=POOLS[pid]["seat"], family="grok",
               effort=effort, variant=variant)
    row["reading_age_s"] = _reading_age(pid, s, now)
    return row


def _opus_phrase(role, effort):
    if role == "builder" and effort == "low":
        return "Opus at low on Max"
    return f"Opus on Max at {effort}"


def _max_unknown_reason(states):
    labels = (("claude_week", "Max weekly"), ("claude_5h", "Max 5h"))
    parts, failed = [], False
    for pid, label in labels:
        if states[pid][0] != "unknown":
            continue
        why = states[pid][1] or "unknown"
        if why.startswith("reading ") and why.endswith(" old"):
            parts.append(f"{label} {why}")
        else:
            failed = True
            parts.append(f"{label} reading unknown")
    body = "; ".join(parts) or "Max reading unknown"
    return f"{body}: {_FIX_ASK if failed else _ASK}"


def _opus_row(role, s, now, states, prefix):
    """Opus chair at high, Opus builder at low, unless that pool is burning or ahead."""
    state = _join_open(states["claude_week"][0], states["claude_5h"][0])
    if state == "unknown":
        return _ask_row(role, s, now, f"{prefix}: {_max_unknown_reason(states)}")
    if state == "capped":
        return _ask_row(role, s, now, f"{prefix} and Max capped: {_ASK}")
    default = "low" if role == "builder" else "high"
    effort, mode = _effort_for("claude_week", s, now, states, default=default)
    if mode == "default":
        mode = "suggest"
    reason = f"{prefix}: {_opus_phrase(role, effort)}"
    row = _row(role, s, now, mode, reason, seat="claude", family="opus", effort=effort, variant="-")
    row["reading_age_s"] = _reading_age("claude_week", s, now)
    return row


def _xai_worker(role, s, now, states):
    """A Grok chair or builder, an ask row, or None when xAI has no usable pool."""
    kind, band = _grok_pools(states)
    if kind == "pool":
        return _grok_row(role, _spend_first(band, s, now), s, now, states)
    if kind == "ask":
        parts, failed = [], False
        for pid in band:
            why = states[pid][1] or "unknown"
            label = POOLS[pid]["label"]
            if why.startswith("reading ") and why.endswith(" old"):
                parts.append(f"{label} {why}")
            else:
                failed = True
                parts.append(f"{label} reading unknown")
        return _ask_row(role, s, now, f"{'; '.join(parts)}: {_FIX_ASK if failed else _ASK}")
    return None


def _route_worker(role, s, now, states=None):
    """Chair and builder. Same pools, so the two rows cannot disagree on the Grok seat."""
    if states is None:
        states = {pid: pool_status(pid, s, now) for pid in POOLS}
    got = _xai_worker(role, s, now, states)
    if got is not None:
        return got
    kind, _band = _grok_pools(states)
    prefix = "both Grok pools over pace" if kind == "over" else "both Grok pools capped"
    return _opus_row(role, s, now, states, prefix)


def _constrained_worker(family, role, s, now, states):
    """The caller's family, or None when that family's pool is capped.

    An unknown reading is an ask. A family that is not a capable chair or builder
    is an ask. None means the caller should use the unconstrained route.
    """
    if family == "grok":
        return _xai_worker(role, s, now, states)
    if family == "opus":
        state = _join_open(states["claude_week"][0], states["claude_5h"][0])
        if state == "unknown":
            return _ask_row(role, s, now, _max_unknown_reason(states))
        if state == "capped":
            return None
        return _opus_row(role, s, now, states, "builder family opus")
    return _ask_row(role, s, now, f"builder family {family} is not a capable builder: {_ASK}")


def _resolve_builder(family, s, now, states):
    routed = _route_worker("builder", s, now, states)
    if family is None:
        return routed
    if family not in FAMILY_VENDOR:
        return _ask_row("builder", s, now, f"builder family {family} has no vendor: {_ASK}")
    matched = _constrained_worker(family, "builder", s, now, states)
    if matched is not None:
        return matched
    return routed


def _voter_effort(pool_id, s, now, states):
    effort, mode = _effort_for(pool_id, s, now, states, default="high")
    label = POOLS[pool_id]["label"]
    if mode == "burn":
        return effort, mode, f"voter effort {effort} ({label} burn)"
    if effort != "high":
        return effort, "suggest", f"voter effort {effort} ({label} ahead of pace)"
    return effort, "default", "voter effort high"


def _voter(family, seat, pool_id, s, now, effort, mode, reason):
    return {"role": "voter", "seat": seat, "family": family, "vendor": FAMILY_VENDOR[family],
            "effort": effort, "variant": "-", "mode": mode, "reason": reason,
            "reading_age_s": _reading_age(pool_id, s, now)}


def _fable_substitute():
    for pid in _serving("fable"):
        if POOLS[pid]["seat"] != "claude":
            return pid
    return None


def _fable_voter(states, s, now, required):
    """Fable on Max, or on the pool that also serves Fable when Max cannot.

    required: the strongest lineup needs this voter, so a full 5h window with
    no other seat asks and names when that window reopens.
    """
    watched = ("fable", "claude_week", "claude_5h")
    if any(states[pid][0] == "unknown" for pid in watched):
        pid = next(pid for pid in watched if states[pid][0] == "unknown")
        label = "Fable" if pid == "fable" else POOLS[pid]["label"]
        return "ask", _unknown_text(label, states[pid][1])
    if all(states[pid][0] != "capped" for pid in watched):
        effort, mode, reason = _voter_effort("fable", s, now, states)
        return "row", _voter("fable", "claude", "fable", s, now, effort, mode, reason)
    sub = _fable_substitute()
    if sub and _has_room(sub, states, s):
        effort, mode, reason = _voter_effort(sub, s, now, states)
        return "row", _voter("fable", POOLS[sub]["seat"], sub, s, now, effort, mode, reason)
    if sub and states[sub][0] == "unknown":
        return "ask", _unknown_text(POOLS[sub]["label"], states[sub][1])
    if required:
        if states["claude_5h"][0] == "capped":
            when = _reopen(s.get("claude_5h_reset_ts"), now)
            return "ask", f"claude 5h full, Other Models has no room, {when}: {_ASK}"
        return "ask", f"Fable capped and Other Models has no room: {_ASK}"
    return "skip", None


def _other_voter(family, pool_id, states, s, now, skip_ahead=False):
    state, why = states[pool_id]
    if state == "unknown":
        return "ask", _unknown_text(_FAMILY_NAME.get(family, family), why)
    if state == "capped" or (skip_ahead and state == "ahead"):
        return "skip", None
    effort, mode, reason = _voter_effort(pool_id, s, now, states)
    seat = POOLS[pool_id]["seat"]
    return "row", _voter(family, seat, pool_id, s, now, effort, mode, reason)


def _lineup_mode(chair, builder, voters, weaker):
    modes = {chair.get("mode"), builder.get("mode")}
    modes.update(v.get("mode") for v in voters)
    if "burn" in modes:
        return "burn"
    if weaker or "suggest" in modes:
        return "suggest"
    return "default"


def _collect_voters(chair, states, s, now):
    """Voters whose vendor is not the chair's. One voter is a degraded lineup.

    An unknown reading the lineup depends on asks. Fable is required while xAI
    chairs: a full 5h window with no Other Models room asks and names the reopen.
    """
    excluded = {chair["vendor"]}
    required = chair["vendor"] == "xai"
    voters = []
    for spec in VOTER_ROSTER:
        if FAMILY_VENDOR[spec["family"]] in excluded:
            continue
        if spec["family"] == "fable":
            status, payload = _fable_voter(states, s, now, required)
        elif spec["family"] == "grok":
            status, payload = _other_voter("grok", "grok", states, s, now, skip_ahead=True)
        else:
            status, payload = _other_voter(spec["family"], spec["pools"][0], states, s, now)
        if status == "ask":
            return "ask", payload
        if status == "row":
            voters.append(payload)
    if not voters:
        return "ask", f"nothing usable left: {_ASK}"
    return "ok", voters


def route_lineup(s, now, builder=None):
    """One lineup, or ask.

    Chair and builder come from one vendor. Grok while either Grok pool is under
    or on pace. Opus only when both are over pace, or when both are capped.
    A builder family the caller already used is kept when that pool can take it,
    and dropped when the pool is capped. Voter effort follows burn. One voter
    is a weaker lineup, not an ask.
    """
    states = {pid: pool_status(pid, s, now) for pid in POOLS}
    family = None if builder is None else builder.get("family")
    builder_row = _resolve_builder(family, s, now, states)
    if builder_row.get("mode") == "ask":
        return _lineup_ask(s, now, states, builder_row.get("reason") or _ASK, [])
    builder_row = _with_vendor(builder_row)
    if builder_row.get("family") == "opus":
        prefix = builder_row["reason"].split(":", 1)[0]
        chair_row = _opus_row("chair", s, now, states, prefix)
    else:
        chair_row = _route_worker("chair", s, now, states)
    if chair_row.get("mode") == "ask":
        return _lineup_ask(s, now, states, chair_row.get("reason") or _ASK, [])
    chair_row = _with_vendor(chair_row)
    if chair_row.get("vendor") != builder_row.get("vendor"):
        return _lineup_ask(s, now, states, "chair and builder vendors differ: " + _ASK, [])

    status, payload = _collect_voters(chair_row, states, s, now)
    if status == "ask":
        return _lineup_ask(s, now, states, payload, [])
    voters = payload
    rule = _rule_text(chair_row, builder_row, voters)
    weaker = None
    if len(voters) < 2:
        names = " and ".join(_FAMILY_NAME.get(v["family"], v["family"]) for v in voters)
        weaker = f"one voter ({names})"
    elif chair_row.get("family") != "grok":
        weaker = chair_row.get("reason")
    elif any(v["family"] == "fable" and v["seat"] != "claude" for v in voters):
        weaker = "Fable on Other Models"
    reason = rule if not weaker else f"{rule}; weaker: {weaker}"
    ages = [chair_row.get("reading_age_s"), builder_row.get("reading_age_s")]
    ages.extend(v.get("reading_age_s") for v in voters)
    known = [age for age in ages if isinstance(age, (int, float)) and not isinstance(age, bool)]
    seated = max(known) if known else None
    lineup = {"chair": chair_row, "builder": builder_row, "voters": voters}
    return {"role": "lineup", "mode": _lineup_mode(chair_row, builder_row, voters, weaker),
            "reason": reason, "rule": rule,
            "lineup": lineup,
            "legal_candidates": [{"chair": _party(chair_row), "builder": _party(builder_row),
                                  "voters": [_party(v) for v in voters], "rule": rule}],
            "alternatives": [], "reading_age_s": seated,
            "usage": _usage_snapshot(states, s), "usage_age_s": _snapshot_age(s, now)}


def _host_entry(id_, seat, family, effort, state, used, age):
    return {"id": id_, "seat": seat, "family": family, "effort": effort, "state": state,
            "available": state not in ("unknown", "capped"), "used_pct": used, "reading_age_s": age}


def _host_unknown(label, why):
    return _unknown_text(label, why)


def route_host(s, now):
    """Suggest where to start a host session. Does not select one.

    Capable order is Grok Bot, then Opus at high on Max. A burning pool is spent
    first. Both ahead: suggest the Bot and name the over-pace. An aged Bot
    reading says the reading is old. A missing reading says the read failed.
    """
    states = {pid: pool_status(pid, s, now) for pid in POOLS}
    bot_state, bot_why = states["grokbot"]
    opus_state = _join_open(states["claude_week"][0], states["claude_5h"][0])
    opus_effort, opus_mode = _effort_for("claude_week", s, now, states, default="high")
    bot = _host_entry("grokbot", "grokbot", "grokbot", "-", bot_state, s.get("bot_pct"),
                      _reading_age("grokbot", s, now))
    opus = _host_entry("opus", "claude", "opus", opus_effort, opus_state, s.get("claude_week"),
                       _reading_age("claude_week", s, now))

    def finish(mode, suggestion, reason, top):
        return {"role": "host", "seat": top["seat"], "family": top["family"], "effort": top["effort"],
                "variant": "-", "mode": mode, "reason": reason, "reading_age_s": top["reading_age_s"],
                "suggestion": suggestion, "selects": False, "hosts": [bot, opus]}

    if bot_state == "unknown":
        return finish("ask", None, _host_unknown("Grok Bot", bot_why), bot)
    ready = []
    if bot["available"] and bot_state != "ahead":
        ready.append(("grokbot", bot, "grokbot"))
    if opus["available"] and opus_state != "ahead":
        ready.append(("opus", opus, "claude_week"))
    if ready:
        def key(item):
            _id, _entry, pool = item
            reset = s.get(POOLS[pool]["reset"])
            reset = reset if _is_number(reset) else 0
            order = 0 if _id == "grokbot" else 1
            if _pool_burning(pool, s, now):
                return (0, reset, order)
            return (1, order, 0)
        _id, top, pool = sorted(ready, key=key)[0]
        if _id == "grokbot":
            mode, reason = "suggest", "Grok Bot first, then Opus at high on Max"
            if _pool_burning(pool, s, now):
                mode, reason = "burn", "Grok Bot burn, then Opus at high on Max"
        else:
            mode = "burn" if opus_mode == "burn" else "suggest"
            if bot_state == "capped":
                reason = f"Grok Bot capped: {_opus_phrase('chair', opus_effort)}"
            elif mode == "burn":
                reason = f"{_opus_phrase('chair', opus_effort)} ({POOLS['claude_week']['label']} burn)"
            else:
                reason = f"Grok Bot ahead of pace: {_opus_phrase('chair', opus_effort)}"
        return finish(mode, _id, reason, top)
    if bot_state == "ahead" and opus_state == "ahead":
        return finish("suggest", "grokbot",
                      "both host pools over pace: Grok Bot, then Opus at high on Max", bot)
    if opus["available"]:
        return finish("suggest", "opus", f"Grok Bot capped: {_opus_phrase('chair', opus_effort)}", opus)
    if opus_state == "unknown":
        return finish("ask", None, _max_unknown_reason(states), bot)
    return finish("ask", None, "Grok Bot and Max capped: " + _ASK, bot)


def format_lineup(row):
    age = row.get("reading_age_s")
    shown = "unknown" if age is None else f"{int(age // 60)}m"
    if row.get("mode") == "ask" or not row.get("lineup"):
        return (f"route: lineup | - | - | - | - | ask | {row.get('reason')} | reading {shown}")
    lines = [f"route: lineup | {row['mode']} | {row.get('rule')} | reading {shown}"]
    for key in ("chair", "builder"):
        party = row["lineup"][key]
        lines.append(f"  {key}: {party['seat']} | {party['family']} | {party['effort']} | "
                     f"{party['variant']} | {party['vendor']}")
    for voter in row["lineup"]["voters"]:
        lines.append(f"  voter: {voter['seat']} | {voter['family']} | {voter['effort']} | "
                     f"{voter['variant']} | {voter['vendor']}")
    return "\n".join(lines)


def format_host(row):
    lines = [format_route(row)]
    for host in row.get("hosts") or []:
        flag = "available" if host.get("available") else host.get("state")
        lines.append(f"  host: {host['seat']} | {host['family']} | {host['effort']} | "
                     f"{host['state']} | {flag}")
    return "\n".join(lines)


def _opt(argv, name):
    if name not in argv:
        return None
    i = argv.index(name)
    if i + 1 >= len(argv) or argv[i + 1].startswith("-"):
        print(f"{name} needs a value", file=sys.stderr)
        raise SystemExit(2)
    return argv[i + 1]


def cmd_route():
    argv = sys.argv[1:]
    as_json = "--json" in argv
    cached = "--cached" in argv
    # A bare --route, or --route followed by a flag, routes every launch role.
    # Do not call _opt first: a missing value used to exit 2, and the launch
    # hook treats that as silence.
    role = None
    if "--route" in argv:
        i = argv.index("--route")
        if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            role = argv[i + 1]
    if role == "voter":
        print("voters do not route", file=sys.stderr)
        raise SystemExit(2)
    known = list(ROLES) + ["lineup", "host"]
    if role is not None and role not in known:
        print(f"unknown role {role}; roles: {', '.join(known)}", file=sys.stderr)
        raise SystemExit(2)
    builder = None
    if role == "lineup" and "--builder-family" in argv:
        # Family only. Seat and effort are resolved once the summary is loaded.
        builder = {"role": "builder", "family": _opt(argv, "--builder-family")}
    if cached:
        summary = _load_cache()
    elif role == "lineup":
        summary = refresh(list(LINEUP_SEATS))
    elif role == "host":
        summary = refresh(list(HOST_SEATS))
    else:
        chosen = tuple(ROLES) if role is None else (role,)
        seats = []
        for name in chosen:
            for seat in ROLES[name]["seats"]:
                if seat not in seats:
                    seats.append(seat)
        summary = refresh(seats)
    now = time.time()
    if role == "lineup":
        rows = [route_lineup(summary, now, builder=builder)]
    elif role == "host":
        rows = [route_host(summary, now)]
    else:
        chosen = tuple(ROLES) if role is None else (role,)
        rows = [route(name, summary, now) for name in chosen]
    # A cached poll must not append the ask log, the usage history, or the cache.
    if not cached:
        log_asks(rows, summary, now)
    if as_json:
        json.dump(rows, sys.stdout)
        sys.stdout.write("\n")
    else:
        for row in rows:
            if row.get("role") == "lineup":
                print(format_lineup(row))
            elif row.get("role") == "host":
                print(format_host(row))
            else:
                print(format_route(row))

def log_asks(rows, s, now):
    """Append one line per row the router could not settle. Write failures are silent."""
    asked = [r for r in rows if r["mode"] == "ask" or r["reason"].endswith("no rule")]
    if not asked:
        return
    pools = {pid: [pool_status(pid, s, now)[0], s.get(meta["used"])] for pid, meta in POOLS.items()}
    try:
        os.makedirs(os.path.dirname(ASKS), exist_ok=True)
        with open(ASKS, "a") as f:
            for r in asked:
                f.write(json.dumps({"ts": now, "host": socket.gethostname(), "row": r, "pools": pools}) + "\n")
    except Exception:
        pass

def write_cache():
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(SUMMARY, f)
        os.replace(tmp, CACHE)
    except Exception:
        pass

# Conclave's cache. Read at print time. Not stored, not a pool, not a route input.
# Model names stay in the file, if Conclave sends them; the router never sees this.
def muse_usage_path():
    return os.path.join(os.path.expanduser("~"), ".cache", "quartermaster", "muse-usage.json")

def _muse_number(v):
    return _is_number(v) and v == v and v != float("inf") and v != float("-inf")

def _muse_epoch(value):
    if not isinstance(value, str) or not value.strip():
        return None
    try:
        return iso_to_ts(value.strip())
    except (ValueError, TypeError, OSError, OverflowError):
        return None

def _muse_local(ts):
    """Clock time in the machine's zone. None when the timestamp cannot be shown."""
    try:
        dt = datetime.fromtimestamp(ts).astimezone()
    except (OverflowError, OSError, ValueError):
        return None
    zone = dt.tzname() or dt.strftime("%z")
    clock = dt.strftime("%Y-%m-%d %H:%M")
    return f"{clock} {zone}" if zone else clock

def format_muse_line(data, now):
    """One Muse line from Conclave's object, or None when the shape does not match.

    {captured_at, window{used_percent, window_duration_mins, resets_at},
     weekly{used_percent, resets_at}}. Times are local. Stale once the captured
    window's resets_at is no longer in the future.
    """
    if not isinstance(data, dict):
        return None
    window, weekly = data.get("window"), data.get("weekly")
    if not isinstance(window, dict) or not isinstance(weekly, dict):
        return None
    captured = _muse_epoch(data.get("captured_at"))
    window_reset = _muse_epoch(window.get("resets_at"))
    weekly_reset = _muse_epoch(weekly.get("resets_at"))
    current, weekly_pct = window.get("used_percent"), weekly.get("used_percent")
    minutes = window.get("window_duration_mins")
    if captured is None or window_reset is None or weekly_reset is None:
        return None
    if not _muse_number(current) or not _muse_number(weekly_pct) or not _muse_number(minutes) or minutes < 0:
        return None
    captured_s, window_s, weekly_s = _muse_local(captured), _muse_local(window_reset), _muse_local(weekly_reset)
    if not captured_s or not window_s or not weekly_s:
        return None
    line = (f"{'muse':9}| Current {_fmt_pct(current)}% (resets {window_s})"
            f" | Weekly {_fmt_pct(weekly_pct)}% (resets {weekly_s}) | as of {captured_s}")
    if window_reset <= now:
        line += " | stale (window reset)"
    return line

def muse_line(now=None, path=None):
    """Read-only Muse line. Missing or unparseable input says 'no data yet'."""
    if now is None:
        now = time.time()
    if path is None:
        path = muse_usage_path()
    try:
        with open(path) as f:
            data = json.load(f)
        line = format_muse_line(data, now)
    except Exception:
        return f"{'muse':9}| no data yet"
    return line or f"{'muse':9}| no data yet"

def print_cached():
    """--cached: print the last run's lines from the cache, no network. For the
    synchronous SessionStart hook; the async hook refreshes the cache."""
    try:
        d = json.load(open(CACHE))
        age_m = round((NOW - d["ts"]) / 60)
        header = f"[seat-usage] cached {age_m}m ago; run ~/.local/bin/seat-usage for live numbers"
        seats = []
        for l in d["lines"]:
            seat = l.split("|")[0].strip()
            l = re.sub(r" \| stale \(reading [\d.]+h old\)$", "", l)   # recomputed below at the current age
            age = seat_age_s(d, seat, NOW)
            tag = " | no reading" if age is None else stale_tag(NOW - age)
            seats.append("  " + l + tag)
        # Recomputed against the current time, so a reset that already passed drops its line.
        burns = ["  " + burn_line(e) for e in burn_entries(d, NOW)]
    except Exception as e:
        print(f"[seat-usage] no cached line ({e.__class__.__name__}); run ~/.local/bin/seat-usage")
        print("  " + muse_line())
        return
    print(header)
    for line in seats:
        print(line)
    # Conclave's file, not the seat cache. Sits with the usage lines, ahead of burn nudges.
    print("  " + muse_line())
    for line in burns:
        print(line)

def _print_full(lines, burn):
    print("[seat-usage] " + datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%MZ"))
    for l in lines:
        print("  " + l)
    print("  " + muse_line())
    for e in burn:
        print("  " + burn_line(e))

def full_run(quiet=False, timeout=LOCK_TIMEOUT):
    """Reread every seat, merge into the cache, and stamp ts to this run.

    Takes the same lock as refresh. A failed seat keeps its last numbers and
    loses as_of. A usage 429 with Retry-After keeps that seat's as_of and
    does not call again until the deadline. On lock timeout the cache is not
    written; the lines are still printed when not quiet. An inherited lock
    fd is not unlocked.
    """
    global SUMMARY
    now = time.time()
    lock = _acquire_lock(timeout)
    if lock is None:
        SUMMARY = {"ts": now, "as_of": {}, "v": 1}
        lines = _read_jobs((claude, codex, cursor, grok))
        SUMMARY["lines"] = lines
        SUMMARY["burn"] = burn_entries(SUMMARY, now)
        if not quiet:
            _print_full(lines, SUMMARY["burn"])
        return SUMMARY
    try:
        base = _load_cache()
        SUMMARY = {"ts": now, "as_of": {}, "v": 1}
        lines = _read_jobs((claude, codex, cursor, grok))
        merged = _store_merged(base, lines, LINE_SEATS, now, stamp_now=True)
    finally:
        _release_lock(lock)
    if not quiet:
        _print_full(merged["lines"], merged["burn"])
    return merged

UPDATE_INTERVAL_S = 24 * 60 * 60
UPDATE_GIT_TIMEOUT_S = 5
_GIT_ENV_DROP = (
    "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
    "GIT_COMMON_DIR", "GIT_PREFIX", "GIT_NAMESPACE", "GIT_ASKPASS", "SSH_ASKPASS",
)

def _update_skipped():
    if os.environ.get("QUARTERMASTER_NO_UPDATE") == "1":
        return True
    if os.environ.get("COUNCIL_VOTER") == "1" or os.environ.get("CONCLAVE_VOTER") == "1":
        return True
    argv = sys.argv[1:]
    return "--route" in argv or "--quiet" in argv

def _stamp_path():
    return os.path.join(os.path.expanduser("~"), ".cache", "quartermaster", "seat-usage-update")

def _stamp_fresh(path, now):
    try:
        with open(path) as handle:
            stamp = float(handle.read().strip())
    except (OSError, ValueError):
        return False
    return now - stamp < UPDATE_INTERVAL_S

def _write_stamp(path, now):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w") as handle:
            handle.write(f"{now:.3f}\n")
        os.replace(tmp, path)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass

def _git_env():
    env = os.environ.copy()
    for key in _GIT_ENV_DROP:
        env.pop(key, None)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_EDITOR"] = "true"
    env["GCM_INTERACTIVE"] = "never"
    if "GIT_SSH_COMMAND" not in env:
        env["GIT_SSH_COMMAND"] = "ssh -o BatchMode=yes -o ConnectTimeout=3"
    return env

def _stop_git(proc):
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except OSError:
        return
    try:
        proc.communicate(timeout=1)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()

def _git(root, args):
    proc = subprocess.Popen(
        ["git", "-C", root, *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        env=_git_env(),
        start_new_session=True,
    )
    try:
        out, _ = proc.communicate(timeout=UPDATE_GIT_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        _stop_git(proc)
        return None
    if proc.returncode != 0:
        return None
    return out

def _rev(root, spec):
    out = _git(root, ["rev-parse", spec])
    if out is None:
        return None
    rev = out.strip()
    return rev or None

def _fast_forward_checkout():
    script = os.path.realpath(__file__)
    top = _git(os.path.dirname(script), ["rev-parse", "--show-toplevel"])
    if top is None:
        return
    root = top.strip()
    if not root:
        return
    rel = os.path.relpath(script, root)
    if _git(root, ["ls-files", "--error-unmatch", "--", rel]) is None:
        return
    branch = _git(root, ["symbolic-ref", "--short", "HEAD"])
    if branch is None or branch.strip() != "main":
        return
    status = _git(root, ["status", "--porcelain", "--untracked-files=no"])
    if status is None or status.strip():
        return
    path = _stamp_path()
    now = time.time()
    if _stamp_fresh(path, now):
        return
    _write_stamp(path, now)
    if _git(root, ["fetch", "--quiet"]) is None:
        return
    head = _rev(root, "HEAD")
    upstream = _rev(root, "@{u}")
    if head is None or upstream is None or head == upstream:
        return
    if _git(root, ["merge-base", "--is-ancestor", "HEAD", "@{u}"]) is None:
        return
    pulled = _git(root, ["-c", "pull.rebase=false", "-c", "pull.ff=only", "pull", "--ff-only", "--quiet"])
    if pulled is None:
        return
    if _rev(root, "HEAD") in (None, head):
        return
    print("[seat-usage] updated", flush=True)
    os.execv(sys.executable, [sys.executable, *sys.argv])

def maybe_self_update():
    if _update_skipped():
        return
    try:
        _fast_forward_checkout()
    except Exception:
        return

def main():
    maybe_self_update()
    if "--route" in sys.argv:
        return cmd_route()
    if "--cached" in sys.argv:
        if os.environ.get("COUNCIL_VOTER") == "1":
            return
        return print_cached()
    full_run(quiet="--quiet" in sys.argv)

if __name__ == "__main__":
    main()

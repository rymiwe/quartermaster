        "claude_renews_ts", "claude_renews", "claude_renews_date_only", "claude_renews_on",
    ),
    "chatgpt": (
        "codex", "codex_pace", "codex_reset_ts", "codex_window_s", "codex_plan", "codex_age_h", "codex_source",
        "codex_5h", "codex_5h_reset_ts", "codex_renews_ts", "codex_renews",
    ),
    "cursor": (
        "cursor", "cursor_pct", "cursor_pace", "cursor_reset_ts", "cursor_window_s",
        "cursor_auto_pct", "cursor_auto_pace", "cursor_api_pct", "cursor_api_pace", "cursor_ondemand", "cursor_ondemand_limit",
        "cursor_renews",
    ),
    "grokbot": ("bot_pct", "bot_pace", "bot_reset_ts", "bot_window_s", "bot_exhausted"),
    "grok": (
        "grok", "grok_cookie_ok", "grok_pct", "grok_pace", "grok_reset_ts", "grok_window_s",

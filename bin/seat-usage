# The only home of the routing rules. Each comment names the CLAUDE.md section.
# First match wins. "not_capped" means the pool is known and not capped.
# "room" means the pool is known, under 95% used, and not capped. Near the hard
# cap outranks pace. "burn" matches burn_entries (thresholds stay in BURN_HOURS / BURN_GAP).
NEAR_CAP = 95
ROUTE_RULES = [

#!/usr/bin/env python3
"""Print one line per subscription seat: plan, usage, pace. Report-only.

Reads stored tokens to call the same endpoints the vendor TUIs call. Never
prints a token. Every source is best-effort with a short timeout; a failure
prints a one-line reason and never exits non-zero. A synchronous
SessionStart hook prints the cached lines (--cached) so the numbers land in
context when routing is decided.
A Muse line is read from ~/.cache/quartermaster/muse-usage.json. Conclave
writes that file, and a live run asks `muse serve` for a new reading when
the file is missing, older than about 10 minutes, or its 5h reset is not a
current window. That ask is one short reply. It passes --contributor-mode
off and does not pin a model, so the host's configured model is used. A
parsed snapshot is copied into this cache (muse_5h, muse_week, and their
resets, stamped as_of["muse"]), including one whose 5h window has already
reset. That same read appends `muse 5h` and `muse weekly` to history.jsonl
with read_ts set to the snapshot's captured_at. A pool that already has a row
at or after that captured_at is not appended again. No captured_at appends
nothing. An exhausted record with no used percent appends one `muse weekly`
line with exhausted true, the quota reset, and no used percent. The same
captured_at is not appended again. A missing file does not restamp a number
already in the cache. That stamp is a routing
input: wonder-full votes on those pools.
A turn/completed whose error.quota is present records muse_exhausted and
muse_exhausted_reset_ts, stamps as_of["muse"], and does not invent a used
percent. Any other turn failure leaves the file unchanged. A missing or
unreadable file drops that stamp and records the reason.
SEAT_USAGE_SKIP_MUSE=1 skips the ask. --cached never asks.
--help and -h print this text and exit before a self-update, a reader, a
lock, or a cache write.
Google AI Pro is read from the signed-in Antigravity CLI: `agy -p "/usage"`
(binary `agy` on PATH, else ~/.local/bin/agy; SEAT_USAGE_AGY overrides).
The table's percent is remaining; stored percents are used (100 - remaining)
for Argon weekly and for the Gemini and Claude/GPT weekly and 5-hour pools.
A missing binary, a not-signed-in session, a non-zero exit, a timeout, or
output that does not parse is an error line. No number is invented. The
live check waits USAGE_MIN_INTERVAL_S between calls, the same floor as the
other seats. SEAT_USAGE_SKIP_GOOGLE=1, COUNCIL_VOTER=1, and CONCLAVE_VOTER=1
skip the call. --cached never runs agy.
Self-update is off by default. With QUARTERMASTER_AUTO_UPDATE=1, a run
from a clean checkout of main fetches and fast-forwards at most once a
day, prints one updated line, and starts again on the new code.
--route, --quiet, --cached, COUNCIL_VOTER=1, and CONCLAVE_VOTER=1 skip that check.
QUARTERMASTER_NO_UPDATE=1 turns it off and wins over the opt-in.
The check never stashes or resets.
Pull-only host mode: with SEAT_USAGE_PULL_ONLY=1 in the environment, or the
marker file ~/.config/seat-usage/pull-only present (SEAT_USAGE_PULL_ONLY_FILE
overrides the path), this host never reads a seat live. Every path (plain run,
--quiet, --route without --cached, refresh) serves the cache that
seat-usage-push --pull wrote, with no reader, no op/op.exe or cookie lookup,
no Muse or agy ask, and no cache write. Output says "pull-only" and the cache
age. For a VM that only renders a reader host's pushed copy.
Sources are documented in the Delegation Routing section of ~/.claude/CLAUDE.md.
"""
import base64, fcntl, glob, json, os, re, shlex, shutil, signal, socket, subprocess, sys, time, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timezone

H = os.path.expanduser("~")
NOW = time.time()
CACHE_DIR = os.environ.get("SEAT_USAGE_CACHE_DIR") or f"{H}/.cache/seat-usage"
CACHE = f"{CACHE_DIR}/latest.json"
# Local tests point these at a fake server. Unset, they are the live endpoints.
ANTHROPIC_PROFILE_URL = os.environ.get("SEAT_USAGE_ANTHROPIC_PROFILE") or "https://api.anthropic.com/api/oauth/profile"
ANTHROPIC_USAGE_URL = os.environ.get("SEAT_USAGE_ANTHROPIC_USAGE") or "https://api.anthropic.com/api/oauth/usage"
HISTORY = f"{H}/.local/state/seat-usage/history.jsonl"
# Past HISTORY_MAX_BYTES the file is cut to its newest HISTORY_KEEP_BYTES of
# whole lines, so it stays bounded and its recent tail stays continuous.
HISTORY_MAX_BYTES = 4 * 1024 * 1024
HISTORY_KEEP_BYTES = 2 * 1024 * 1024
# Chunk size when a Muse append looks backward for that pool's last row.
# Same width as Orderly's history tail (server.rb HISTORY_TAIL_BYTES).
HISTORY_TAIL_BYTES = 128 * 1024
# Every route that ends in "ask" or "no rule", with the pool states it saw.
# Measures how often a person is asked, before anything answers for them.
ASKS = os.environ.get("SEAT_USAGE_ASKS") or f"{H}/.local/state/seat-usage/asks.jsonl"
RENEWALS_FILE = os.environ.get("SEAT_USAGE_RENEWALS") or f"{H}/.config/seat-usage/renewals.json"
SUMMARY = {"ts": NOW, "as_of": {}, "v": 1}   # compact fields for the status line; no tokens, no PII
STALE_HOURS = 3       # a seat reading older than this gets no burn line and is marked stale
# A reading older than ROUTE_FRESH_S is unknown to the router (the status line
# refreshes at 10 min). A copy landed by `seat-usage-push --pull` carries
# pulled_ts. Its readings were taken on the pushing machine (BLD), which pushes
# at most every 5 min and refreshes at 10, so a good copy is 5-15 min old and
# gets ROUTE_FRESH_PULLED_S. A live cache never has pulled_ts. Both come from
# config/pools.json "route_freshness_s" {"live", "pulled"}; these are the
# defaults when that key, or one of its values, is missing or not positive.
ROUTE_FRESHNESS_DEFAULT_S = {"live": 600, "pulled": 1200}
ROUTE_FRESH_S = ROUTE_FRESHNESS_DEFAULT_S["live"]
ROUTE_FRESH_PULLED_S = ROUTE_FRESHNESS_DEFAULT_S["pulled"]
# The usage endpoint publishes no limit and answers 429 with Retry-After: 0
# (anthropics/claude-code#30930, still open 2026-10-14). Zero is not a usable
# delay: a 429 without a positive Retry-After waits USAGE_BACKOFF_S, doubling
# per 429 in a row up to USAGE_BACKOFF_MAX_S. That deadline and the streak
# live in rate-limit.json and are shared by every invocation. A good usage
# read clears the streak and holds both Anthropic URLs for
# USAGE_MIN_INTERVAL_S. The profile call is skipped while the cached plan is
# usable, so a refresh is one request. A 401 or 429 on profile arms the same
# backoff and does not call usage. The floor stays equal to ROUTE_FRESH_S on
# purpose: shortening it would call Anthropic more often, which is what the
# floor was added to stop. as_of["claude"] is the same clock that arms the
# floor (when the body lands), not import time. The route clock is taken
# after the status-line lock and before the seat reads, so that wait and the
# later sequential reads sit outside the age. While the floor still blocks,
# the age at the route clock is therefore strictly under the live window.
# A 429 backoff is a different hold: it may outlive the window, and the
# reading then goes stale instead of being called early.
USAGE_MIN_INTERVAL_S = float(os.environ.get("SEAT_USAGE_MIN_INTERVAL_S") or 600)   # tests set 0
USAGE_BACKOFF_S = 300
USAGE_BACKOFF_MAX_S = 7200
# Fixed codes only. No exception text, no tokens. Older caches omit the field.
READ_STATES = frozenset(("fresh", "token_expired", "rate_limited", "usage_failed"))

def get(url, headers, timeout=8):
    req = urllib.request.Request(url, headers={"User-Agent": "seat-usage", **headers})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())

class _RateLimited(Exception):
    """Usage or profile is inside a backoff window. Serve the last reading; do not keep calling."""

    def __init__(self, code=429):
        self.code = code

def _rate_limit_path():
    return f"{CACHE_DIR}/rate-limit.json"

def _load_rate_limits():
    try:
        with open(_rate_limit_path()) as f:
            d = json.load(f)
        if isinstance(d, dict):
            return d
    except Exception:
        pass
    return {}

def _streak_key_name(key):
    return isinstance(key, str) and (key.endswith("#429s") or key.endswith("#401s"))

def _prefer_rate_value(key, new, old):
    """The further deadline, or the higher streak. A stale writer must not win."""
    if old is None:
        return new
    if _streak_key_name(key):
        if isinstance(old, int) and not isinstance(old, bool) and isinstance(new, int) and not isinstance(new, bool):
            return old if old > new else new
        return new
    if _is_number(new) and _is_number(old):
        return old if old > new else new
    return new

def _merge_rate_limits(cur, limits, had):
    """Fold `limits` onto `cur`. Drop a key only when this caller is the one who removed the value it loaded."""
    merged = dict(cur) if isinstance(cur, dict) else {}
    for key, val in limits.items():
        merged[key] = _prefer_rate_value(key, val, merged.get(key))
    if isinstance(had, dict):
        for key in had:
            if key not in limits and cur.get(key) == had.get(key):
                merged.pop(key, None)
    return merged

def _store_rate_limits(limits, had=None):
    """Atomic replace so a reader never sees a half-written deadline.

    Merges with whatever is on disk first. A profile call that loaded the file
    before a 429 landed cannot write that snapshot back over the streak or a
    later deadline. An intentional clear (the caller popped a key it had loaded,
    and disk still has that same value) still applies.
    """
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        cur = _load_rate_limits()
        merged = _merge_rate_limits(cur, limits, had)
        if merged == cur:
            return
        tmp = _rate_limit_path() + ".tmp"
        with open(tmp, "w") as f:
            json.dump(merged, f)
        os.replace(tmp, _rate_limit_path())
    except Exception:
        pass

def _retry_after_deadline(raw, now):
    """Absolute timestamp from a Retry-After delay-seconds value, or None.

    A later probe of the same window counts down (1705s, then 1432s) and
    yields the same timestamp. Zero is not a usable delay: the usage endpoint
    sends Retry-After: 0 (anthropics/claude-code#30930). A negative value, or
    a 401 "token has expired" body, is not a deadline either. A 401 is
    recorded by the auth backoff, not by this parser.
    """
    if raw is None:
        return None
    try:
        seconds = float(str(raw).strip())
    except (TypeError, ValueError):
        return None
    if seconds <= 0 or seconds != seconds or seconds == float("inf"):
        return None
    return now + seconds

def _usage_deadline(limits):
    return _numeric_deadline(limits, ANTHROPIC_USAGE_URL)

def _usage_rate_limited(now=None):
    if now is None:
        now = time.time()
    deadline = _usage_deadline(_load_rate_limits())
    return deadline is not None and now < deadline

def _remember_deadline(url, deadline, limits):
    """Keep the further absolute timestamp so a countdown cannot restart the window."""
    prev = limits.get(url)
    if isinstance(prev, (int, float)) and not isinstance(prev, bool) and prev > deadline:
        deadline = prev
    limits[url] = deadline
    _store_rate_limits(limits)

def _streak_key(url, kind="429"):
    return f"{url}#{kind}s"

def _streak_value(limits, kind):
    raw = limits.get(_streak_key(ANTHROPIC_USAGE_URL, kind))
    return raw if isinstance(raw, int) and not isinstance(raw, bool) and raw > 0 else 0

def _backoff_kind(limits):
    """401 wins over 429 when both streaks are set: a dead token is the reason to stop."""
    if _streak_value(limits, "401"):
        return 401
    if _streak_value(limits, "429"):
        return 429
    return None

def _numeric_deadline(limits, url):
    raw = limits.get(url)
    if isinstance(raw, bool) or not isinstance(raw, (int, float)):
        return None
    return raw

def _deadline_active(limits, url, now):
    deadline = _numeric_deadline(limits, url)
    return deadline is not None and now < deadline

def _backoff_deadline(retry_after, limits, now, kind="429"):
    """Deadline after a 429 or 401: the larger of Retry-After and our doubling backoff.

    401 and 429 keep separate streaks. A 401 has no Retry-After.
    """
    key = _streak_key(ANTHROPIC_USAGE_URL, kind)
    streak = _streak_value(limits, kind)
    limits[key] = streak + 1
    ours = now + min(USAGE_BACKOFF_S * (2 ** min(streak, 16)), USAGE_BACKOFF_MAX_S)
    return ours if retry_after is None else max(retry_after, ours)

def _arm_min_interval(limits, url, now):
    """Hold this endpoint until USAGE_MIN_INTERVAL_S has passed. Tests set that to 0."""
    if USAGE_MIN_INTERVAL_S > 0:
        prev = _numeric_deadline(limits, url)
        nxt = now + USAGE_MIN_INTERVAL_S
        if prev is not None and prev > nxt:
            nxt = prev
        limits[url] = nxt
    else:
        limits.pop(url, None)

def _store_if_changed(limits, had):
    if limits != had:
        _store_rate_limits(limits, had)

def _acquire_rate_lock(timeout=None):
    """Exclusive lock for the usage call. Not the cache .lock: full_run holds that one."""
    if timeout is None:
        timeout = LOCK_TIMEOUT
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        fh = open(f"{CACHE_DIR}/rate-limit.lock", "a+")
    except Exception:
        return None
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fh
        except OSError:
            if time.monotonic() >= deadline:
                try:
                    fh.close()
                except Exception:
                    pass
                return None
            time.sleep(0.05)

def _release_rate_lock(fh):
    if fh is None:
        return
    try:
        fcntl.flock(fh, fcntl.LOCK_UN)
    except Exception:
        pass
    try:
        fh.close()
    except Exception:
        pass

def _record_http_backoff(limits, now, code, retry_after=None):
    """401 and 429 share the usage-url deadline and keep separate streaks."""
    kind = "401" if code == 401 else "429"
    _remember_deadline(
        ANTHROPIC_USAGE_URL,
        _backoff_deadline(retry_after, limits, now, kind),
        limits,
    )

def _usage_get(headers, timeout=8):
    """GET the usage URL unless this cache dir is inside a wait window.

    The deadline is on disk, so a burst in this process or another one (the
    status line's spawn, --route, a full run) shares it. The lock is held
    across the HTTP call: the next caller waits, sees the deadline, and
    does not send. A good read sets the USAGE_MIN_INTERVAL_S floor and
    clears the 401 and 429 streaks. A 429 sets the backoff in
    _backoff_deadline. A 401 sets that same backoff with its own streak.
    """
    url = ANTHROPIC_USAGE_URL
    lock = _acquire_rate_lock()
    if lock is None:
        raise _RateLimited(_backoff_kind(_load_rate_limits()) or 429)
    try:
        limits = _load_rate_limits()
        now = time.time()
        if _deadline_active(limits, url, now):
            raise _RateLimited(_backoff_kind(limits) or 429)
        try:
            body = get(url, headers, timeout)
        except urllib.error.HTTPError as e:
            code = getattr(e, "code", None)
            if code in (401, 429):
                now = time.time()
                retry_after = None
                if code == 429:
                    retry_after = _retry_after_deadline(
                        e.headers.get("Retry-After") if e.headers is not None else None, now)
                _record_http_backoff(limits, now, code, retry_after)
                raise _RateLimited(code) from e
            raise
        had = dict(limits)
        limits.pop(_streak_key(url), None)
        limits.pop(_streak_key(url, "401"), None)
        now = time.time()
        # One interval for both endpoints, so the profile call is not due
        # again in the same window as this usage read. This same clock is
        # as_of["claude"]. Import time is earlier by the lock wait and this
        # call, and that gap left a held reading older than the live window
        # while the floor still blocked the next one.
        _arm_min_interval(limits, url, now)
        _arm_min_interval(limits, ANTHROPIC_PROFILE_URL, now)
        _store_if_changed(limits, had)
        return body, now
    finally:
        _release_rate_lock(lock)

def _cached_plan_status():
    """Plan and status from the last reading. '?' when that reading has no plan."""
    cached = _load_cache()
    plan = cached.get("claude_plan")
    status = cached.get("claude_status")
    if isinstance(plan, str) and plan and isinstance(status, str) and status and "failed" not in status:
        return plan, status
    return "?", "?"

def _profile_get(headers, timeout=8):
    """Plan and status. At most one profile call per USAGE_MIN_INTERVAL_S.

    A 401 records the shared auth backoff and raises _RateLimited(401) so
    the usage call is not sent with the same dead token. While the profile
    floor is in force, plan and status come from the cached reading.
    """
    url = ANTHROPIC_PROFILE_URL
    lock = _acquire_rate_lock()
    if lock is None:
        raise _RateLimited(_backoff_kind(_load_rate_limits()) or 429)
    try:
        limits = _load_rate_limits()
        now = time.time()
        # A 401/429 window blocks every Claude call, including profile.
        if _deadline_active(limits, ANTHROPIC_USAGE_URL, now) and _backoff_kind(limits):
            raise _RateLimited(_backoff_kind(limits))
        if _deadline_active(limits, url, now):
            return _cached_plan_status()
        had = dict(limits)
        try:
            p = get(url, headers, timeout)
        except urllib.error.HTTPError as e:
            code = getattr(e, "code", None)
            if code in (401, 429):
                now = time.time()
                retry_after = None
                if code == 429:
                    retry_after = _retry_after_deadline(
                        e.headers.get("Retry-After") if e.headers is not None else None, now)
                _record_http_backoff(limits, now, code, retry_after)
                raise _RateLimited(code) from e
            _arm_min_interval(limits, url, time.time())
            _store_if_changed(limits, had)
            raise
        except Exception:
            _arm_min_interval(limits, url, time.time())
            _store_if_changed(limits, had)
            raise
        org = p.get("organization", {}) if isinstance(p, dict) else {}
        plan = org.get("rate_limit_tier", "?").replace("default_", "")
        status = org.get("subscription_status", "?")
        _arm_min_interval(limits, url, time.time())
        _store_if_changed(limits, had)
        return plan, status
    finally:
        _release_rate_lock(lock)

_STALE_SUFFIX_RE = re.compile(r" \| stale \(reading [\d.]+h old\)$")

def _reading_body(line):
    """Seat line with a previous expiry note and stale tag removed."""
    line = _STALE_SUFFIX_RE.sub("", line)
    if "|" not in line:
        return None
    body = line.split("|", 1)[1].strip()
    head, _sep, tail = body.partition(" | ")
    if head.startswith("token expired ") and "refresh" in head:
        return tail or None
    return body or None

def _stale_suffix(seat="claude"):
    as_of = SUMMARY.get("as_of") if isinstance(SUMMARY.get("as_of"), dict) else {}
    stamp = as_of.get(seat)
    if not _is_number(stamp):
        return ""
    age_h = max(0.0, (NOW - stamp) / 3600.0)
    return f" | stale (reading {age_h:.1f}h old)"

def _set_read_state(seat, code, until=None):
    """Record one fixed reason. `until` is the backoff epoch for rate_limited only."""
    if code not in READ_STATES:
        return
    state = SUMMARY.get("read_state")
    state = dict(state) if isinstance(state, dict) else {}
    state[seat] = code
    SUMMARY["read_state"] = state
    untils = SUMMARY.get("rate_limited_until")
    untils = dict(untils) if isinstance(untils, dict) else {}
    if code == "rate_limited" and _is_number(until):
        untils[seat] = until
    else:
        untils.pop(seat, None)
    if untils:
        SUMMARY["rate_limited_until"] = untils
    else:
        SUMMARY.pop("rate_limited_until", None)

def _apply_held_read_state():
    """The usage URL is inside a wait. A streak is rate_limited; a bare floor is the last good read."""
    limits = _load_rate_limits()
    if _backoff_kind(limits):
        _set_read_state("claude", "rate_limited", _usage_deadline(limits))
        return
    cached = _load_cache()
    prev = cached.get("read_state") if isinstance(cached.get("read_state"), dict) else {}
    if prev.get("claude") == "usage_failed":
        _set_read_state("claude", "usage_failed")
        return
    _set_read_state("claude", "fresh")

def _hold_usage_failure(now=None):
    """A usage call that was not a reading. Hold the min interval; do not clear a 429 streak.

    Interval 0 (the tests) leaves the file alone.
    """
    if USAGE_MIN_INTERVAL_S <= 0:
        return
    lock = _acquire_rate_lock()
    if lock is None:
        return
    try:
        limits = _load_rate_limits()
        had = dict(limits)
        _arm_min_interval(limits, ANTHROPIC_USAGE_URL, now or time.time())
        _store_if_changed(limits, had)
    finally:
        _release_rate_lock(lock)

def _clock(ts):
    """Local clock as '4:14 PM'. None when the timestamp cannot be shown."""
    try:
        text = datetime.fromtimestamp(ts).strftime("%I:%M %p")
    except (OverflowError, OSError, ValueError):
        return None
    return text.lstrip("0")

def claude_read_state_line(summary, now=None):
    """Human line for a Claude read that is not fresh. None when the field is absent or fresh.

    Older caches have no read_state and render as before. Example:
    'claude stale 300m: rate_limited until 4:14 PM'.
    """
    if not isinstance(summary, dict):
        return None
    state = summary.get("read_state")
    code = state.get("claude") if isinstance(state, dict) else None
    if code not in ("token_expired", "rate_limited", "usage_failed"):
        return None
    if now is None:
        now = time.time()
    as_of = summary.get("as_of") if isinstance(summary.get("as_of"), dict) else {}
    stamp = as_of.get("claude")
    if _is_number(stamp):
        text = f"claude stale {max(0, int((now - stamp) // 60))}m: {code}"
    else:
        text = f"claude stale: {code}"
    if code == "rate_limited":
        untils = summary.get("rate_limited_until")
        raw = untils.get("claude") if isinstance(untils, dict) else None
        clock = _clock(raw) if _is_number(raw) else None
        if clock:
            text += f" until {clock}"
    return text

def _mark_reading_stale(lines):
    """Append the reading's age. Used when serving a cache instead of a failure."""
    suffix = _stale_suffix()
    if not suffix:
        return lines
    out = []
    for ln in lines:
        body = _reading_body(ln)
        if not body:
            out.append(ln)
            continue
        prefix = ln.split("|", 1)[0]
        out.append(f"{prefix}| {body}{suffix}")
    return out

def _oauth_expired_s(creds, now=None):
    """Seconds since expiresAt (ms epoch), or None when it is absent or still valid."""
    if not isinstance(creds, dict):
        return None
    raw = creds.get("expiresAt")
    if raw is None or isinstance(raw, bool):
        return None
    try:
        ms = float(raw)
    except (TypeError, ValueError):
        return None
    if ms != ms or ms == float("inf") or ms == float("-inf"):
        return None
    if now is None:
        now = time.time()
    age = now - (ms / 1000.0)
    if age > 0:
        return age
    return None

def _expired_token_lines(age_s):
    hours = max(0.0, age_s) / 3600.0
    note = f"claude   | token expired {hours:.1f}h ago; run `claude` once to refresh"
    reused = _reuse_cached_seat("claude")
    if not reused:
        return [note]
    body = _reading_body(reused[0])
    if not body:
        return [note]
    return [f"{note} | {body}{_stale_suffix()}"]

def _rate_limited_lines():
    """No HTTP. Stale cache when we have one; the failure only when we do not."""
    limits = _load_rate_limits()
    reused = _reuse_cached_seat("claude")
    if reused is not None:
        if _backoff_kind(limits):
            return _mark_reading_stale(reused)
        return reused
    code = _backoff_kind(limits) or 429
    if code == 401:
        return ["claude   | ? profile failed: HTTPError 401"]
    return [f"claude   | ? | usage failed: HTTPError {code}"]

def _reuse_cached_seat(seat):
    """Copy the last stored reading into SUMMARY, as_of included. None if this seat has none."""
    cached = _load_cache()
    as_of = cached.get("as_of") if isinstance(cached.get("as_of"), dict) else {}
    stamp = as_of.get(seat)
    if not _is_number(stamp):
        return None
    if not isinstance(SUMMARY.get("as_of"), dict):
        SUMMARY["as_of"] = {}
    SUMMARY["as_of"][seat] = stamp
    for k in SEAT_KEYS[seat]:
        if k in cached:
            SUMMARY[k] = cached[k]
        else:
            SUMMARY.pop(k, None)
    return [ln for ln in (cached.get("lines") or []) if line_seat(ln) == seat]

def _err(e):
    """Exception class plus HTTP status, e.g. "HTTPError 401"."""
    code = getattr(e, "code", None)
    return f"{e.__class__.__name__} {code}" if code else e.__class__.__name__

def iso_to_ts(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()

def pace_code(used_pct, resets_ts, window_sec, now=None):
    """'under' | 'on' | 'ahead' | '' comparing used% with elapsed% of the window.

    now defaults to the module NOW so a caller can keep the comparison pure.
    """
    if now is None:
        now = NOW
    if used_pct is None or not resets_ts or not window_sec:
        return ""
    elapsed = 1 - max(0.0, resets_ts - now) / window_sec
    elapsed_pct = round(100 * max(0.0, min(1.0, elapsed)))
    delta = round(used_pct) - elapsed_pct
    return "on" if abs(delta) <= 10 else ("ahead" if delta > 0 else "under")

# Seat -> (term end, renews). A pool's allowance is lost at the earlier of its
# reset and the term end, so pace and burn run to that end. Cursor has no term
# end key (it renews at cursor_reset_ts); Grok Bot bills Cursor.
RENEWAL_KEYS = {
    "claude": ("claude_renews_ts", "claude_renews"),
    "chatgpt": ("codex_renews_ts", "codex_renews"),
    "grok": ("grok_renews_ts", "grok_renews"),
}

def effective_end(s, seat, reset):
    """The earlier of reset and the term end, when the plan is confirmed not to renew.

    renews None (Claude's hand-kept date) is not a confirmed expiry, so it leaves reset alone.
    """
    keys = RENEWAL_KEYS.get(seat)
    if not keys or not isinstance(reset, (int, float)) or isinstance(reset, bool):
        return reset
    end, renews = s.get(keys[0]), s.get(keys[1])
    if renews is False and isinstance(end, (int, float)) and not isinstance(end, bool) and end < reset:
        return end
    return reset

def pace(used_pct, resets_ts, window_sec, now=None):
    if now is None:
        now = NOW
    code = pace_code(used_pct, resets_ts, window_sec, now)
    if not code:
        return ""
    elapsed = 1 - max(0.0, resets_ts - now) / window_sec
    elapsed_pct = round(100 * max(0.0, min(1.0, elapsed)))
    tag = {"on": "on pace", "ahead": "ahead of pace, conserve", "under": "under pace, spend it"}[code]
    return f"{tag} ({elapsed_pct}% of window elapsed)"

def seat_age_s(s, seat, now):
    """Age in seconds of one seat's reading, or None when as_of has no usable stamp.

    Caches written before per-seat times existed have no as_of and fall back to ts.
    """
    as_of = s.get("as_of")
    if isinstance(as_of, dict):
        stamp = as_of.get(seat)
        if stamp:
            return now - stamp
        return None
    return now - (s.get("ts") or 0)

def trim_history():
    """Cut HISTORY to its newest whole lines once it passes HISTORY_MAX_BYTES.
    The cut copy replaces the file in one rename. A line another process
    appends between the read and the rename is lost. Failures are silent."""
    tmp = None
    try:
        size = os.path.getsize(HISTORY)
        if size <= HISTORY_MAX_BYTES:
            return
        with open(HISTORY, "rb") as f:
            f.seek(max(0, size - HISTORY_KEEP_BYTES))
            data = f.read()
        nl = data.find(b"\n")
        data = data[nl + 1:] if nl >= 0 else b""
        tmp = f"{HISTORY}.{os.getpid()}.tmp"
        with open(tmp, "wb") as f:
            f.write(data)
        os.replace(tmp, HISTORY)
        tmp = None
    except Exception:
        pass
    finally:
        if tmp:
            try:
                os.remove(tmp)
            except OSError:
                pass

def record_pool(seat, pool, used_pct, reset_ts, window_s, source, read_ts=None):
    """One history line per pool. run_draws and Orderly's quota card read it.
    read_ts defaults to this process's clock. Muse passes the snapshot's
    captured_at. The file is size-capped (trim_history). Write failures are silent."""
    if isinstance(used_pct, bool) or not isinstance(used_pct, (int, float)):
        return
    if read_ts is None:
        read_ts = NOW
    row = {"host": socket.gethostname(), "seat": seat, "pool": pool, "used_pct": used_pct,
           "reset_ts": reset_ts, "window_s": window_s, "source": source, "read_ts": read_ts}
    _append_history(row)

def _append_history(row):
    """Append one history line. The file is size-capped. Write failures are silent."""
    try:
        os.makedirs(os.path.dirname(HISTORY), exist_ok=True)
        trim_history()
        with open(HISTORY, "a") as f:
            f.write(json.dumps(row) + "\n")
    except Exception:
        pass

def stale_tag(ts):
    age = NOW - ts
    return f" | stale (reading {age/3600:.1f}h old)" if age > STALE_HOURS * 3600 else ""

def when(ts):
    if not ts: return "?"
    d = ts - NOW
    if d < 0: return "reset due"
    if d < 86400: return f"resets in {d/3600:.1f}h"
    return f"resets in {d/86400:.1f}d"

def claude():
    # Local expiry and an on-disk backoff both return before any HTTP call.
    # A live usage deadline is served from the last reading, as_of included.
    # A fresh body stamps as_of with the clock that armed the min-interval
    # floor, not with the import-time NOW. Route treats a stamp older than
    # the live window as unknown.
    try:
        d = json.load(open(f"{H}/.claude/.credentials.json")).get("claudeAiOauth") or {}
        if "accessToken" not in d:
            raise KeyError("accessToken")
    except Exception as e:
        return [f"claude   | no stored token ({e.__class__.__name__})"]
    expired = _oauth_expired_s(d)
    if expired is not None:
        lines = _expired_token_lines(expired)
        _set_read_state("claude", "token_expired")
        return lines
    if _usage_rate_limited():
        lines = _rate_limited_lines()
        _apply_held_read_state()
        return lines
    hdr = {"Authorization": f"Bearer {d['accessToken']}", "anthropic-beta": "oauth-2025-04-20"}
    out = []
    # A cached plan is enough. Calling profile on every usage refresh is a second
    # Anthropic request in the same window, and that is what keeps a 429 alive.
    plan, status = _cached_plan_status()
    if plan == "?":
        try:
            plan, status = _profile_get(hdr)
        except _RateLimited as e:
            reused = _reuse_cached_seat("claude")
            _set_read_state("claude", "rate_limited", _usage_deadline(_load_rate_limits()))
            if reused is not None:
                return _mark_reading_stale(reused)
            if e.code == 401:
                return ["claude   | ? profile failed: HTTPError 401"]
            return [f"claude   | ? | usage failed: HTTPError {e.code}"]
        except Exception as e:
            plan, status = "?", f"profile failed: {_err(e)}"
    try:
        u, landed = _usage_get(hdr)
        parts = []
        scoped = False
        for l in u.get("limits", []):
            kind = l.get("kind"); pct = l.get("percent"); rs = l.get("resets_at")
            rts = iso_to_ts(rs) if rs else None
            if kind == "session":
                parts.append(f"5h {pct}% ({when(rts)})"); SUMMARY["claude_5h"] = pct; SUMMARY["claude_5h_reset_ts"] = rts
                record_pool("claude", "claude 5h", pct, rts, 5 * 3600, "live")
            elif kind == "weekly_all":
                parts.append(f"weekly all {pct}%: {pace(pct, rts, 7*86400)}, {when(rts)}")
                SUMMARY["claude_week"] = pct; SUMMARY["claude_week_pace"] = pace_code(pct, rts, 7*86400); SUMMARY["claude_week_reset_ts"] = rts
                record_pool("claude", "claude weekly all", pct, rts, 7 * 86400, "live")
            elif kind == "weekly_scoped":
                name = ((l.get("scope") or {}).get("model") or {}).get("display_name", "scoped")
                parts.append(f"weekly {name} {pct}%: {pace(pct, rts, 7*86400)}")
                SUMMARY["fable"] = pct; SUMMARY["fable_pace"] = pace_code(pct, rts, 7*86400); SUMMARY["fable_reset_ts"] = rts
                scoped = True
                record_pool("claude", "claude weekly Fable", pct, rts, 7 * 86400, "live")
        SUMMARY["claude_plan"] = plan; SUMMARY["claude_status"] = status
        is_max = claude_max_flag(plan, scoped)
        if is_max is not None:
            SUMMARY["claude_max"] = is_max
        claude_renewal(status)
        SUMMARY["as_of"]["claude"] = landed
        _set_read_state("claude", "fresh")
        out.append(f"claude   | {plan} {status} | " + " | ".join(parts))
    except _RateLimited as e:
        reused = _reuse_cached_seat("claude")
        _set_read_state("claude", "rate_limited", _usage_deadline(_load_rate_limits()))
        if reused is not None:
            return _mark_reading_stale(reused)
        out.append(f"claude   | {plan} {status} | usage failed: HTTPError {e.code}")
    except Exception as e:
        _hold_usage_failure()
        reused = _reuse_cached_seat("claude")
        _set_read_state("claude", "usage_failed")
        if reused is not None:
            return _mark_reading_stale(reused)
        out.append(f"claude   | {plan} {status} | usage failed: {_err(e)}")
    return out

def claude_max_flag(plan, scoped):
    """True on a Max plan, False on Pro, None when unknown.

    A weekly_scoped (Fable) limit in this usage reading says Max outright:
    only Max has one. Otherwise the OAuth profile's organization.rate_limit_tier
    decides (claude_plan is that name without "default_"): "max" in it is Max,
    claude_ai (Pro, seen 2026-10) is not, and any other name (team, enterprise,
    a new tier, or "?" from a failed profile read) is unknown.
    """
    if scoped:
        return True
    return _plan_is_max(plan)

# Tier names seen without a Fable slice. Any other tier without "max" is unknown.
NON_MAX_TIERS = ("claude_ai", "claude_pro")

def _plan_is_max(plan):
    if not isinstance(plan, str):
        return None
    name = plan.strip().lower().replace("default_", "")
    if "max" in name:
        return True
    if name in NON_MAX_TIERS:
        return False
    return None

def claude_max(s):
    """True on Max, False on Pro, None when the cache cannot say.

    claude_tier, then claude_plan, is read first. A value is a plan only when
    it is a non-empty string other than "?": strip, drop "default_", "max"
    in the name is Max, NON_MAX_TIERS is not, and any other name is unknown.
    The claude_max bool is used only when neither key names a plan.
    """
    s = s if isinstance(s, dict) else {}
    for key in ("claude_tier", "claude_plan"):
        raw = s.get(key)
        if isinstance(raw, str) and raw.strip() and raw.strip() != "?":
            return _plan_is_max(raw)
    v = s.get("claude_max")
    return v if isinstance(v, bool) else None

def claude_renewal(status=None):
    """Neither the OAuth profile nor usage endpoint carries a billing date (checked
    2026-10-08), so the Max term end is kept by hand in RENEWALS_FILE as
    {"claude": {"at": "2026-10-14", "renews": null}}. renews: true, false, or null
    for not known.

    A hand-kept date that has passed while the live profile says "active" is
    dropped: the profile describes the plan in force now, and the date an earlier
    term. Max ended 2026-10-14 for Pro, and the stale date capped every Claude
    pool as "term ended" until it was cleared by hand."""
    try:
        r = json.load(open(RENEWALS_FILE)).get("claude") or {}
        at = r.get("at")
        if at:
            # A date with no clock is a calendar day. The timestamp is only the
            # day's start in Pacific time, so callers must not print it as a known hour.
            date_only = "T" not in at
            ts = iso_to_ts(at if not date_only else at + "T00:00:00-07:00")
            if status == "active" and ts <= NOW:
                return
            SUMMARY["claude_renews_ts"] = ts
            SUMMARY["claude_renews"] = r.get("renews")
            SUMMARY["claude_renews_date_only"] = date_only
            SUMMARY["claude_renews_on"] = at if date_only else None
    except Exception:
        pass

_RENEWALS_WARNED = set()
RENEWALS_KEYS = ("at", "renews", "ends")


def _renewals_warn(msg):
    """One stderr line per distinct renewals.json problem per process. Never exits."""
    if msg not in _RENEWALS_WARNED:
        _RENEWALS_WARNED.add(msg)
        print(f"seat-usage: warning: {RENEWALS_FILE}: {msg}", file=sys.stderr)


def seat_ends():
    """{seat: last active day} from the optional per-seat "ends" in RENEWALS_FILE.

    {"muse": {"ends": "2026-11-12"}} keeps Muse seatable through 2026-11-12 in
    this machine's zone and ends it at the next local midnight. A seat without
    "ends", "ends": null, a missing file, or a file that does not parse changes
    nothing (the same as claude_renewal). A bad entry never stops a run: an
    "ends" that is not a YYYY-MM-DD date, a seat key that is not a roster seat,
    or a key other than at/renews/ends warns once on stderr, and only that
    seat's "ends" is ignored. The status line, push timer and hooks keep working.
    """
    try:
        with open(RENEWALS_FILE) as f:
            data = json.load(f)
    except Exception:
        return {}
    known = {meta.get("seat") for meta in POOLS.values()}
    out = {}
    for seat, rec in (data.items() if isinstance(data, dict) else ()):
        if seat not in known:
            _renewals_warn(f"unknown seat {json.dumps(seat)} ignored (seats: {', '.join(sorted(known))})")
            continue
        if not isinstance(rec, dict):
            _renewals_warn(f"{seat} must be an object, got {json.dumps(rec)}; ignored")
            continue
        for key in rec:
            if key not in RENEWALS_KEYS:
                _renewals_warn(f"unknown key {seat}.{key} ignored (keys: {', '.join(RENEWALS_KEYS)})")
        day = rec.get("ends")
        if day is None:
            continue
        ok = isinstance(day, str) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", day)
        if ok:
            try:
                datetime.strptime(day, "%Y-%m-%d")
            except ValueError:
                ok = False
        if not ok:
            _renewals_warn(f"{seat}.ends must be a YYYY-MM-DD date, got {json.dumps(day)}; ignoring it")
            continue
        out[seat] = day
    return out


def seat_ended(seat, now):
    """"ended <day>" once the seat's "ends" day is over in this machine's zone, else None."""
    day = seat_ends().get(seat)
    if day is None:
        return None
    start = datetime.strptime(day, "%Y-%m-%d")
    over = datetime.fromordinal(start.toordinal() + 1).timestamp()   # naive: local midnight after it
    return f"ended {day}" if now >= over else None

def codex_renewal(hdr):
    """ChatGPT's own billing call. active_until is the paid-through time; will_renew
    is false once the plan is cancelled."""
    try:
        aid = hdr.get("ChatGPT-Account-Id", "")
        s = get(f"https://chatgpt.com/backend-api/subscriptions?account_id={urllib.parse.quote(aid)}", hdr)
        if s.get("active_until"):
            SUMMARY["codex_renews_ts"] = iso_to_ts(s["active_until"])
            SUMMARY["codex_renews"] = s.get("will_renew")
            return
    except Exception:
        pass
    keep_codex_term()

def keep_codex_term():
    """Carry the last known term end forward. A lapsed plan drops to free and the
    billing call stops returning active_until; without this, a plan that ended
    reads as a live one again. A renewal returns a new date and replaces it."""
    cached = _load_cache()
    for k in ("codex_renews_ts", "codex_renews"):
        if k in cached:
            SUMMARY[k] = cached[k]

def codex():
    """ChatGPT's Codex bucket. Live from chatgpt.com/backend-api/wham/usage, the call
    the Codex CLI makes (path found in its binary, 2026-10-03), with the stored login.
    The newest local rollout's rate_limits block is only the fallback: on 2026-10-03
    OpenAI reset the bucket early and this machine's last run was 22.6h old."""
    try:
        t = json.load(open(f"{H}/.codex/auth.json"))["tokens"]
        hdr = {"Authorization": f"Bearer {t['access_token']}", "ChatGPT-Account-Id": t.get("account_id", "")}
        u = get("https://chatgpt.com/backend-api/wham/usage", hdr)
        rl = u["rate_limit"]
        windows = []
        for key in ("primary_window", "secondary_window"):
            w = rl.get(key)
            if w: windows.append((key, w.get("used_percent"), w.get("reset_at"), w.get("limit_window_seconds") or 0))
        if not windows: raise KeyError("primary_window")
        SUMMARY["as_of"]["chatgpt"] = NOW
        codex_renewal(hdr)
        return [codex_line(u.get("plan_type", "?"), "live", windows, 0.0)]
    except Exception as e:
        live_err = f"{e.__class__.__name__}" + (f" {e.code}" if hasattr(e, "code") else "")
    files = sorted(glob.glob(f"{H}/.codex/sessions/*/*/*/*.jsonl"), key=os.path.getmtime)
    last = None
    dec = json.JSONDecoder()
    for f in reversed(files[-20:]):
        try:
            for line in open(f, errors="ignore"):
                i = line.find('"rate_limits":')
                if i < 0: continue
                try:
                    obj, _ = dec.raw_decode(line[i + len('"rate_limits":'):])
                    if isinstance(obj, dict) and obj.get("limit_id") == "codex": last = (f, obj)
                except Exception:
                    continue
            if last: break
        except Exception:
            continue
    if not last:
        return [f"chatgpt  | live call failed ({live_err}) and no rate_limits found in ~/.codex/sessions"]
    f, rl = last
    mtime = os.path.getmtime(f)
    age_h = (NOW - mtime) / 3600
    SUMMARY["as_of"]["chatgpt"] = mtime
    windows = [(key, w.get("used_percent"), w.get("resets_at"), (w.get("window_minutes") or 0) * 60)
               for key in ("primary", "secondary") if (w := rl.get(key))]
    # The billing call needs the live login too.
    keep_codex_term()
    line = codex_line(rl.get("plan_type", "?"), f"from last local codex run, {age_h:.1f}h ago; live call failed: {live_err}", windows, age_h)
    return [line + stale_tag(mtime)]

def codex_line(plan, source, windows, age_h):
    """windows: (key, used %, reset ts, window seconds); the first is the primary."""
    src = "live" if source == "live" else "rollout"
    parts = []
    # Pro reports one weekly window. Plus reports a 5h primary and a weekly
    # secondary (seen 2026-10-09), so the longest window is the pool and the
    # 5h one is kept beside it, as for Claude.
    windows = sorted(windows, key=lambda w: -(w[3] or 0))
    for i, (_, used, reset, secs) in enumerate(windows):
        label = "weekly" if secs >= 7*86400 else f"{secs/3600:.0f}h"
        end = effective_end(SUMMARY, "chatgpt", reset)
        term = f", term ends {when(end).replace('resets ', '').replace('reset due', 'now')}" if end != reset else ""
        parts.append(f"{label} {used}%: {pace(used, end, secs)}, {when(reset)}{term}")
        if i == 0:
            SUMMARY["codex"] = used; SUMMARY["codex_pace"] = pace_code(used, end, secs)
            SUMMARY["codex_reset_ts"] = reset; SUMMARY["codex_window_s"] = secs
            record_pool("chatgpt", "chatgpt weekly", used, reset, secs, src)
        elif 0 < secs <= 6 * 3600:
            SUMMARY["codex_5h"] = used; SUMMARY["codex_5h_reset_ts"] = reset
            record_pool("chatgpt", "chatgpt 5h", used, reset, secs, src)
    SUMMARY["codex_plan"] = plan; SUMMARY["codex_age_h"] = round(age_h, 1)
    SUMMARY["codex_source"] = src
    return f"chatgpt  | {plan} ({source}) | " + " | ".join(parts)

def cursor():
    try:
        tok = json.load(open(f"{H}/.config/cursor/auth.json"))["accessToken"]
        pl = tok.split(".")[1]; pl += "=" * (-len(pl) % 4)
        uid = json.loads(base64.urlsafe_b64decode(pl))["sub"].split("|")[-1]
    except Exception as e:
        return [f"cursor   | no stored token ({e.__class__.__name__})"]
    # The dashboard wants the WorkOS session cookie built as <userId>::<accessToken>.
    hdr = {"Cookie": "WorkosCursorSessionToken=" + urllib.parse.quote(uid + "::" + tok, safe=""),
           "Origin": "https://cursor.com", "Referer": "https://cursor.com/dashboard"}
    try:
        m = get("https://cursor.com/api/auth/stripe", hdr)
        member = m.get("membershipType", "?"); status = m.get("subscriptionStatus", "?")
        # The plan renews at the billing cycle end (cursor_reset_ts) unless a cancellation is pending.
        SUMMARY["cursor_renews"] = not m.get("pendingCancellationDate")
    except Exception as e:
        member, status = "?", f"membership failed: {_err(e)}"
    SUMMARY["cursor"] = member.replace("pro_plus", "pro+")
    try:
        req = urllib.request.Request("https://cursor.com/api/dashboard/get-current-period-usage", data=b"{}", method="POST",
                                     headers={"User-Agent": "seat-usage", "Content-Type": "application/json", **hdr})
        with urllib.request.urlopen(req, timeout=8) as r: u = json.loads(r.read().decode())
        pu = u.get("planUsage", {})
        # A fresh billing cycle omits totalSpend (seen 2026-10-15), so default it to 0.
        spent, limit = pu.get("totalSpend") or 0, pu.get("limit")
        start = int(u.get("billingCycleStart", 0)) / 1000; end = int(u.get("billingCycleEnd", 0)) / 1000
        # The dashboard bars are autoPercentUsed (Cursor Models) and apiPercentUsed (Other Models).
        # totalSpend/limit includes provider bonus and overstates usage, so it is not a percentage of anything.
        auto, api = pu.get("autoPercentUsed"), pu.get("apiPercentUsed")
        pct = round(max(auto or 0, api or 0), 1) if auto is not None or api is not None else None
        pc = pace_code(pct, end, end - start) if pct is not None and end and start else ""
        sl = u.get("spendLimitUsage", {}); od, odl = sl.get("individualUsed") or 0, sl.get("individualLimit")
        SUMMARY["cursor_pct"] = pct; SUMMARY["cursor_pace"] = pc; SUMMARY["cursor_reset_ts"] = end or None; SUMMARY["cursor_window_s"] = (end - start) or None
        # Both bars, for the status line. Grok 4.7 draws Cursor Models (auto), measured 2026-10-01.
        # cursor_pct stays the max of the two bars for the status line. Routing reads cursor_auto_pct only.
        for key, v, pool in (("cursor_auto", auto, "cursor models"), ("cursor_api", api, "cursor other models")):
            if v is not None:
                SUMMARY[f"{key}_pct"] = round(v, 1); SUMMARY[f"{key}_pace"] = pace_code(v, end, end - start) if end and start else ""
                record_pool("cursor", pool, round(v, 1), end or None, (end - start) or None, "live")
        SUMMARY["cursor_ondemand"] = od / 100
        SUMMARY["cursor_ondemand_limit"] = odl / 100 if odl else None
        odtxt = f" | on-demand ${od/100:.2f} of ${odl/100:.0f}" if odl else ""
        out = [f"cursor   | {member} {status} | cursor models {auto or 0:.0f}%, other models {api or 0:.0f}% (${spent/100:.2f} spent incl. bonus): {pace(pct, end, end - start)}, {when(end)}{odtxt}"]
        SUMMARY["as_of"]["cursor"] = NOW
    except Exception as e:
        out = [f"cursor   | {member} {status} | usage failed: {_err(e)}"]
    return out + [grok_bot(tok)]

def grok_bot(tok):
    """Grok Bot's weekly allowance. Separate from both Cursor dashboard bars; "Sand"
    is the Bot's internal name. Same call the Bot desktop app's Settings > Usage makes."""
    try:
        req = urllib.request.Request("https://api2.cursor.sh/aiserver.v1.DashboardService/GetSandUsageStatus", data=b"{}", method="POST",
                                     headers={"User-Agent": "seat-usage", "Content-Type": "application/json",
                                              "Connect-Protocol-Version": "1", "Authorization": f"Bearer {tok}"})
        with urllib.request.urlopen(req, timeout=8) as r: b = json.loads(r.read().decode())
        pct = b.get("usagePercent")
        if pct is None: return "grokbot  | no usagePercent (pooled enterprise allowance?)"
        start, end = iso_to_ts(b["currentPeriodStart"]), iso_to_ts(b["nextResetTimestampUtc"])
        SUMMARY["bot_pct"] = round(pct, 1); SUMMARY["bot_pace"] = pace_code(pct, end, end - start); SUMMARY["bot_reset_ts"] = end; SUMMARY["bot_window_s"] = end - start
        SUMMARY["bot_exhausted"] = b.get("hasAvailableUsage") is False
        SUMMARY["as_of"]["grokbot"] = NOW
        record_pool("grokbot", "grokbot week", round(pct, 1), end, end - start, "live")
        od = (b.get("onDemandSettings") or {}).get("enabled")
        state = "" if b.get("hasAvailableUsage", True) else " | ALLOWANCE USED" + (", on-demand" if od else ", blocked")
        return f"grokbot  | {b.get('cursorPlanName', '?')} | week {pct:.1f}%: {pace(pct, end, end - start)}, {when(end)}{state}"
    except Exception as e:
        return f"grokbot  | usage failed: {_err(e)}"

DEFAULT_OP_REF = "op://seat-usage/grok web cookie/credential"
DEFAULT_OP_TOKEN_FILE = "~/.config/seat-usage/op-token"
COOKIE_TRIED = []   # why each cookie source failed, for the grok line

COOKIE_TTL_S = 6 * 3600

def op_ref():
    return os.environ.get("SEAT_USAGE_OP_REF") or DEFAULT_OP_REF

def op_token_file():
    return os.path.expanduser(os.environ.get("SEAT_USAGE_OP_TOKEN_FILE") or DEFAULT_OP_TOKEN_FILE)

def op_env():
    """Env for `op`: a copy of os.environ with OP_SERVICE_ACCOUNT_TOKEN from
    op_token_file() when that file is non-empty, else None (inherit, as before).
    The token is never printed, logged or put in argv."""
    p = op_token_file()
    try:
        if not os.path.isfile(p):   # missing, or a FIFO/device that open() could block on
            return None
        with open(p, encoding="utf-8-sig") as f:   # utf-8-sig: drop a Windows editor's BOM
            mode = os.fstat(f.fileno()).st_mode
            tok = f.read().strip()
    except Exception:
        return None
    if not tok:
        return None
    if mode & 0o077:
        print(f"seat-usage: {p} is mode {mode & 0o777:o}; chmod 600 it", file=sys.stderr)
    env = os.environ.copy()
    env["OP_SERVICE_ACCOUNT_TOKEN"] = tok
    return env

def wsl_env(env, path):
    """WSL hands a Windows .exe only the variables named in $WSLENV, so add the
    token's name there for op.exe. env None (no token file) stays None."""
    if env is None or not path.lower().endswith(".exe"):
        return env
    names = [x for x in env.get("WSLENV", "").split(":") if x]
    if "OP_SERVICE_ACCOUNT_TOKEN" in (x.split("/")[0] for x in names):
        return env
    return dict(env, WSLENV=":".join(names + ["OP_SERVICE_ACCOUNT_TOKEN"]))

def cookie_cache_path():
    return f"{CACHE_DIR}/grok-cookie"

def read_cookie_cache():
    """(value, age in seconds) from the 0600 cookie cache, or (None, None)."""
    p = cookie_cache_path()
    try:
        v = open(p).read().strip()
        return (v, time.time() - os.path.getmtime(p)) if v else (None, None)
    except Exception:
        return (None, None)

def write_cookie_cache(v):
    p = cookie_cache_path()
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        fd = os.open(p + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(v)
        os.replace(p + ".tmp", p)
    except Exception:
        pass

def grok_cookie():
    """The grok.com browser 'sso' cookie. A cached copy younger than
    COOKIE_TTL_S first, so live runs do not each spend a 1Password read: the
    service account's daily read cap is shared by every machine and tool.
    Then 1Password (`op read` of op_ref(): $SEAT_USAGE_OP_REF, else
    DEFAULT_OP_REF; authenticated with the service-account token in
    op_token_file() when that file is non-empty), then the stale cached copy, then
    ~/.grok/web-cookie.
    The op binary is found by name: $SEAT_USAGE_OP if set, else op.exe (Windows
    1Password from WSL), else op. The first one that returns a value wins.
    Hooks and the status line's background refresh can run without the Windows
    dirs on PATH, so op.exe falls back to its WinGet install path."""
    import glob, shutil, subprocess
    if pull_only():
        COOKIE_TRIED.append("pull-only host")
        return None
    cached, age = read_cookie_cache()
    if cached and age < COOKIE_TTL_S:
        return cached
    override = os.environ.get("SEAT_USAGE_OP")
    winget = sorted(glob.glob("/mnt/c/Users/*/AppData/Local/Microsoft/WinGet/Packages/AgileBits.1Password.CLI_*/op.exe"))
    env = op_env()   # $SEAT_USAGE_OP_TOKEN_FILE, else ~/.config/seat-usage/op-token
    for name in ([override] if override else ["op.exe", "op"]):
        path = shutil.which(name) or (winget[-1] if name == "op.exe" and winget else None)
        if not path:
            COOKIE_TRIED.append(f"{name} not on PATH"); continue
        try:
            # Own session, no stdin: under a terminal, op could otherwise stop this whole group.
            r = subprocess.run([path, "read", op_ref()], capture_output=True, text=True, timeout=20,
                               stdin=subprocess.DEVNULL, start_new_session=True, env=wsl_env(env, path))
            v = r.stdout.replace("\r", "").strip()
            if r.returncode == 0 and v:
                write_cookie_cache(v)
                return v
            COOKIE_TRIED.append(f"{name} read failed")
        except Exception as e:
            COOKIE_TRIED.append(f"{name} {e.__class__.__name__}")
    if cached:
        return cached
    try:
        v = open(f"{H}/.grok/web-cookie").read().strip()
        if v: return v
        COOKIE_TRIED.append("~/.grok/web-cookie empty")
    except Exception:
        COOKIE_TRIED.append("no ~/.grok/web-cookie")
    return None

def grok():
    """SuperGrok. Tier from grok.com/rest/subscriptions with the CLI key. The weekly
    usage panel (grok.com Settings > Usage) refuses the CLI's OAuth2 token, so it is
    read only with the browser 'sso' cookie (see grok_cookie)."""
    key = None
    try:
        a = json.load(open(f"{H}/.grok/auth.json")); inner = list(a.values())[0]; key = inner.get("key")
    except Exception:
        pass
    tier, status, expiry, cancels = "?", "", None, False
    sso = grok_cookie()
    SUMMARY["grok_cookie_ok"] = bool(sso)
    try:
        # The CLI key got 403 here on 2026-10-08; the browser cookie still works.
        try:
            subs = get("https://grok.com/rest/subscriptions", {"Authorization": f"Bearer {key}"}).get("subscriptions", [])
        except Exception:
            if not sso: raise
            subs = get("https://grok.com/rest/subscriptions", {"User-Agent": "Mozilla/5.0", "Cookie": f"sso={sso}; sso-rw={sso}"}).get("subscriptions", [])
        live = [x for x in subs if x.get("status") == "SUBSCRIPTION_STATUS_ACTIVE"] or subs[:1]
        if live:
            x = live[0]
            tier = x.get("tier", "?").replace("SUBSCRIPTION_TIER_GROK_PRO", "SuperGrok").replace("SUBSCRIPTION_TIER_", "")
            status = "active" if x.get("status") == "SUBSCRIPTION_STATUS_ACTIVE" else x.get("status", "")
            expiry = x.get("billingPeriodEnd") or (x.get("google") or {}).get("expiryTime")
            cancels = bool(x.get("cancelAtPeriodEnd"))
            if expiry:
                SUMMARY["grok_renews_ts"] = iso_to_ts(expiry); SUMMARY["grok_renews"] = not cancels
    except Exception:
        try:   # fall back to the server-fetched settings cache
            d = json.load(open(f"{H}/.grok/settings_cache.json"))
            pl = d.get("payload"); pl = json.loads(pl) if isinstance(pl, str) else pl
            tier = (pl.get("settings") or {}).get("subscription_tier_display") or "?"
        except Exception:
            pass
    SUMMARY["grok"] = tier
    # Weekly pool, only with the browser cookie. The Settings > Usage panel reads
    # grok_api_v2.GrokBuildBilling/GetGrokCreditsConfig, served as GET /rest/grok/credits
    # (found in the grok.com JS bundle, 2026-09-30). /rest/rate-limits is a per-model
    # 2h query window, not this pool.
    weekly = None
    if sso:
        try:
            weekly = get("https://grok.com/rest/grok/credits", {"User-Agent": "Mozilla/5.0", "Cookie": f"sso={sso}; sso-rw={sso}"}).get("config") or {}
            per = weekly.get("currentPeriod") or {}
            pct = weekly.get("creditUsagePercent")
            if pct is not None and per.get("start") and per.get("end"):
                start, end = iso_to_ts(per["start"]), iso_to_ts(per["end"])
                SUMMARY["grok_pct"] = pct; SUMMARY["grok_pace"] = pace_code(pct, end, end - start)
                SUMMARY["grok_reset_ts"] = end; SUMMARY["grok_window_s"] = end - start
                SUMMARY["as_of"]["grok"] = NOW
                SUMMARY["grok_products"] = {u["product"].replace("PRODUCT_GROK_", "").lower(): u.get("usagePercent", 0)
                                            for u in weekly.get("productUsage", []) if u.get("usagePercent")}
                record_pool("grok", "grok week", pct, end, end - start, "live")
        except Exception as e:
            weekly = {"error": e.__class__.__name__}
    # The empty signal: a 402 "usage balance exhausted" in the CLI log within the last day.
    last402 = None
    try:
        logf = f"{H}/.grok/logs/unified.jsonl"
        with open(logf, "rb") as f:
            f.seek(0, 2); size = f.tell(); f.seek(max(0, size - 2_000_000)); tail = f.read().decode(errors="ignore")
        for line in reversed(tail.splitlines()):
            if '"status_code":402' in line:
                m = re.search(r'"ts":"([^"]+)"', line)
                if m: last402 = iso_to_ts(m.group(1)); break
    except Exception:
        pass
    # Empty until the weekly Grok reset, not for 24h: the routing rule's horizon is
    # the reset, and the pool refills only then. The server's period start is the
    # last reset; without the cookie, fall back to Thursday 5:38 PM Pacific.
    per_start = ((weekly or {}).get("currentPeriod") or {}).get("start")
    if per_start:
        last_reset = iso_to_ts(per_start)
    else:
        try:
            from zoneinfo import ZoneInfo
            pt = ZoneInfo("America/Los_Angeles")
            now_pt = datetime.fromtimestamp(NOW, pt)
            days_back = (now_pt.weekday() - 3) % 7
            reset = (now_pt - __import__("datetime").timedelta(days=days_back)).replace(hour=17, minute=38, second=0, microsecond=0)
            if reset > now_pt: reset -= __import__("datetime").timedelta(days=7)
            last_reset = reset.timestamp()
        except Exception:
            last_reset = NOW - 7 * 86400
    exhausted = (last402 is not None and last402 > last_reset) or (SUMMARY.get("grok_pct") or 0) >= 100
    SUMMARY["grok_exhausted"] = exhausted
    SUMMARY["grok_402_h"] = round((NOW - last402) / 3600, 1) if last402 else None
    parts = [f"{tier} {status}".strip() + (f", sub {'ends' if cancels else 'renews'} {when(iso_to_ts(expiry)).replace('resets ', '')}" if expiry else "")]
    if weekly is None:
        parts.append(f"weekly pool needs the browser sso cookie ({op_ref()}): " + "; ".join(COOKIE_TRIED))
    elif "error" in weekly:
        parts.append(f"weekly pool read failed with cookie: {weekly['error']}")
    elif "grok_pct" in SUMMARY:
        prods = ", ".join(f"{k} {v}%" for k, v in SUMMARY.get("grok_products", {}).items())
        parts.append(f"week {SUMMARY['grok_pct']}% ({when(SUMMARY['grok_reset_ts'])}; {pace(SUMMARY['grok_pct'], SUMMARY['grok_reset_ts'], SUMMARY['grok_reset_ts'] - last_reset)})" + (f" [{prods}]" if prods else ""))
    else:
        parts.append("cookie ok but /rest/grok/credits had no weekly period")
    parts.append(f"EXHAUSTED: 402 {SUMMARY['grok_402_h']}h ago, until the weekly reset" if exhausted else "no 402 since the last weekly reset")
    return ["grok     | " + " | ".join(parts)]

# Burn nudge: a pool well under pace that resets soon loses the rest at the reset.
BURN_HOURS = 24      # the reset is less than this many hours away
BURN_GAP = 25        # used% is at least this many points below elapsed%
BURN_POOLS = (       # (seat, pool, used key, reset key, window key or fixed seconds)
    ("claude", "weekly all", "claude_week", "claude_week_reset_ts", 7 * 86400),
    ("claude", "weekly Fable", "fable", "fable_reset_ts", 7 * 86400),
    ("chatgpt", "weekly", "codex", "codex_reset_ts", "codex_window_s"),
    ("cursor", "cursor models (month)", "cursor_auto_pct", "cursor_reset_ts", "cursor_window_s"),
    ("cursor", "other models (month)", "cursor_api_pct", "cursor_reset_ts", "cursor_window_s"),
    ("grokbot", "week", "bot_pct", "bot_reset_ts", "bot_window_s"),
    ("grok", "week", "grok_pct", "grok_reset_ts", "grok_window_s"),
)

def burn_entries(s, now):
    """Pools in the use-it-or-lose-it band, from a SUMMARY-shaped dict at time now.

    Same band the scorer adds as a bonus. Thresholds live in config (lose_it_hours,
    lose_it_gap). A disabled pool is not in POOLS, so it cannot qualify.
    """
    out = []
    for _pid, meta in POOLS.items():
        if not meta.get("lose_it"):
            continue
        seat = meta["seat"]
        if seat_ended(seat, now):
            continue
        used = s.get(meta["used"])
        reset = effective_end(s, seat, s.get(meta["reset"]))
        wk = meta["window"]
        window = wk if isinstance(wk, (int, float)) else s.get(wk)
        if not isinstance(used, (int, float)) or not reset or not window:
            continue
        age = seat_age_s(s, seat, now)
        if age is None or age > STALE_HOURS * 3600:
            continue
        left_s = reset - now
        if left_s <= 0 or left_s >= BURN_HOURS * 3600:
            continue
        elapsed_pct = 100 * max(0.0, min(1.0, 1 - left_s / window))
        if elapsed_pct - used < BURN_GAP:
            continue
        out.append({"seat": seat, "pool": meta.get("burn") or meta["label"],
                    "used_pct": round(used, 1), "elapsed_pct": round(elapsed_pct),
                    "left_pct": round(100 - used), "reset_ts": reset, "hours": round(left_s / 3600, 1)})
    return out

def burn_line(e):
    return (f"burn: {e['seat']} {e['pool']} {e['left_pct']}% left, expires in {e['hours']}h"
            " - raise builder effort or add an opt-in leg (rymiwe/conclave-archive#16)")


    "muse": ("muse_5h", "muse_5h_reset_ts", "muse_week", "muse_week_reset_ts"),
}
LINE_SEATS = ("claude", "chatgpt", "cursor", "grokbot", "grok")

# Pool records, role defaults, and score weights are loaded from config/pools.json.
# Model ids live in that file. ROUTE_RULES is empty: score_route replaced the table.
# A pool with enabled false is left out of POOLS.
POOLS = {}
ROLES = {}
POOL_ORDER = ()
SCORING = {}
PRIORS = {}
ROUTE_RULES = ()
BURN_POOLS = ()
NEAR_CAP = 95
_ASK = "ask Ryan"
_FIX_ASK = "fix the failed reading, then ask Ryan"

def _repo_root():
    return os.path.dirname(os.path.dirname(os.path.realpath(__file__)))

def pools_file():
    env = os.environ.get("SEAT_USAGE_POOLS")
    if env:
        return env
    return os.path.join(_repo_root(), "config", "pools.json")

def priors_file():
    """External prior file. Absent means the seeds in pools.json stand."""
    env = os.environ.get("SEAT_USAGE_PRIORS")
    if env:
        return env
    path = os.path.join(_repo_root(), "config", "priors.json")
    return path if os.path.isfile(path) else None

def outcomes_files():
    """Local track-record logs. A missing file is not an error.

    Council writes ~/.local/state/seat-usage/runs.jsonl (SEAT_USAGE_RUNS).
    Each run line carries the task role and seat agreement: a seats list, or
    the lineup's chair, builder, and voters. agreed is whether that seat
    matched the verdict. SEAT_USAGE_OUTCOMES is an extra log of
    {role, pool, agreed} lines.
    """
    home = os.path.expanduser("~")
    outcomes = os.environ.get("SEAT_USAGE_OUTCOMES") or os.path.join(
        home, ".local", "state", "seat-usage", "outcomes.jsonl")
    runs = os.environ.get("SEAT_USAGE_RUNS") or os.path.join(
        home, ".local", "state", "seat-usage", "runs.jsonl")
    return (outcomes, runs)

def blend_strength(provider, prior, track, n, provider_pseudo=8, prior_pseudo=8):
    """Blend provider facts, an external prior, and our own track record.

    effective = (P * provider + R * prior + n * track) / (P + R + n)

    P is provider_pseudo when provider is present, else 0. R is prior_pseudo
    when prior is present, else 0. n is the number of local samples. A missing
    source is left out of both the numerator and the denominator, so it does
    not count as zero. With the defaults, n = 0 returns the mean of whichever
    seeds exist, n = 16 ties our data with the two seeds together, and larger
    n lets the track record outweigh the prior.
    """
    num = 0.0
    den = 0.0
    if provider is not None:
        num += provider_pseudo * float(provider)
        den += provider_pseudo
    if prior is not None:
        num += prior_pseudo * float(prior)
        den += prior_pseudo
    if track is not None and n:
        num += n * float(track)
        den += n
    if den == 0:
        return None
    return num / den

def _prior_value(raw):
    if isinstance(raw, bool) or raw is None:
        return None
    if isinstance(raw, (int, float)):
        return float(raw)
    if isinstance(raw, dict):
        score = raw.get("score")
        if isinstance(score, (int, float)) and not isinstance(score, bool):
            return float(score)
    return None

def read_priors(path):
    """Map pool id -> role -> prior score. Missing or unreadable file returns {}."""
    if not path:
        return {}
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        return {}
    scores = data.get("scores") if isinstance(data, dict) else None
    if not isinstance(scores, dict):
        return {}
    out = {}
    for pid, roles in scores.items():
        if not isinstance(roles, dict):
            continue
        parsed = {}
        for role, raw in roles.items():
            value = _prior_value(raw)
            if value is not None:
                parsed[role] = value
        if parsed:
            out[pid] = parsed
    return out

def _absorb_sample(samples, role, pool, agreed):
    if not role or not pool or not isinstance(agreed, bool):
        return
    samples.setdefault((pool, role), []).append(1.0 if agreed else 0.0)

def _agreement(obj):
    """True when this seat matched the verdict, false when it did not."""
    for key in ("agreed", "agreed_with_verdict"):
        val = obj.get(key)
        if isinstance(val, bool):
            return val
    return None

def _pool_for(seat, family, pool):
    """Pool id for a council seat. An explicit pool id wins when it is configured."""
    if isinstance(pool, str) and pool:
        return pool
    exact, served = [], []
    for pid, meta in POOLS.items():
        if seat and meta.get("seat") != seat:
            continue
        if family and meta.get("family") == family:
            exact.append(pid)
        elif family and family in (meta.get("serves") or ()):
            served.append(pid)
        elif seat and not family:
            exact.append(pid)
    cands = exact or served
    if not cands:
        return None
    def rank(pid):
        meta = POOLS[pid]
        return (0 if meta.get("strengths") else 1, 0 if meta.get("lose_it") else 1, pid)
    return sorted(cands, key=rank)[0]

def _sample_role(party_role, parent_role):
    """A launch role on the seat wins. A voter inherits the task role."""
    if party_role in ROLES:
        return party_role
    return parent_role

def _absorb_party(samples, parent_role, party):
    if not isinstance(party, dict):
        return
    agreed = _agreement(party)
    if agreed is None:
        return
    pool = _pool_for(party.get("seat"), party.get("family") or party.get("model"), party.get("pool"))
    _absorb_sample(samples, _sample_role(party.get("role"), parent_role), pool, agreed)

def _absorb_row(samples, row):
    nested = False
    parent = row.get("role")
    for key in ("seats", "votes", "ballots"):
        items = row.get(key)
        if isinstance(items, list):
            nested = True
            for party in items:
                _absorb_party(samples, parent, party)
    lineup = row.get("lineup")
    if isinstance(lineup, dict):
        nested = True
        for key in ("chair", "builder"):
            _absorb_party(samples, parent, lineup.get(key))
        for party in lineup.get("voters") or []:
            _absorb_party(samples, parent, party)
    if nested:
        return
    agreed = _agreement(row)
    if agreed is None:
        return
    pool = _pool_for(row.get("seat"), row.get("family") or row.get("model"), row.get("pool"))
    _absorb_sample(samples, parent, pool, agreed)

def read_track(paths=None):
    """Map (pool, role) -> (agreement rate, sample count).

    Reads the council runs log and the optional outcomes log. A missing file,
    a blank line, or a bad line is skipped. No file at all returns {}.
    """
    if paths is None:
        paths = outcomes_files()
    samples = {}
    for path in paths:
        if not path:
            continue
        try:
            fh = open(path)
        except FileNotFoundError:
            continue
        except Exception:
            continue
        try:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except Exception:
                    continue
                if not isinstance(row, dict):
                    continue
                _absorb_row(samples, row)
        finally:
            fh.close()
    return {key: (sum(vals) / len(vals), len(vals)) for key, vals in samples.items()}

def _copy_maps(raw, meta, *names):
    for name in names:
        if isinstance(raw.get(name), dict):
            meta[name] = dict(raw[name])

def _empty_pool_tables():
    global POOLS, ROLES, POOL_ORDER, SCORING, PRIORS, BURN_POOLS, FAMILY_VENDOR, _FAMILY_NAME
    POOLS = {}
    ROLES = {}
    POOL_ORDER = ()
    SCORING = {}
    PRIORS = {}
    BURN_POOLS = ()
    FAMILY_VENDOR = {}
    _FAMILY_NAME = {}

def load_config(pools_path=None, priors_path=None):
    """Load pool records and score weights. Disabled pools are not routable.

    Pass paths to point a test at a temporary file. The default config is the
    checkout's config/pools.json, found from this file's real path so a symlink
    install still sees it.
    """
    global POOLS, ROLES, POOL_ORDER, SCORING, PRIORS, BURN_POOLS, BURN_HOURS, BURN_GAP, NEAR_CAP
    global FAMILY_VENDOR, _FAMILY_NAME, ROUTE_FRESH_S, ROUTE_FRESH_PULLED_S
    ROUTE_FRESH_S, ROUTE_FRESH_PULLED_S = (ROUTE_FRESHNESS_DEFAULT_S["live"], ROUTE_FRESHNESS_DEFAULT_S["pulled"])
    path = pools_path or pools_file()
    try:
        fh = open(path)
    except FileNotFoundError:
        if pools_path:
            raise RuntimeError(f"cannot read pool config {path}: FileNotFoundError")
        # A copied script with no checkout beside it still prints usage. Routing
        # has nothing to score until a config file is present.
        _empty_pool_tables()
        return None
    except Exception as e:
        raise RuntimeError(f"cannot read pool config {path}: {e.__class__.__name__}") from e
    try:
        try:
            data = json.load(fh)
        except Exception as e:
            raise RuntimeError(f"cannot read pool config {path}: {e.__class__.__name__}") from e
    finally:
        fh.close()
    if not isinstance(data, dict) or not isinstance(data.get("pools"), dict):
        raise RuntimeError(f"pool config {path} needs a pools object")
    fresh = data.get("route_freshness_s") if isinstance(data.get("route_freshness_s"), dict) else {}
    ok = lambda v: _is_number(v) and v > 0
    if ok(fresh.get("live")):
        ROUTE_FRESH_S = fresh["live"]
    if ok(fresh.get("pulled")):
        ROUTE_FRESH_PULLED_S = fresh["pulled"]
    scoring = data.get("scoring") or {}
    SCORING = dict(scoring)
    BURN_HOURS = scoring.get("lose_it_hours", BURN_HOURS)
    BURN_GAP = scoring.get("lose_it_gap", BURN_GAP)
    NEAR_CAP = scoring.get("near_cap_pct", NEAR_CAP)
    pools = {}
    burn = []
    for pid, raw in data["pools"].items():
        if not isinstance(raw, dict) or raw.get("enabled", True) is False:
            continue
        usage = raw.get("usage") or {}
        if not usage.get("used") or not usage.get("reset"):
            raise RuntimeError(f"pool {pid} needs usage.used and usage.reset")
        window = usage.get("window_key", usage.get("window_s"))
        meta = {
            "seat": raw.get("seat"),
            "used": usage["used"],
            "reset": usage["reset"],
            "window": window,
            "label": raw.get("label") or pid,
            "serves": tuple(raw.get("serves") or ()),
            "only": tuple(raw.get("only") or ()),
            "family": raw.get("family"),
            "models": list(raw.get("models") or []),
            "cost_tier": raw.get("cost_tier", 0),
            "variant": raw.get("variant", "-"),
            "effort": raw.get("effort", "-"),
            "facts": dict(raw.get("facts") or {}),
            "strengths": dict(raw.get("strengths") or {}),
        }
        if raw.get("pace") is False:
            meta["pace"] = False
        if raw.get("lose_it"):
            meta["lose_it"] = True
        if raw.get("near_cap"):
            meta["near_cap"] = True
        if raw.get("burn"):
            meta["burn"] = raw["burn"]
        if raw.get("exhausted"):
            meta["exhausted"] = raw["exhausted"]
        if raw.get("ask_label"):
            meta["ask_label"] = raw["ask_label"]
        if raw.get("blocked_by"):
            meta["blocked_by"] = list(raw["blocked_by"])
        if raw.get("gates"):
            meta["gates"] = list(raw["gates"])
        if raw.get("cohort"):
            meta["cohort"] = raw["cohort"]
        if raw.get("burn_effort"):
            meta["burn_effort"] = raw["burn_effort"]
        _copy_maps(raw, meta, "effort_by_role", "effort_by_pace", "burn_effort_by_role", "family_by_pace")
        pools[pid] = meta
        if meta.get("lose_it"):
            burn.append((meta["seat"], meta.get("burn") or meta["label"], meta["used"], meta["reset"], window))
    roles = {}
    for name, raw in (data.get("roles") or {}).items():
        roles[name] = {
            "seats": tuple(raw.get("seats") or ()),
            "primary": raw.get("primary"),
            "on_unknown": raw.get("on_unknown", "fallthrough"),
            "under_mode": raw.get("under_mode", "suggest"),
            "default": dict(raw.get("default") or {}),
        }
    POOLS = pools
    ROLES = roles
    POOL_ORDER = tuple(pools)
    BURN_POOLS = tuple(burn)
    FAMILY_VENDOR = dict(data.get("vendors") or {})
    _FAMILY_NAME = dict(data.get("family_names") or {})
    if priors_path is None:
        priors_path = priors_file()
    PRIORS = read_priors(priors_path)
    return data

def _strength_for(pid, role, track):
    spec = (POOLS[pid].get("strengths") or {}).get(role)
    if not isinstance(spec, dict):
        return None
    provider = spec.get("provider")
    if isinstance(provider, bool) or not isinstance(provider, (int, float)):
        provider = None
    prior = spec.get("prior")
    if isinstance(prior, bool) or not isinstance(prior, (int, float)):
        prior = None
    external = PRIORS.get(pid) or {}
    if role in external:
        prior = external[role]
    if provider is None and prior is None:
        return None
    seen = track.get((pid, role)) if track else None
    tscore, n = (None, 0) if not seen else seen
    return blend_strength(
        provider, prior, tscore, n,
        SCORING.get("provider_pseudo", 8), SCORING.get("prior_pseudo", 8),
    )

def _ranked(role, track):
    ranked = []
    for index, pid in enumerate(POOL_ORDER):
        fit = _strength_for(pid, role, track)
        if fit is None:
            continue
        ranked.append((fit, index, pid))
    ranked.sort(key=lambda item: (-item[0], item[1]))
    return ranked

def _blockage(pid, states):
    for gate in POOLS[pid].get("blocked_by") or ():
        st, why = states.get(gate, ("unknown", "no reading"))
        if st == "capped":
            return ("capped", gate, why)
        if st == "unknown":
            return ("unknown", gate, why)
    return None

def _cohort_factor(pid, states):
    cohort = POOLS[pid].get("cohort")
    if not cohort:
        return 1.0
    members = [p for p, meta in POOLS.items() if meta.get("cohort") == cohort]
    if len(members) < 2:
        return 1.0
    if all(states.get(p, ("unknown", None))[0] == "ahead" for p in members):
        return SCORING.get("cohort_ahead_factor", 1.0)
    return 1.0

def _burn_effort(meta, role):
    by_role = meta.get("burn_effort_by_role")
    if isinstance(by_role, dict):
        return by_role.get(role)
    return meta.get("burn_effort")

def _family_for(meta, pace):
    return (meta.get("family_by_pace") or {}).get(pace) or meta.get("family")

def _effort_for_score(meta, role, pace, burning):
    if burning:
        burn = _burn_effort(meta, role)
        if burn:
            return burn
    by_pace = (meta.get("effort_by_pace") or {}).get(pace)
    if by_pace:
        return by_pace
    by_role = (meta.get("effort_by_role") or {}).get(role)
    if by_role:
        return by_role
    return meta.get("effort", "-")

def _mode_for(role, meta, family, parts):
    if parts["burning"] and _burn_effort(meta, role):
        return "burn"
    default = ROLES[role]["default"]
    if family != default.get("family"):
        return "suggest"
    pace = parts["pace"]
    if pace == "under":
        return ROLES[role].get("under_mode", "suggest")
    if pace in ("ahead", "near_cap"):
        return "suggest"
    return "default"

_PACE_WORD = {
    "under": "under pace",
    "on": "on pace",
    "ahead": "ahead of pace",
    "open": "open",
    "near_cap": "near hard cap",
}

def _scored_reason(meta, parts):
    if parts["burning"] and parts["lose_it"]:
        head = f"{meta['label']} use-it-or-lose-it"
    else:
        head = f"{meta['label']} {_PACE_WORD.get(parts['pace'], parts['pace'])}"
    return (
        f"{head}: score {parts['total']:.2f} "
        f"(fit {parts['fit']:.2f}, headroom {parts['headroom']:.2f}, "
        f"cost {parts['cost']}, lose-it {parts['lose_it']:.2f})"
    )

def _ask_label(pid):
    meta = POOLS[pid]
    return meta.get("ask_label") or meta["label"]

def _cohort_unknown_ask(role, states, track):
    """Ask when a cohort has a missing reading and nothing in it is ready to spend.

    An ahead or capped sibling does not excuse the missing one, and a fallback
    outside the cohort does not either. A member that is under or on pace still
    wins, in score_route.
    """
    cohorts = {}
    for pid, meta in POOLS.items():
        cohort = meta.get("cohort")
        if not cohort or _strength_for(pid, role, track) is None:
            continue
        cohorts.setdefault(cohort, []).append(pid)
    for members in cohorts.values():
        rows = [(pid, states[pid][0], states[pid][1]) for pid in members]
        if any(st in ("under", "on", "open") for _pid, st, _why in rows):
            continue
        unknown = [(pid, why) for pid, st, why in rows if st == "unknown"]
        if unknown:
            pid, why = unknown[0]
            return _unknown_reason(_ask_label(pid), why)
    return None

def _unknown_reason(label, why):
    why = why or "unknown"
    if why.startswith("reading ") and why.endswith(" old"):
        return f"{label} {why}: {_ASK}"
    return f"{label} reading unknown: {_FIX_ASK}"

def _capped_reason(pid, why):
    reason = f"{_ask_label(pid)} capped: {_ASK}"
    if isinstance(why, str) and why.startswith("resets "):
        reason = f"{reason}, {why}"
    return reason

def _score_parts(pid, role, s, now, states, fit):
    st, _why = states[pid]
    if st in ("unknown", "capped"):
        return None
    if _blockage(pid, states) is not None:
        return None
    headroom = (SCORING.get("headroom") or {}).get(st, 0.9) * _cohort_factor(pid, states)
    burning = _pool_burning(pid, s, now)
    lose = (SCORING.get("lose_it_bonus") or 0) if burning else 0.0
    meta = POOLS[pid]
    cost = meta.get("cost_tier") or 0
    harness = (SCORING.get("harness_penalty") or 0) if meta.get("only") else 0.0
    total = fit * headroom + lose - (SCORING.get("cost_weight") or 0) * cost - harness
    return {
        "fit": fit, "headroom": headroom, "cost": cost, "lose_it": lose,
        "total": total, "pace": st, "burning": burning,
    }

def _hold_unknown(role, s, now, states):
    cfg = ROLES[role]
    if cfg.get("on_unknown") != "hold":
        return None
    primary = cfg.get("primary")
    if primary not in states:
        return None
    st, why = states[primary]
    if st != "unknown":
        return None
    block = _blockage(primary, states)
    if block and block[0] == "capped":
        return None
    label = POOLS[primary]["label"]
    return _row(role, s, now, "default", f"{label}: {why or 'unknown'}")

def _explain_none(ranked, states):
    last = None
    for _fit, _index, pid in ranked:
        st, why = states[pid]
        block = _blockage(pid, states)
        if st == "capped" or (block and block[0] == "capped"):
            # Name the short window when it is what blocked a weekly pool.
            if block and block[0] == "capped" and st != "capped":
                last = (block[1], block[2])
            else:
                last = (pid, why)
            continue
        if st == "unknown":
            return _unknown_reason(_ask_label(pid), why)
        if block and block[0] == "unknown":
            return _unknown_reason(_ask_label(block[1]), block[2])
        last = (pid, why)
    if last:
        return _capped_reason(last[0], last[1])
    return "ask Ryan"

def score_route(role, s, now, states=None):
    """Pick a pool by fit, headroom, cost, and use-it-or-lose-it. No rule table."""
    if states is None:
        states = {pid: pool_status(pid, s, now) for pid in POOLS}
    # Off Max there is no Fable slice, so a Fable role cannot hold on Claude.
    # It falls back as the council's Fable voter does: to the pools off the
    # Claude seat that serve Fable (Other Models). Unknown plan: unchanged.
    off_max = ROLES[role].get("primary") == "fable" and claude_max(s) is False
    held = None if off_max else _hold_unknown(role, s, now, states)
    if held is not None:
        return held
    track = read_track()
    missing = None if off_max else _cohort_unknown_ask(role, states, track)
    if missing:
        return _row(role, s, now, "ask", missing)
    ranked = _ranked(role, track)
    if claude_max(s) is False:  # no slice off Max, whatever the role
        ranked = [r for r in ranked if r[2] != "fable"]
    if off_max:
        frontier = set(_fable_frontier_ids(True))
        ranked = [r for r in ranked if r[2] in frontier]
    best = None
    best_pid = None
    for fit, _index, pid in ranked:
        parts = _score_parts(pid, role, s, now, states, fit)
        if parts is None:
            continue
        if best is None or parts["total"] > best["total"]:
            best = parts
            best_pid = pid
    if best is None:
        return _row(role, s, now, "ask", _explain_none(ranked, states))
    meta = POOLS[best_pid]
    family = _family_for(meta, best["pace"])
    effort = _effort_for_score(meta, role, best["pace"], best["burning"])
    mode = _mode_for(role, meta, family, best)
    row = _row(
        role, s, now, mode, _scored_reason(meta, best),
        seat=meta["seat"], family=family, effort=effort, variant=meta.get("variant", "-"),
    )
    row["reading_age_s"] = _reading_age(best_pid, s, now)
    return row


def _is_number(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)

def _fmt_pct(v):
    n = round(float(v), 1)
    text = f"{n:.1f}"
    return text[:-2] if text.endswith(".0") else text

def _window(meta, s):
    w = meta["window"]
    return s.get(w) if isinstance(w, str) else w

def route_fresh_s(s):
    """How old a reading may be before a route treats it as unknown."""
    return ROUTE_FRESH_PULLED_S if _is_number(s.get("pulled_ts")) else ROUTE_FRESH_S

def pool_status(pool_id, s, now):
    """'unknown' | 'capped' | 'near_cap' | 'open' | 'under' | 'on' | 'ahead', plus why when unknown.

    The Fable slice is near_cap from 95% used until it caps. That band outranks pace.

    unknown when the seat has no as_of, the reading is older than 10 minutes
    (20 on a pulled copy, see route_fresh_s),
    used% is absent or not a number (absent is never 0%), or the reset is
    missing or already past. grok is also capped when grok_exhausted.
    A 5h pool (facts.window 5h) is open when the plan has no session keys, or
    when a used% under 100 has no reset still in the future. At 100% with a
    future reset it is capped. Otherwise it follows pace, and it never burns.
    """
    meta = POOLS[pool_id]
    as_of = s.get("as_of") if isinstance(s.get("as_of"), dict) else {}
    stamp = as_of.get(meta["seat"])
    if not stamp:
        return "unknown", "no reading"
    # A term that ended before the reset leaves nothing to spend. Billing fact,
    # not a usage reading, so its age does not matter.
    reset = s.get(meta["reset"])
    end = effective_end(s, meta["seat"], reset)
    if _is_number(end) and end != reset and end <= now:
        return "capped", "term ended"
    age = now - stamp
    if age > route_fresh_s(s):
        return "unknown", f"reading {int(age // 60)}m old"
    used = s.get(meta["used"])
    short = (meta.get("facts") or {}).get("window") == "5h"
    if not _is_number(used):
        # No 5h keys means this plan has no session window. That must not
        # block the weekly pool the way a failed reading would.
        if short:
            return "open", None
        return "unknown", "no used %"
    if not meta.get("pace", True) and used == 0 and reset is None:
        return "open", None
    # Full with no clock is capped. A clock that already passed, or any
    # reading under 100% with no clock, is an open window, not a failed read.
    if short and used >= 100 and not _is_number(reset):
        return "capped", None
    if short and (not _is_number(reset) or reset <= now):
        return "open", None
    if not _is_number(reset) or reset <= now:
        return "unknown", "reset passed"
    reset = end
    if (meta.get("exhausted") and s.get(meta["exhausted"])) or used >= 100:
        return "capped", None
    for gate in meta.get("gates") or ():
        gused, greset = s.get(gate.get("used")), s.get(gate.get("reset"))
        at = gate.get("at", 100)
        if _is_number(gused) and gused >= at and _is_number(greset) and greset > now:
            return "capped", _reopen(greset, now)
    if meta.get("near_cap") and used >= NEAR_CAP:
        return "near_cap", None
    if not meta.get("pace", True):
        return "open", None
    code = pace_code(used, reset, _window(meta, s), now)
    if not code:
        return "unknown", "no used %"
    return code, None

def _pool_burning(pool_id, s, now):
    meta = POOLS[pool_id]
    # A short window that is ahead or capped is the binding limit. The weekly
    # pool does not burn, and effort stays at its default, while that is true.
    for gate in meta.get("blocked_by") or ():
        if gate not in POOLS:
            continue
        if pool_status(gate, s, now)[0] in ("ahead", "capped"):
            return False
    for e in burn_entries(s, now):
        if e["seat"] == meta["seat"] and e["pool"] == meta.get("burn"):
            return True
    return False

def _reading_age(pool_id, s, now):
    seat = POOLS[pool_id]["seat"]
    as_of = s.get("as_of") if isinstance(s.get("as_of"), dict) else {}
    stamp = as_of.get(seat)
    if not stamp:
        return None
    return now - stamp

def _row(role, s, now, mode, reason, **over):
    base = ROLES[role]["default"]
    out = {"role": role, "seat": base["seat"], "family": base["family"], "effort": base["effort"],
           "variant": base["variant"], "mode": mode, "reason": reason,
           "reading_age_s": _reading_age(ROLES[role]["primary"], s, now)}
    for k in ("seat", "family", "effort", "variant"):
        if k in over:
            out[k] = over[k]
    return out

def _has_room(pool_id, states, s):
    """Known, under the near-cap line, and not capped. Pace does not matter."""
    if states[pool_id][0] not in ("under", "on", "ahead", "open"):
        return False
    used = s.get(POOLS[pool_id]["used"])
    return _is_number(used) and used < NEAR_CAP

def _apply_rule(role, rule, s, now, states):
    """Kept so older callers still resolve. The rule argument is ignored."""
    return score_route(role, s, now, states)

def route(role, s, now):
    """One role's routing row from a SUMMARY-shaped dict.

    Does not read the network. Reads local outcome logs when they exist.
    """
    return score_route(role, s, now)

def format_route(row):
    age = row.get("reading_age_s")
    shown = "unknown" if age is None else f"{int(age // 60)}m"
    return (f"route: {row['role']} | {row['seat']} | {row['family']} | {row['effort']} | "
            f"{row['variant']} | {row['mode']} | {row['reason']} | reading {shown}")

def line_seat(line):
    return line.split("|", 1)[0].strip()

def merge_summary(base, fresh, seats, now=None):
    """Replace seats that succeeded in fresh; drop as_of on a failed reread and keep old numbers."""
    if now is None:
        now = NOW
    out = dict(base)
    out.pop("pulled_ts", None)   # a live reading merged in: no longer a pulled copy
    out["as_of"] = dict(base.get("as_of") or {})
    fresh_as_of = fresh.get("as_of") or {}
    seat_set = list(seats)
    kept_base = set()
    for seat in seat_set:
        if seat in fresh_as_of:
            base_stamp = out["as_of"].get(seat)
            fresh_stamp = fresh_as_of[seat]
            if _is_number(base_stamp) and _is_number(fresh_stamp) and fresh_stamp < base_stamp:
                kept_base.add(seat)
                continue
            for k in SEAT_KEYS[seat]:
                if k in fresh:
                    out[k] = fresh[k]
                else:
                    out.pop(k, None)
            out["as_of"][seat] = fresh_as_of[seat]
        else:
            out["as_of"].pop(seat, None)
            if seat == "grok":
                out["grok_exhausted"] = bool(out.get("grok_exhausted") or fresh.get("grok_exhausted"))
                if "grok_402_h" in fresh:
                    out["grok_402_h"] = fresh["grok_402_h"]
                if "grok_cookie_ok" in fresh:
                    out["grok_cookie_ok"] = fresh["grok_cookie_ok"]
    fresh_lines, old_lines = {}, {}
    for ln in fresh.get("lines") or []:
        fresh_lines.setdefault(line_seat(ln), []).append(ln)
    for ln in base.get("lines") or []:
        old_lines.setdefault(line_seat(ln), []).append(ln)
    merged, seen = [], set()
    for seat in LINE_SEATS:
        seen.add(seat)
        if seat in seat_set and seat in fresh_lines and seat not in kept_base:
            merged.extend(fresh_lines[seat])
        elif seat in old_lines:
            merged.extend(old_lines[seat])
    for seat, lns in old_lines.items():
        if seat not in seen:
            merged.extend(lns)
    out["lines"] = merged
    # Why each failed seat failed, from its own line, so a display can say more
    # than "read failed". A seat that read cleanly this run drops its entry.
    errors = dict(base.get("errors") or {})
    for seat in seat_set:
        if seat in fresh_as_of:
            errors.pop(seat, None)
            continue
        why = [ln.split("|", 1)[1].strip() for ln in fresh_lines.get(seat, []) if "failed" in ln or "no stored" in ln]
        if why:
            errors[seat] = re.sub(r"\s+", " ", why[0])[:120]
    out["errors"] = errors
    out["burn"] = burn_entries(out, now)
    base_ts = base.get("ts")
    out["ts"] = base_ts if _is_number(base_ts) else fresh.get("ts", now)
    out["v"] = 1
    return out

def pull_only():
    """True on a pull-only host: SEAT_USAGE_PULL_ONLY=1, or the marker file exists."""
    if os.environ.get("SEAT_USAGE_PULL_ONLY") == "1":
        return True
    marker = os.environ.get("SEAT_USAGE_PULL_ONLY_FILE") or f"{H}/.config/seat-usage/pull-only"
    return os.path.exists(marker)

def _load_cache():
    try:
        with open(CACHE) as f:
            d = json.load(f)
        if isinstance(d, dict):
            d.setdefault("as_of", {})
            d.setdefault("lines", [])
            return d
    except Exception:
        pass
    return {"ts": 0, "as_of": {}, "v": 1, "lines": []}

LOCK_TIMEOUT = 30

class _LockHandle:
    """Cache lock. owned=False is an inherited descriptor and must not be unlocked."""

    def __init__(self, fh, owned):
        self.fh = fh
        self.owned = owned

def _fd_stat(fd):
    try:
        return os.stat(f"/proc/self/fd/{fd}")
    except OSError:
        return None

def _snapshot_inherited_fds():
    """Identity of every fd open at import.

    The status line runs `( flock -n 9 && seat-usage ) 9>cache/.lock`, so the
    child inherits fd 9 on the same open file description that already holds
    LOCK_EX. Opening .lock again and flocking that new descriptor blocks against
    the parent until the parent exits. A fd this process opens later is a
    different description; recording the startup inode keeps a reused fd number
    from being treated as the parent's lock.
    """
    found = {}
    try:
        names = os.listdir("/proc/self/fd")
    except OSError:
        return found
    for name in names:
        if not name.isdigit():
            continue
        fd = int(name)
        st = _fd_stat(fd)
        if st is not None:
            found[fd] = (st.st_dev, st.st_ino)
    return found

_INHERITED_FDS = _snapshot_inherited_fds()

def _targets_lock(fd, path, path_dev_ino):
    st = _fd_stat(fd)
    if st is not None and path_dev_ino is not None and (st.st_dev, st.st_ino) == path_dev_ino:
        return st
    try:
        if os.path.realpath(os.readlink(f"/proc/self/fd/{fd}")) == os.path.realpath(path):
            return st
    except OSError:
        return None
    return None

def _adopt_inherited_lock(path):
    """Use an inherited fd on the lock file if that description already holds it."""
    try:
        st = os.stat(path)
        path_dev_ino = (st.st_dev, st.st_ino)
    except OSError:
        path_dev_ino = None
    try:
        names = os.listdir("/proc/self/fd")
    except OSError:
        return None
    for name in names:
        if not name.isdigit():
            continue
        fd = int(name)
        ident = _INHERITED_FDS.get(fd)
        if ident is None:
            continue
        st = _targets_lock(fd, path, path_dev_ino)
        if st is None or (st.st_dev, st.st_ino) != ident:
            continue
        try:
            # Succeeds when this open file description already holds LOCK_EX.
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            continue
        return _LockHandle(fd, owned=False)
    return None

def _acquire_lock(timeout):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
    except Exception:
        return None
    path = f"{CACHE_DIR}/.lock"
    inherited = _adopt_inherited_lock(path)
    if inherited is not None:
        return inherited
    try:
        fh = open(path, "a+")
    except Exception:
        return None
    deadline = time.monotonic() + timeout
    while True:
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return _LockHandle(fh, owned=True)
        except OSError:
            if time.monotonic() >= deadline:
                try:
                    fh.close()
                except Exception:
                    pass
                return None
            time.sleep(0.05)

def _release_lock(held):
    if held is None or not held.owned:
        return
    fh = held.fh
    try:
        fcntl.flock(fh, fcntl.LOCK_UN)
    except Exception:
        pass
    try:
        fh.close()
    except Exception:
        pass

def _read_jobs(jobs):
    lines = []
    for fn in jobs:
        try:
            lines += fn() or []
        except Exception as e:
            lines.append(f"{fn.__name__:8} | error {e.__class__.__name__}")
    return lines

def _store_merged(base, lines, seats, now, stamp_now):
    """Merge seat reads into base, write the cache, and stamp mtime to ts."""
    global SUMMARY
    fresh = dict(SUMMARY)
    fresh["as_of"] = dict(SUMMARY.get("as_of") or {})
    fresh["lines"] = lines
    fresh["ts"] = now
    merged = merge_summary(base, fresh, seats, now=now)
    apply_muse(merged, now)
    apply_google(merged, now)
    apply_caps(merged, now)
    if stamp_now:
        merged["ts"] = now
    SUMMARY = merged
    write_cache()
    try:
        os.utime(CACHE, (merged["ts"], merged["ts"]))
    except Exception:
        pass
    return merged

def refresh(seats):
    """Reread the named seats under the status-line lock and merge them into the cache.

    Seats are claude, chatgpt (codex), cursor (also grokbot), grok. Waits up to 30s
    for ~/.cache/seat-usage/.lock; on timeout returns the cache unchanged.
    """
    global SUMMARY
    if pull_only():
        return _load_cache()
    wanted = set(seats)
    lock = _acquire_lock(LOCK_TIMEOUT)
    base = _load_cache()
    if lock is None:
        return base
    try:
        SUMMARY = {"ts": time.time(), "as_of": {}, "v": 1}
        jobs, merge_seats = [], []
        if "claude" in wanted:
            jobs.append(claude)
            merge_seats.append("claude")
        if "chatgpt" in wanted or "codex" in wanted:
            jobs.append(codex)
            merge_seats.append("chatgpt")
        if "cursor" in wanted or "grokbot" in wanted:
            jobs.append(cursor)
            merge_seats.extend(("cursor", "grokbot"))
        if "grok" in wanted:
            jobs.append(grok)
            merge_seats.append("grok")
        lines = _read_jobs(jobs)
        return _store_merged(base, lines, merge_seats, time.time(), stamp_now=False)
    finally:
        _release_lock(lock)

# Vendor is the model provider, not the seat that is billed (Ryan, 2026-10-08).
_VENDOR_NAME = {"xai": "xAI", "anthropic": "Anthropic", "openai": "OpenAI", "meta": "Meta"}
FAMILY_VENDOR = {}
_FAMILY_NAME = {}
load_config()

# Voter effort follows the same burn rule as chair and builder. With no kind,
# the chair's vendor is excluded. Chair and builder are one vendor then, so
# the builder sits out too. With a kind, exclusion follows what is judged:
# nobody for design, the author's vendor for review and mixed, and the named
# author for audit. A capped pool drops the leg. A pool that is ahead of
# pace still votes, at low. A capped Muse window drops it. An unknown
# reading asks.
VOTER_ROSTER = (
    {"family": "fable", "seat": "claude", "pools": ("fable", "claude_week", "claude_5h")},
    {"family": "astra", "seat": "chatgpt", "pools": ("codex",)},
    {"family": "grok", "seat": "grok", "pools": ("grok",)},
    {"family": "wonder-full", "seat": "muse", "pools": ("muse_week", "muse_5h")},
)
# lineup, host, and ask are not in ROLES: `--route` with no role stays the four
# launch roles the hook already prints.
LINEUP_SEATS = ("cursor", "claude", "chatgpt", "grok")
HOST_SEATS = ("grokbot", "claude")


def _with_vendor(row):
    out = dict(row)
    out["vendor"] = FAMILY_VENDOR.get(out.get("family"))
    return out


def _voter_state(spec, states):
    seen = [states[pool][0] for pool in spec["pools"]]
    if "unknown" in seen:
        return "unknown"
    if "capped" in seen:
        return "capped"
    return "open"


def _join_open(a, b):
    """unknown if either reading is unknown, capped if either is capped, else the first state."""
    if a == "unknown" or b == "unknown":
        return "unknown"
    if a == "capped" or b == "capped":
        return "capped"
    return a


def _usage_snapshot(states, s):
    out = {}
    for pid, meta in POOLS.items():
        out[pid] = {"state": states[pid][0], "used_pct": s.get(meta["used"])}
    return out


def _stalest_age(pool_ids, s, now):
    ages = [age for pid in pool_ids if (age := _reading_age(pid, s, now)) is not None]
    if not ages:
        return None
    return max(ages)


def _party(row):
    return {"role": row.get("role"), "seat": row.get("seat"), "family": row.get("family"),
            "vendor": row.get("vendor"), "effort": row.get("effort"), "variant": row.get("variant", "-")}


def _name_list(voters):
    """'A', 'A and B', or 'A, B, and C'."""
    names = [_FAMILY_NAME.get(v["family"], v["family"]) for v in voters]
    if len(names) <= 1:
        return names[0] if names else ""
    if len(names) == 2:
        return f"{names[0]} and {names[1]}"
    return ", ".join(names[:-1]) + ", and " + names[-1]


def _rule_text(chair, builder, voters):
    names = _name_list(voters)
    chair_name = _VENDOR_NAME.get(chair["vendor"], chair["vendor"])
    builder_name = _VENDOR_NAME.get(builder["vendor"], builder["vendor"])
    if chair["vendor"] == builder["vendor"]:
        return f"{chair_name} chairs and builds: {names} vote"
    return f"{chair_name} chairs and {builder_name} builds: {names} vote"


def _snapshot_age(s, now):
    """Age of the oldest pool the usage object includes. None when none are stamped."""
    return _stalest_age(tuple(POOLS), s, now)


def _lineup_ask(s, now, states, reason, alternatives):
    age = _snapshot_age(s, now)
    return {"role": "lineup", "mode": "ask", "reason": reason, "rule": reason, "lineup": None,
            "legal_candidates": [], "alternatives": alternatives,
            "reading_age_s": age, "usage": _usage_snapshot(states, s), "usage_age_s": age}


def _unknown_text(label, why):
    """An aged reading says it is old. A missing stamp or used% is a failed reading."""
    why = why or "unknown"
    if why.startswith("reading ") and why.endswith(" old"):
        return f"{label} {why}: {_ASK}"
    return f"{label} reading unknown: {_FIX_ASK}"


def _reopen(ts, now):
    """When a window reopens, from the caller's clock. No new threshold."""
    if not _is_number(ts) or ts <= now:
        return "reset already passed"
    d = ts - now
    if d < 86400:
        return f"resets in {d / 3600:.1f}h"
    return f"resets in {d / 86400:.1f}d"


def _serving(family):
    return [pid for pid, meta in POOLS.items() if family in meta.get("serves", ())]


def _effort_for(pool_id, s, now, states, default="high"):
    """High, xhigh on an existing burn, low when the pool is ahead of pace.

    near_cap still has a pace (the band only outranks pace in the bounded-question
    rules). Builder and chair pass their own default.
    """
    if _pool_burning(pool_id, s, now):
        return "xhigh", "burn"
    state = states[pool_id][0]
    if state == "near_cap":
        meta = POOLS[pool_id]
        state = pace_code(s.get(meta["used"]), s.get(meta["reset"]), _window(meta, s), now) or state
    if state == "ahead":
        return "low", "suggest"
    return default, "default"


def _spend_first(band, s, now):
    """Burning pools first (soonest reset), then a pool with nothing unique to keep."""
    def key(pid):
        reset = s.get(POOLS[pid]["reset"])
        reset = reset if _is_number(reset) else 0
        unique = 1 if POOLS[pid].get("only") else 0
        if _pool_burning(pid, s, now):
            return (0, reset, unique)
        return (1, unique, 0)
    return sorted(band, key=key)[0]


def _grok_pools(states):
    """'pool' plus a pool id, 'ask' plus unknown ids, 'over', or 'capped'.

    A pool that is under or on pace wins over an unknown sibling. Opus is reached
    only when every Grok pool is known and over pace, or every one is capped.
    One ahead pool with a capped sibling stays on that ahead pool: both are not
    over pace, so Opus does not take over.
    """
    pools = _serving("grok")
    known, unknown = [], []
    for pid in pools:
        state = states[pid][0]
        if state == "unknown":
            unknown.append(pid)
        else:
            known.append((pid, state))
    under = [pid for pid, state in known if state == "under"]
    on = [pid for pid, state in known if state == "on"]
    ahead = [pid for pid, state in known if state == "ahead"]
    if under:
        return "pool", under
    if on:
        return "pool", on
    if ahead and not unknown:
        if len(known) == len(pools) and all(state == "ahead" for _, state in known):
            return "over", None
        return "pool", ahead
    if unknown:
        return "ask", unknown
    return "capped", None


def _ask_row(role, s, now, reason):
    return _row(role, s, now, "ask", reason)


def _grok_reason(pid, state, effort, mode):
    where = "Cursor" if pid == "cursor_models" else "SuperGrok"
    label = POOLS[pid]["label"]
    if mode == "burn":
        return f"Grok on {where}: {label} burn, effort {effort}"
    if state == "ahead":
        return f"Grok on {where}: {label} ahead of pace, effort {effort}"
    if state == "under":
        return f"Grok on {where}: {label} under pace"
    if state == "on":
        return f"Grok on {where}: {label} on pace"
    return f"Grok on {where}: {label} {state}"


def _grok_row(role, pid, s, now, states):
    effort, mode = _effort_for(pid, s, now, states, default="high")
    variant = "fast" if POOLS[pid]["seat"] == "cursor" else "-"
    reason = _grok_reason(pid, states[pid][0], effort, mode)
    row = _row(role, s, now, mode, reason, seat=POOLS[pid]["seat"], family="grok",
               effort=effort, variant=variant)
    row["reading_age_s"] = _reading_age(pid, s, now)
    return row


def _opus_phrase(role, effort):
    if role == "builder" and effort == "low":
        return "Opus at low on Max"
    return f"Opus on Max at {effort}"


def _max_unknown_reason(states):
    labels = (("claude_week", "Max weekly"), ("claude_5h", "Max 5h"))
    parts, failed = [], False
    for pid, label in labels:
        if states[pid][0] != "unknown":
            continue
        why = states[pid][1] or "unknown"
        if why.startswith("reading ") and why.endswith(" old"):
            parts.append(f"{label} {why}")
        else:
            failed = True
            parts.append(f"{label} reading unknown")
    body = "; ".join(parts) or "Max reading unknown"
    return f"{body}: {_FIX_ASK if failed else _ASK}"


def _opus_row(role, s, now, states, prefix):
    """Opus chair at high, Opus builder at low, unless that pool is burning or ahead."""
    state = _join_open(states["claude_week"][0], states["claude_5h"][0])
    if state == "unknown":
        return _ask_row(role, s, now, f"{prefix}: {_max_unknown_reason(states)}")
    if state == "capped":
        return _ask_row(role, s, now, f"{prefix} and Max capped: {_ASK}")
    default = "low" if role == "builder" else "high"
    effort, mode = _effort_for("claude_week", s, now, states, default=default)
    if mode == "default":
        mode = "suggest"
    reason = f"{prefix}: {_opus_phrase(role, effort)}"
    row = _row(role, s, now, mode, reason, seat="claude", family="opus", effort=effort, variant="-")
    row["reading_age_s"] = _reading_age("claude_week", s, now)
    return row


def _xai_worker(role, s, now, states, keep_ahead=False):
    """A Grok chair or builder, an ask row, or None when xAI has no usable pool.

    keep_ahead holds an explicit builder on an ahead pool. The pool can still
    take the work. A capped pool still returns None.
    """
    kind, band = _grok_pools(states)
    if kind == "pool":
        return _grok_row(role, _spend_first(band, s, now), s, now, states)
    if kind == "over" and keep_ahead:
        ahead = [pid for pid in _serving("grok") if states[pid][0] == "ahead"]
        if ahead:
            return _grok_row(role, _spend_first(ahead, s, now), s, now, states)
    if kind == "ask":
        parts, failed = [], False
        for pid in band:
            why = states[pid][1] or "unknown"
            label = POOLS[pid]["label"]
            if why.startswith("reading ") and why.endswith(" old"):
                parts.append(f"{label} {why}")
            else:
                failed = True
                parts.append(f"{label} reading unknown")
        return _ask_row(role, s, now, f"{'; '.join(parts)}: {_FIX_ASK if failed else _ASK}")
    return None


def _route_worker(role, s, now, states=None):
    """Chair and builder use the same scorer as every other role."""
    return score_route(role, s, now, states)


def _constrained_worker(family, role, s, now, states, keep_ahead=False):
    """The caller's family, or None when that family's pool is capped.

    An unknown reading is an ask. A family that is not a capable chair or builder
    is an ask. None means the caller should use the unconstrained route.
    keep_ahead holds a Grok builder whose pools are ahead of pace.
    """
    if family == "grok":
        return _xai_worker(role, s, now, states, keep_ahead=keep_ahead)
    if family == "opus":
        state = _join_open(states["claude_week"][0], states["claude_5h"][0])
        if state == "unknown":
            return _ask_row(role, s, now, _max_unknown_reason(states))
        if state == "capped":
            return None
        return _opus_row(role, s, now, states, "builder family opus")
    return _ask_row(role, s, now, f"builder family {family} is not a capable builder: {_ASK}")


def _resolve_builder(family, s, now, states, keep_ahead=False):
    routed = _route_worker("builder", s, now, states)
    if family is None:
        return routed
    if family not in FAMILY_VENDOR:
        return _ask_row("builder", s, now, f"builder family {family} has no vendor: {_ASK}")
    matched = _constrained_worker(family, "builder", s, now, states, keep_ahead=keep_ahead)
    if matched is not None:
        return matched
    return routed


def _voter_effort(pool_id, s, now, states):
    effort, mode = _effort_for(pool_id, s, now, states, default="high")
    label = POOLS[pool_id]["label"]
    if mode == "burn":
        return effort, mode, f"voter effort {effort} ({label} burn)"
    if effort != "high":
        return effort, "suggest", f"voter effort {effort} ({label} ahead of pace)"
    return effort, "default", "voter effort high"


def _voter(family, seat, pool_id, s, now, effort, mode, reason):
    return {"role": "voter", "seat": seat, "family": family, "vendor": FAMILY_VENDOR[family],
            "effort": effort, "variant": "-", "mode": mode, "reason": reason,
            "reading_age_s": _reading_age(pool_id, s, now)}


def _fable_substitute():
    for pid in _serving("fable"):
        if POOLS[pid]["seat"] != "claude":
            return pid
    return None


def _fable_slice_absent(states, s):
    """A finished non-Max Claude read with no weekly Fable slice.

    The same shape ops-tab calls absent. A missing percent on Max, a missing
    stamp, or a stale stamp stays a failed reading.
    """
    st, why = states["fable"]
    if st != "unknown" or why != "no used %":
        return False
    as_of = s.get("as_of") if isinstance(s.get("as_of"), dict) else {}
    if not as_of.get("claude"):
        return False
    if claude_max(s) is not False:
        return False
    if not _is_number(s.get("claude_week")) or not _is_number(s.get("claude_5h")):
        return False
    return True


def _fable_frontier_ids(absent):
    """The slice, unless it is absent, and every non-Claude pool that serves Fable.

    Weekly and 5h gates serve Fable too. They are not seats.
    """
    ids = []
    for pid, meta in POOLS.items():
        if "fable" not in (meta.get("serves") or ()):
            continue
        if meta.get("seat") == "claude" and pid != "fable":
            continue
        if pid == "fable" and absent:
            continue
        ids.append(pid)
    return ids


# under, then open, then on, then ahead. Open sits above on because its
# headroom already does. A tie keeps the earlier pool in config order.
_PACE_ORDER = {"under": 0, "open": 1, "on": 2, "ahead": 3}


def downgrade_effort(state):
    """An approved downgrade stays between high and max. More headroom is higher."""
    return {"under": "max", "on": "xhigh", "ahead": "high", "open": "xhigh"}.get(state, "high")


def _pick_optimal(ready, states, s):
    def key(pid):
        used = s.get(POOLS[pid]["used"])
        if not _is_number(used):
            used = 101
        order = POOL_ORDER.index(pid) if pid in POOL_ORDER else len(POOL_ORDER)
        return (_PACE_ORDER.get(states[pid][0], 9), used, order)
    return min(ready, key=key)


def _frontier_ready(ids, states, s):
    ready, unknown = [], []
    for pid in ids:
        if pid == "fable":
            block = _blockage(pid, states)
            if block and block[0] == "capped":
                continue
            if block and block[0] == "unknown":
                unknown.append((pid, block[2] or "unknown"))
                continue
        st, why = states[pid]
        if st == "unknown":
            unknown.append((pid, why))
            continue
        if _has_room(pid, states, s):
            ready.append(pid)
    return ready, unknown


def _downgrade_row(pool_id, states, s, now):
    effort = downgrade_effort(states[pool_id][0])
    row = _voter("fable", POOLS[pool_id]["seat"], pool_id, s, now, effort, "suggest",
                 f"downgraded leg effort {effort}")
    row["downgraded"] = True
    return row


def _downgrade_prompt(states, s, now):
    """Known frontier pools, none with room. Not a failed reading."""
    if states["claude_5h"][0] == "capped":
        when = _reopen(s.get("claude_5h_reset_ts"), now)
        return f"claude 5h full, Other Models has no room, {when}: approve a downgraded leg"
    return "no frontier pool with room: approve a downgraded leg"


def _fable_voter(states, s, now, required):
    """Frontier Fable on the optimal pool that has room.

    An absent non-Max slice is not a candidate and not a failed reading.
    When every frontier pool is known and none has room, prompt for a
    downgraded leg and let the other voters be named. A failed reading asks
    before later families are scored. required is unused: a full window is
    not a failed reading.
    """
    watched = ("fable", "claude_week", "claude_5h")
    absent = _fable_slice_absent(states, s)
    if not absent and any(states[pid][0] == "unknown" for pid in watched):
        pid = next(pid for pid in watched if states[pid][0] == "unknown")
        label = "Fable" if pid == "fable" else POOLS[pid]["label"]
        return "ask", _unknown_text(label, states[pid][1])
    ready, unknown = _frontier_ready(_fable_frontier_ids(absent), states, s)
    if ready:
        pid = _pick_optimal(ready, states, s)
        effort, mode, reason = _voter_effort(pid, s, now, states)
        return "row", _voter("fable", POOLS[pid]["seat"], pid, s, now, effort, mode, reason)
    if unknown:
        pid, why = unknown[0]
        label = "Fable" if pid == "fable" else POOLS[pid]["label"]
        return "ask", _unknown_text(label, why)
    approved = s.get("downgrade_approved")
    if isinstance(approved, str) and approved in POOLS:
        return "row", _downgrade_row(approved, states, s, now)
    return "downgrade", {"family": "fable", "reason": _downgrade_prompt(states, s, now)}


def _muse_voter(states, s, now, skip_ahead=True):
    """Muse on the weekly pool, when neither window is capped.

    The lineup passes skip_ahead false: an ahead window still votes, at the
    low effort the weekly pool gives. Ask mode passes true and leaves an
    ahead window out. An unknown reading asks. Meta does not chair, so the
    no-kind rule does not remove this voter. A kind that excludes Meta does.
    """
    watched = ("muse_5h", "muse_week")
    if any(states[pid][0] == "unknown" for pid in watched):
        pid = next(pid for pid in watched if states[pid][0] == "unknown")
        return "ask", _unknown_text(_ask_label(pid), states[pid][1])
    if any(states[pid][0] == "capped" for pid in watched):
        return "skip", None
    if skip_ahead and any(states[pid][0] == "ahead" for pid in watched):
        return "skip", None
    effort, mode, reason = _voter_effort("muse_week", s, now, states)
    return "row", _voter("wonder-full", "muse", "muse_week", s, now, effort, mode, reason)


def _other_voter(family, pool_id, states, s, now, skip_ahead=False):
    state, why = states[pool_id]
    if state == "unknown":
        return "ask", _unknown_text(_FAMILY_NAME.get(family, family), why)
    if state == "capped" or (skip_ahead and state == "ahead"):
        return "skip", None
    effort, mode, reason = _voter_effort(pool_id, s, now, states)
    seat = POOLS[pool_id]["seat"]
    return "row", _voter(family, seat, pool_id, s, now, effort, mode, reason)


def _lineup_mode(chair, builder, voters, weaker):
    modes = {chair.get("mode"), builder.get("mode")}
    modes.update(v.get("mode") for v in voters)
    if "burn" in modes:
        return "burn"
    if weaker or "suggest" in modes:
        return "suggest"
    return "default"


def _collect_voters(states, s, now, excluded_vendor):
    """Voters outside one excluded vendor. None excludes nobody.

    One voter is a degraded lineup. An unknown reading the lineup depends on
    asks. Fable is required when the excluded vendor is xAI: a full 5h window
    with no Other Models room asks and names the reopen.
    """
    excluded = {excluded_vendor} if excluded_vendor else set()
    required = excluded_vendor == "xai"
    voters = []
    downgrade = None
    for spec in VOTER_ROSTER:
        if FAMILY_VENDOR[spec["family"]] in excluded:
            continue
        if spec["family"] == "fable":
            status, payload = _fable_voter(states, s, now, required)
        elif spec["family"] == "grok":
            status, payload = _other_voter("grok", "grok", states, s, now)
        elif spec["family"] == "wonder-full":
            status, payload = _muse_voter(states, s, now, skip_ahead=False)
        else:
            status, payload = _other_voter(spec["family"], spec["pools"][0], states, s, now)
        if status == "ask":
            return "ask", payload
        if status == "downgrade":
            downgrade = payload
            continue
        if status == "row":
            voters.append(payload)
    if not voters and not downgrade:
        return "ask", f"nothing usable left: {_ASK}"
    if downgrade:
        return "downgrade", (voters, downgrade)
    return "ok", voters


LINEUP_KINDS = ("design", "review", "mixed", "audit")


def _kind_rule(kind, excluded_vendor, voters):
    names = _name_list(voters)
    if not excluded_vendor:
        return f"{kind} excludes nobody: {names} vote"
    shown = _VENDOR_NAME.get(excluded_vendor, excluded_vendor)
    return f"{kind} excludes {shown}: {names} vote"


def _lineup_exclusion(kind, author, builder_row):
    """Who sits out, and why. author is a family or None.

    Review and mixed default the author to the builder. Audit does not.
    Design excludes nobody. An unknown author family is an ask.
    """
    if kind == "design":
        if author and author not in FAMILY_VENDOR:
            return {"ask": f"author family {author} has no vendor: {_ASK}"}
        return {"vendor": None, "name": None, "family": None,
                "why": "design judges a packet the chair framed", "author": author}
    if kind in ("review", "mixed"):
        family = author or builder_row.get("family")
    elif kind == "audit":
        if not author:
            return {"vendor": None, "name": None, "family": None,
                    "why": "audit author unknown", "author": None}
        family = author
    else:
        return {"ask": f"unknown kind {kind}: {_ASK}"}
    vendor = FAMILY_VENDOR.get(family)
    if not vendor:
        return {"ask": f"author family {family} has no vendor: {_ASK}"}
    fam_name = _FAMILY_NAME.get(family, family)
    if kind == "audit":
        why = f"{fam_name} wrote it"
    else:
        why = f"{fam_name} built the diff"
    return {"vendor": vendor, "name": _VENDOR_NAME.get(vendor, vendor),
            "family": family, "why": why, "author": family}


def _emit_lineup(s, now, states, chair_row, builder_row, voters, rule):
    weaker = None
    if len(voters) < 2:
        names = _name_list(voters)
        weaker = f"one voter ({names})"
    elif chair_row.get("family") != "grok":
        weaker = chair_row.get("reason")
    elif any(v["family"] == "fable" and v["seat"] != "claude" for v in voters):
        weaker = "Fable on Other Models"
    reason = rule if not weaker else f"{rule}; weaker: {weaker}"
    ages = [chair_row.get("reading_age_s"), builder_row.get("reading_age_s")]
    ages.extend(v.get("reading_age_s") for v in voters)
    known = [age for age in ages if isinstance(age, (int, float)) and not isinstance(age, bool)]
    seated = max(known) if known else None
    lineup = {"chair": chair_row, "builder": builder_row, "voters": voters}
    return {"role": "lineup", "mode": _lineup_mode(chair_row, builder_row, voters, weaker),
            "reason": reason, "rule": rule,
            "lineup": lineup,
            "legal_candidates": [{"chair": _party(chair_row), "builder": _party(builder_row),
                                  "voters": [_party(v) for v in voters], "rule": rule}],
            "alternatives": [], "reading_age_s": seated,
            "usage": _usage_snapshot(states, s), "usage_age_s": _snapshot_age(s, now)}


def route_lineup(s, now, builder=None, kind=None, author=None):
    """One lineup, or ask.

    With no kind, chair and builder come from one vendor and that vendor does
    not vote. Grok while either Grok pool is under or on pace. Opus only when
    both are over pace, or when both are capped. That is the pre-launch call.

    With a kind, the chair is routed on its own and may differ from the builder.
    Design excludes nobody. Review and mixed exclude the author, defaulting to
    the builder. Audit excludes the author when one is named. Fable is required
    when the excluded vendor is xAI.

    A builder family the caller already used is kept when that pool can take it,
    and dropped when the pool is capped. With a kind, an ahead pool can still
    take that family. A voter is dropped only when its pool is capped. Ahead of
    pace still votes, at low. An unknown reading asks. Voter effort follows burn.
    One voter is a weaker lineup, not an ask.
    """
    states = {pid: pool_status(pid, s, now) for pid in POOLS}
    family = None if builder is None else builder.get("family")
    if kind is not None:
        if not isinstance(kind, str):
            return _lineup_ask(s, now, states, f"unknown kind: {_ASK}", [])
        kind = kind.strip().lower()
        if kind not in LINEUP_KINDS:
            return _lineup_ask(s, now, states, f"unknown kind {kind}: {_ASK}", [])
        if isinstance(family, str):
            family = family.strip().lower()
        if isinstance(author, str):
            author = author.strip().lower() or None
        elif author is not None:
            return _lineup_ask(s, now, states, f"author family {author} has no vendor: {_ASK}", [])
    builder_row = _resolve_builder(family, s, now, states, keep_ahead=kind is not None and family is not None)
    if builder_row.get("mode") == "ask":
        return _lineup_ask(s, now, states, builder_row.get("reason") or _ASK, [])
    builder_row = _with_vendor(builder_row)
    if kind is None:
        if builder_row.get("family") == "opus":
            prefix = builder_row["reason"].split(":", 1)[0]
            chair_row = _opus_row("chair", s, now, states, prefix)
        else:
            chair_row = _route_worker("chair", s, now, states)
    else:
        chair_row = _route_worker("chair", s, now, states)
    if chair_row.get("mode") == "ask":
        return _lineup_ask(s, now, states, chair_row.get("reason") or _ASK, [])
    chair_row = _with_vendor(chair_row)
    if kind is None and chair_row.get("vendor") != builder_row.get("vendor"):
        return _lineup_ask(s, now, states, "chair and builder vendors differ: " + _ASK, [])

    if kind is None:
        excluded_vendor = chair_row["vendor"]
        excl = None
    else:
        excl = _lineup_exclusion(kind, author, builder_row)
        if excl.get("ask"):
            return _lineup_ask(s, now, states, excl["ask"], [])
        excluded_vendor = excl["vendor"]

    status, payload = _collect_voters(states, s, now, excluded_vendor)
    if status == "ask":
        return _lineup_ask(s, now, states, payload, [])
    downgrade = None
    if status == "downgrade":
        voters, downgrade = payload
    else:
        voters = payload
    if kind is None:
        rule = _rule_text(chair_row, builder_row, voters)
    else:
        rule = _kind_rule(kind, excluded_vendor, voters)
    row = _emit_lineup(s, now, states, chair_row, builder_row, voters, rule)
    if excl is not None:
        row["kind"] = kind
        row["author"] = excl["author"]
        row["excluded"] = {"vendor": excl["vendor"], "name": excl["name"],
                           "family": excl["family"], "why": excl["why"]}
    if downgrade:
        row["downgrade"] = downgrade
    return row


def _host_entry(id_, seat, family, effort, state, used, age, binding, windows):
    return {"id": id_, "seat": seat, "family": family, "effort": effort, "state": state,
            "available": state not in ("unknown", "capped"), "used_pct": used,
            "binding": binding, "windows": windows, "reading_age_s": age}


def _host_unknown(label, why):
    return _unknown_text(label, why)


def _host_windows(pool_ids, s):
    return {pid: s.get(POOLS[pid]["used"]) for pid in pool_ids}


def _host_binding(pool_id, states):
    """Worst of this pool and the pools that block it.

    capped outranks ahead, and either outranks under, on, or open. used_pct
    follows the pool whose state won. An unknown reading stays unknown.
    """
    ids = [pool_id] + [gate for gate in (POOLS[pool_id].get("blocked_by") or []) if gate in states]
    if any(states[i][0] == "unknown" for i in ids):
        return "unknown", pool_id
    for rank in ("capped", "ahead"):
        for i in ids:
            if states[i][0] == rank:
                return rank, i
    return states[pool_id][0], pool_id


_HOST_NAME = {"grokbot": "Bot", "claude_week": "Max", "claude_5h": "Max 5h"}


def _host_phrase(pool_id, state):
    """Ask vocabulary. A short window says full; a long one says capped."""
    name = _HOST_NAME.get(pool_id) or POOLS[pool_id].get("ask_label") or POOLS[pool_id]["label"]
    if state == "ahead":
        return f"{name} over pace"
    if state == "capped" and (POOLS[pool_id].get("facts") or {}).get("window") == "5h":
        return f"{name} full"
    if state == "capped":
        return f"{name} capped"
    return ""


def _host_burn_reason(pool_id):
    if pool_id == "claude_week":
        return "weekly all-models pool burning"
    if pool_id == "grokbot":
        return "bot week pool burning"
    burn = POOLS[pool_id].get("burn") or POOLS[pool_id]["label"]
    return f"{burn} pool burning"


def _host_lean(s, now, states):
    """Cursor Models, then SuperGrok. SuperGrok first only when it would expire unused."""
    order = ["grok", "cursor_models"] if _pool_burning("grok", s, now) else ["cursor_models", "grok"]
    lean = []
    for pid in order:
        if pid not in states or states[pid][0] in ("capped", "unknown"):
            continue
        lean.append(pid)
    return lean


def route_host(s, now):
    """Suggest where to start a host session. Does not select one.

    Capable order is Grok Bot, then Opus on Max. A burning pool is spent first,
    unless its short window is ahead or capped: that window is binding, Max
    leaves the ready list, and effort stays at the default. The reason names
    no host, no effort, and contains no parentheses. The page adds one pair.
    Both ahead: suggest the Bot. An aged Bot reading says the reading is old.
    A missing reading says the read failed.
    """
    states = {pid: pool_status(pid, s, now) for pid in POOLS}
    bot_state, bot_why = states["grokbot"]
    opus_state, opus_binding = _host_binding("claude_week", states)
    opus_effort, _opus_mode = _effort_for("claude_week", s, now, states, default="high")
    bot_windows = _host_windows(["grokbot"], s)
    opus_windows = _host_windows(["claude_week", "claude_5h"], s)
    bot = _host_entry("grokbot", "grokbot", "grokbot", "-", bot_state, bot_windows.get("grokbot"),
                      _reading_age("grokbot", s, now), "grokbot", bot_windows)
    opus = _host_entry(
        "opus", "claude", "opus", opus_effort, opus_state, opus_windows.get(opus_binding),
        _reading_age("claude_week", s, now), opus_binding, opus_windows)
    lean = _host_lean(s, now, states)

    def finish(mode, suggestion, reason, top):
        return {"role": "host", "seat": top["seat"], "family": top["family"], "effort": top["effort"],
                "variant": "-", "mode": mode, "reason": reason, "reading_age_s": top["reading_age_s"],
                "suggestion": suggestion, "selects": False, "lean": lean, "hosts": [bot, opus]}

    if bot_state == "unknown":
        return finish("ask", None, _host_unknown("Grok Bot", bot_why), bot)
    ready = []
    if bot["available"] and bot_state != "ahead":
        ready.append(("grokbot", bot, "grokbot"))
    if opus["available"] and opus_state != "ahead":
        ready.append(("opus", opus, "claude_week"))
    if ready:
        def key(item):
            _id, _entry, pool = item
            reset = s.get(POOLS[pool]["reset"])
            reset = reset if _is_number(reset) else 0
            order = 0 if _id == "grokbot" else 1
            if _pool_burning(pool, s, now):
                return (0, reset, order)
            return (1, order, 0)
        _id, top, pool = sorted(ready, key=key)[0]
        if _pool_burning(pool, s, now):
            mode, reason = "burn", _host_burn_reason(pool)
        elif _id == "opus" and bot_state == "capped":
            mode, reason = "suggest", "Bot capped"
        elif _id == "opus" and bot_state == "ahead":
            mode, reason = "suggest", "Bot over pace"
        else:
            mode, reason = "suggest", ""
        return finish(mode, _id, reason, top)
    if bot_state == "ahead" and opus_state == "ahead":
        return finish("suggest", "grokbot", "both over pace", bot)
    # A failed Max read must not hide a Bot that can still take the session.
    if opus_state == "unknown" and bot["available"]:
        reason = "over pace" if bot_state == "ahead" else ""
        return finish("suggest", "grokbot", reason, bot)
    if opus_state == "unknown":
        return finish("ask", None, _max_unknown_reason(states), bot)
    parts = [p for p in (_host_phrase("grokbot", bot_state), _host_phrase(opus_binding, opus_state)) if p]
    return finish("ask", None, ", ".join(parts) if parts else "no open host", bot)


def _ask_headroom(state):
    return (SCORING.get("headroom") or {}).get(state, 0.9)


def _ask_one(spec, states, s, now):
    """One seatable ask voter and the pool whose pace ranks it, or None.

    Unknown and capped families are left out. The route still returns the
    others. Muse is left out when either window is over pace. Grok is not:
    an ahead Grok pool ranks lower and can still answer a question.
    """
    family = spec["family"]
    if family == "fable":
        status, payload = _fable_voter(states, s, now, required=False)
        if status != "row" or payload.get("downgraded"):
            return None
        pool = "fable" if payload["seat"] == "claude" else "cursor_other"
    elif family == "grok":
        status, payload = _other_voter("grok", "grok", states, s, now, skip_ahead=False)
        pool = "grok"
    elif family == "wonder-full":
        status, payload = _muse_voter(states, s, now, skip_ahead=True)
        pool = "muse_week"
    else:
        pool = spec["pools"][0]
        status, payload = _other_voter(family, pool, states, s, now, skip_ahead=False)
    if status != "row":
        return None
    state = states[pool][0]
    used = s.get(POOLS[pool]["used"])
    used = used if _is_number(used) else 101
    row = dict(payload)
    row["pace"] = state
    return _ask_headroom(state), used, row


def route_ask(s, now):
    """Two voters on two vendors, the ones with the most headroom.

    No vendor is excluded: a question is not a review of the chair's work.
    Each row carries family, effort, and pace. effort is the burn rule
    (high, xhigh on a burn, low when ahead). pace is the band that effort
    came from, so a caller can step a separate lean without applying burn twice.
    """
    states = {pid: pool_status(pid, s, now) for pid in POOLS}
    ranked = []
    for index, spec in enumerate(VOTER_ROSTER):
        got = _ask_one(spec, states, s, now)
        if got is None:
            continue
        headroom, used, row = got
        ranked.append((headroom, used, index, row))
    ranked.sort(key=lambda item: (-item[0], item[1], item[2]))
    picked = []
    seen = set()
    for _headroom, _used, _index, row in ranked:
        if row["vendor"] in seen:
            continue
        picked.append(row)
        seen.add(row["vendor"])
        if len(picked) == 2:
            break
    candidates = [item[3] for item in ranked]
    age = _snapshot_age(s, now)
    if not picked:
        return {"role": "ask", "mode": "ask", "reason": f"nothing usable left: {_ASK}",
                "voters": [], "candidates": [], "reading_age_s": age,
                "usage": _usage_snapshot(states, s), "usage_age_s": age}
    mode = "default"
    if any(v.get("mode") == "burn" for v in picked):
        mode = "burn"
    elif len(picked) < 2 or any(v.get("mode") == "suggest" for v in picked):
        mode = "suggest"
    reason = f"{_name_list(picked)} by headroom"
    if len(picked) < 2:
        reason = f"{reason}; one voter"
    ages = [v.get("reading_age_s") for v in picked]
    known = [item for item in ages if isinstance(item, (int, float)) and not isinstance(item, bool)]
    seated = max(known) if known else None
    return {"role": "ask", "mode": mode, "reason": reason, "voters": picked, "candidates": candidates,
            "reading_age_s": seated, "usage": _usage_snapshot(states, s), "usage_age_s": age}


def format_ask(row):
    age = row.get("reading_age_s")
    shown = "unknown" if age is None else f"{int(age // 60)}m"
    if row.get("mode") == "ask" or not row.get("voters"):
        return f"route: ask | - | - | - | - | ask | {row.get('reason')} | reading {shown}"
    lines = [f"route: ask | {row['mode']} | {row.get('reason')} | reading {shown}"]
    for voter in row["voters"]:
        lines.append(f"  voter: {voter['seat']} | {voter['family']} | {voter['effort']} | "
                     f"{voter.get('pace', '-')} | {voter['vendor']}")
    return "\n".join(lines)


def format_lineup(row):
    age = row.get("reading_age_s")
    shown = "unknown" if age is None else f"{int(age // 60)}m"
    if row.get("mode") == "ask" or not row.get("lineup"):
        return (f"route: lineup | - | - | - | - | ask | {row.get('reason')} | reading {shown}")
    lines = [f"route: lineup | {row['mode']} | {row.get('rule')} | reading {shown}"]
    for key in ("chair", "builder"):
        party = row["lineup"][key]
        lines.append(f"  {key}: {party['seat']} | {party['family']} | {party['effort']} | "
                     f"{party['variant']} | {party['vendor']}")
    for voter in row["lineup"]["voters"]:
        lines.append(f"  voter: {voter['seat']} | {voter['family']} | {voter['effort']} | "
                     f"{voter['variant']} | {voter['vendor']}")
    excl = row.get("excluded")
    if isinstance(excl, dict):
        if excl.get("vendor"):
            lines.append(f"  excluded: {excl.get('name') or excl['vendor']} | "
                         f"{excl.get('family') or '-'} | {excl.get('why') or ''}")
        else:
            lines.append(f"  excluded: none | {excl.get('why') or ''}")
    down = row.get("downgrade")
    if isinstance(down, dict) and down.get("reason"):
        lines.append(f"  downgrade: {down.get('family') or '-'} | {down['reason']}")
    return "\n".join(lines)


def format_host(row):
    lines = [format_route(row)]
    for host in row.get("hosts") or []:
        flag = "available" if host.get("available") else host.get("state")
        lines.append(f"  host: {host['seat']} | {host['family']} | {host['effort']} | "
                     f"{host['state']} | {flag}")
    return "\n".join(lines)


def _opt(argv, name):
    if name not in argv:
        return None
    i = argv.index(name)
    if i + 1 >= len(argv) or argv[i + 1].startswith("-"):
        print(f"{name} needs a value", file=sys.stderr)
        raise SystemExit(2)
    return argv[i + 1]


def cmd_route():
    argv = sys.argv[1:]
    as_json = "--json" in argv
    cached = "--cached" in argv or pull_only()
    # A bare --route, or --route followed by a flag, routes every launch role.
    # Do not call _opt first: a missing value used to exit 2, and the launch
    # hook treats that as silence.
    role = None
    if "--route" in argv:
        i = argv.index("--route")
        if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            role = argv[i + 1]
    if role == "voter":
        print("voters do not route", file=sys.stderr)
        raise SystemExit(2)
    known = list(ROLES) + ["lineup", "host", "ask"]
    if role is not None and role not in known:
        print(f"unknown role {role}; roles: {', '.join(known)}", file=sys.stderr)
        raise SystemExit(2)
    builder = None
    kind = None
    author = None
    if "--kind" in argv or "--author" in argv:
        if role != "lineup":
            print("--kind and --author apply to lineup", file=sys.stderr)
            raise SystemExit(2)
        if "--kind" in argv:
            kind = _opt(argv, "--kind").strip().lower()
            if kind not in LINEUP_KINDS:
                print(f"unknown kind {kind}; kinds: {', '.join(LINEUP_KINDS)}", file=sys.stderr)
                raise SystemExit(2)
        if "--author" in argv:
            if kind is None:
                print("--author needs --kind", file=sys.stderr)
                raise SystemExit(2)
            author = _opt(argv, "--author").strip().lower()
    if role == "lineup" and "--builder-family" in argv:
        # Family only. Seat and effort are resolved once the summary is loaded.
        builder = {"role": "builder", "family": _opt(argv, "--builder-family")}
    if cached:
        summary = _load_cache()
        if pull_only():
            # stderr only: stdout (text and --json) stays the parsed route.
            ts = summary.get("ts") or 0
            age = f"{round((time.time() - ts) / 60)}m ago" if ts else "age unknown"
            print(f"[seat-usage] pull-only cached {age}", file=sys.stderr)
    elif role == "lineup":
        summary = refresh(list(LINEUP_SEATS))
    elif role == "host":
        summary = refresh(list(HOST_SEATS))
    elif role == "ask":
        summary = refresh(list(LINEUP_SEATS))
    else:
        chosen = tuple(ROLES) if role is None else (role,)
        seats = []
        for name in chosen:
            for seat in ROLES[name]["seats"]:
                if seat not in seats:
                    seats.append(seat)
        summary = refresh(seats)
    now = time.time()
    if role == "lineup":
        rows = [route_lineup(summary, now, builder=builder, kind=kind, author=author)]
    elif role == "host":
        rows = [route_host(summary, now)]
    elif role == "ask":
        rows = [route_ask(summary, now)]
    else:
        chosen = tuple(ROLES) if role is None else (role,)
        rows = [route(name, summary, now) for name in chosen]
    # A cached poll must not append the ask log, the usage history, or the cache.
    if not cached:
        log_asks(rows, summary, now)
    if as_json:
        json.dump(rows, sys.stdout)
        sys.stdout.write("\n")
    else:
        for row in rows:
            if row.get("role") == "lineup":
                print(format_lineup(row))
            elif row.get("role") == "host":
                print(format_host(row))
            elif row.get("role") == "ask":
                print(format_ask(row))
            else:
                print(format_route(row))

def log_asks(rows, s, now):
    """Append one line per row the router could not settle. Write failures are silent."""
    asked = [r for r in rows if r["mode"] == "ask" or r["reason"].endswith("no rule")]
    if not asked:
        return
    pools = {pid: [pool_status(pid, s, now)[0], s.get(meta["used"])] for pid, meta in POOLS.items()}
    try:
        os.makedirs(os.path.dirname(ASKS), exist_ok=True)
        with open(ASKS, "a") as f:
            for r in asked:
                f.write(json.dumps({"ts": now, "host": socket.gethostname(), "row": r, "pools": pools}) + "\n")
    except Exception:
        pass

# Cap projection. Burn rate is linear from the window's start: used % divided
# by the time elapsed since the window opened (window length minus time left).
# At that rate the pool reaches 100% after (100 - used) / rate more seconds;
# when that is before the reset, <pool>_caps_early_s is how many seconds
# early. No key means no projection: no reading, 0% used, already at 100%,
# the reset passed or is further off than one window, the window is unknown,
# or less than CAPS_MIN_ELAPSED of the window has passed (one large job at
# the start of a window projects a cap that is not real).
CAPS_MIN_ELAPSED = 0.10
_GOOGLE_CAPS = tuple((f"google_{p}_{w}", f"google_{p}_{w}_reset_ts", secs)
                     for p, ws in (("argon", ("week",)), ("gemini", ("week", "5h")), ("claudegpt", ("week", "5h")))
                     for w, secs in ((w, 7 * 86400 if w == "week" else 5 * 3600) for w in ws))

def caps_early_s(used, reset, window, now):
    """Seconds before the reset that a linear burn from the window's start hits 100%, or None."""
    if not (_is_number(used) and _is_number(reset) and _is_number(window)) or window <= 0:
        return None
    left = reset - now
    if left <= 0 or left > window:
        return None
    elapsed = window - left
    if elapsed < CAPS_MIN_ELAPSED * window or used <= 0 or used >= 100:
        return None
    cap_in = (100 - used) * elapsed / used
    early = round(left - cap_in)
    return early if early > 0 else None

def caps_sources():
    """(key prefix, used key, reset key, window seconds or window key, as_of seat) per projected pool."""
    out = [(pid, meta["used"], meta["reset"], meta["window"], meta["seat"]) for pid, meta in POOLS.items()]
    return out + [(used, used, reset, secs, "google") for used, reset, secs in _GOOGLE_CAPS]

def apply_caps(summary, now):
    """Project each pool at its own reading's time (as_of), so a carried-over
    reading keeps the projection it had rather than one diluted by time that
    saw no new reading. A reset already past drops the key."""
    for k in [k for k in summary if k.endswith("_caps_early_s")]:
        del summary[k]
    as_of = summary.get("as_of") if isinstance(summary.get("as_of"), dict) else {}
    for name, used, reset, window, seat in caps_sources():
        win = summary.get(window) if isinstance(window, str) else window
        at = as_of.get(seat) if _is_number(as_of.get(seat)) else now
        rts = summary.get(reset)
        if not _is_number(rts) or rts <= now:
            continue
        early = caps_early_s(summary.get(used), rts, win, min(at, now))
        if early is not None:
            summary[f"{name}_caps_early_s"] = early

def write_cache():
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = CACHE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(SUMMARY, f)
        os.replace(tmp, CACHE)
    except Exception:
        pass

# Conclave's cache. Copied into the seat cache. The muse_5h and muse_week pools
# read those fields. Model names stay in the file, if Conclave sends them; the
# router never sees this.
# resets_at is an ISO string or a unix time, whichever the API sent.
def muse_usage_path():
    return os.path.join(os.path.expanduser("~"), ".cache", "quartermaster", "muse-usage.json")

def _muse_number(v):
    return _is_number(v) and v == v and v != float("inf") and v != float("-inf")

def _muse_epoch(value):
    if _is_number(value):
        try:
            return float(value)
        except (OverflowError, ValueError):
            return None
    if not isinstance(value, str) or not value.strip():
        return None
    try:
        return iso_to_ts(value.strip())
    except (ValueError, TypeError, OSError, OverflowError):
        return None

def _muse_snapshot(data):
    """Parsed percents and epochs, or None when the shape does not match."""
    if not isinstance(data, dict):
        return None
    window, weekly = data.get("window"), data.get("weekly")
    if not isinstance(window, dict) or not isinstance(weekly, dict):
        return None
    captured = _muse_epoch(data.get("captured_at"))
    window_reset = _muse_epoch(window.get("resets_at"))
    weekly_reset = _muse_epoch(weekly.get("resets_at"))
    current, weekly_pct = window.get("used_percent"), weekly.get("used_percent")
    minutes = window.get("window_duration_mins")
    if captured is None or window_reset is None or weekly_reset is None:
        return None
    if not _muse_number(current) or not _muse_number(weekly_pct) or not _muse_number(minutes) or minutes < 0:
        return None
    return {
        "captured": captured,
        "window_reset": window_reset,
        "weekly_reset": weekly_reset,
        "current": current,
        "weekly": weekly_pct,
    }

def _muse_local(ts):
    """Clock time in the machine's zone. None when the timestamp cannot be shown."""
    try:
        dt = datetime.fromtimestamp(ts).astimezone()
    except (OverflowError, OSError, ValueError):
        return None
    zone = dt.tzname() or dt.strftime("%z")
    clock = dt.strftime("%Y-%m-%d %H:%M")
    return f"{clock} {zone}" if zone else clock

def format_muse_line(data, now):
    """One Muse line from Conclave's object, or None when the shape does not match.

    {captured_at, window{used_percent, window_duration_mins, resets_at},
     weekly{used_percent, resets_at}}. Times are local. A reset is an ISO
    string or a unix time. Stale once the captured window's resets_at is no
    longer in the future.
    """
    snap = _muse_snapshot(data)
    if snap is None:
        return None
    captured, window_reset, weekly_reset = snap["captured"], snap["window_reset"], snap["weekly_reset"]
    current, weekly_pct = snap["current"], snap["weekly"]
    captured_s, window_s, weekly_s = _muse_local(captured), _muse_local(window_reset), _muse_local(weekly_reset)
    if not captured_s or not window_s or not weekly_s:
        return None
    line = (f"{'muse':9}| Current {_fmt_pct(current)}% (resets {window_s})"
            f" | Weekly {_fmt_pct(weekly_pct)}% (resets {weekly_s}) | as of {captured_s}")
    if window_reset <= now:
        line += " | stale (window reset)"
    return line

def muse_line(now=None, path=None):
    """Read-only Muse line. Missing or unparseable input says 'no data yet'."""
    if now is None:
        now = time.time()
    if path is None:
        path = muse_usage_path()
    try:
        with open(path) as f:
            data = json.load(f)
        line = format_muse_line(data, now)
    except Exception:
        return f"{'muse':9}| no data yet"
    return line or f"{'muse':9}| no data yet"

# A status-line refresh is every 10 minutes. Ask Muse on that same cadence.
MUSE_REFRESH_S = 540
# A 5h window whose reset is this far before the snapshot was taken is not
# the current window. The test sample that landed in the live file is a year off.
MUSE_RESET_SKEW_S = 6 * 60 * 60

def muse_reading_is_current(data, now):
    """True when the file is a recent snapshot of a plausible 5h window."""
    snap = _muse_snapshot(data)
    if snap is None:
        return False
    if now - snap["captured"] >= MUSE_REFRESH_S:
        return False
    if snap["window_reset"] < snap["captured"] - MUSE_RESET_SKEW_S:
        return False
    return True

def _muse_ms(value):
    """Epoch seconds. Muse's protocol sends milliseconds."""
    if not _muse_number(value):
        return None
    value = float(value)
    if value > 1_000_000_000_000:
        value = value / 1000.0
    return value

def muse_document_from_protocol(usage):
    """The cache file shape, or None when the protocol object is incomplete."""
    if not isinstance(usage, dict):
        return None
    window, weekly = usage.get("window"), usage.get("weekly")
    if not isinstance(window, dict) or not isinstance(weekly, dict):
        return None
    captured = _muse_ms(usage.get("observedAtMs"))
    window_reset = _muse_ms(window.get("resetsAtMs"))
    weekly_reset = _muse_ms(weekly.get("resetsAtMs"))
    current, weekly_pct = window.get("usedPercent"), weekly.get("usedPercent")
    minutes = window.get("windowDurationMins")
    if None in (captured, window_reset, weekly_reset):
        return None
    if not _muse_number(current) or not _muse_number(weekly_pct) or not _muse_number(minutes) or minutes <= 0:
        return None
    return {
        "captured_at": datetime.fromtimestamp(captured, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "window": {
            "used_percent": current,
            "window_duration_mins": minutes,
            "resets_at": window_reset,
        },
        "weekly": {
            "used_percent": weekly_pct,
            "resets_at": weekly_reset,
        },
    }

def _write_muse_file(path, doc):
    parent = os.path.dirname(path) or "."
    os.makedirs(parent, exist_ok=True)
    tmp = os.path.join(parent, f".{os.path.basename(path)}.{os.getpid()}.tmp")
    with open(tmp, "w", encoding="utf-8") as handle:
        json.dump(doc, handle, indent=2)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(tmp, path)

def _uuid7():
    """UUIDv7. The system Python here is 3.10, which has no uuid.uuid7."""
    ms = int(time.time() * 1000) & ((1 << 48) - 1)
    rand = int.from_bytes(os.urandom(10), "big")
    value = (ms << 80) | (0x7 << 76) | ((rand & 0xFFF) << 64) | (0b10 << 62) | ((rand >> 12) & ((1 << 62) - 1))
    text = f"{value:032x}"
    return f"{text[:8]}-{text[8:12]}-{text[12:16]}-{text[16:20]}-{text[20:]}"

def _msp_send(proc, obj):
    proc.stdin.write((json.dumps(obj) + "\n").encode())
    proc.stdin.flush()

def _msp_read(proc, buf, deadline):
    """One JSON line from a Muse host, or None when time runs out."""
    while time.time() < deadline:
        if b"\n" in buf[0]:
            line, rest = buf[0].split(b"\n", 1)
            buf[0] = rest
            if line.strip():
                try:
                    return json.loads(line)
                except json.JSONDecodeError:
                    continue
            continue
        if proc.poll() is not None:
            return None
        import select
        ready, _, _ = select.select([proc.stdout], [], [], 0.3)
        if not ready:
            continue
        chunk = os.read(proc.stdout.fileno(), 65536)
        if not chunk:
            return None
        buf[0] += chunk
    return None

def _muse_protocol_usage(binary, timeout):
    """Last subscription usage from a short Muse host, or None.

    A new host has nothing stored. usage/read is empty until a reply arrives,
    so an empty read is followed by one one-word turn. The host is closed
    either way.
    """
    proc = subprocess.Popen(
        [binary, "serve", "--provider", "meta", "--no-session-log", "--disable-shell", "--disable-write"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
        cwd="/tmp", start_new_session=True,
    )
    buf = [b""]
    deadline = time.time() + timeout
    usage = None
    try:
        _msp_send(proc, {"jsonrpc": "2.0", "id": 1, "method": "initialize",
                         "params": {"clientInfo": {"name": "seat_usage", "version": "0"}}})
        init = None
        while time.time() < deadline and init is None:
            msg = _msp_read(proc, buf, deadline)
            if msg is None:
                break
            if msg.get("id") == 1:
                init = msg
        if not init or "result" not in init:
            return None
        _msp_send(proc, {"jsonrpc": "2.0", "method": "initialized"})
        _msp_send(proc, {"jsonrpc": "2.0", "id": 2, "method": "usage/read", "params": {}})
        while time.time() < deadline and usage is None:
            msg = _msp_read(proc, buf, deadline)
            if msg is None:
                break
            if msg.get("method") == "usage/changed":
                usage = msg.get("params")
                break
            if msg.get("id") != 2:
                continue
            if "error" in msg:
                return None
            found = (msg.get("result") or {}).get("usage")
            if found:
                usage = found
                break
            _msp_send(proc, {"jsonrpc": "2.0", "id": 3, "method": "session/start", "params": {
                "commandId": _uuid7(),
                "workspaceRoot": "/tmp",
                "approvalMode": "denyUnmatched",
            }})
            session_id = None
            while time.time() < deadline and session_id is None and usage is None:
                msg = _msp_read(proc, buf, deadline)
                if msg is None:
                    break
                if msg.get("method") == "usage/changed":
                    usage = msg.get("params")
                    break
                if msg.get("id") != 3:
                    continue
                if "error" in msg:
                    return None
                session_id = ((msg.get("result") or {}).get("session") or {}).get("sessionId")
            if usage is not None or not session_id:
                break
            _msp_send(proc, {"jsonrpc": "2.0", "id": 4, "method": "turn/start", "params": {
                "commandId": _uuid7(),
                "sessionId": session_id,
                "reasoningEffort": "none",
                "input": [{"type": "text", "text": "Reply with the single word ok."}],
            }})
            while time.time() < deadline and usage is None:
                msg = _msp_read(proc, buf, deadline)
                if msg is None:
                    break
                if msg.get("method") == "usage/changed":
                    usage = msg.get("params")
                    break
                if msg.get("id") == 4 and "error" in msg:
                    return None
        return usage
    finally:
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except Exception:
                proc.kill()
        try:
            proc.wait(timeout=2)
        except Exception:
            proc.kill()

def refresh_muse_usage(now=None, path=None, binary=None, timeout=40):
    """Write a live Muse snapshot when the file is old or not a current window.

    Returns True when a new file was written. A current file, a missing muse
    binary, or a failed ask leaves the file as it was and returns False.
    A pull-only host never asks.
    """
    if pull_only():
        return False
    if now is None:
        now = time.time()
    if path is None:
        path = muse_usage_path()
    try:
        with open(path) as handle:
            current = json.load(handle)
    except Exception:
        current = None
    if muse_reading_is_current(current, now):
        return False
    binary = binary or os.environ.get("SEAT_USAGE_MUSE") or shutil.which("muse")
    if not binary:
        return False
    try:
        usage = _muse_protocol_usage(binary, timeout)
    except Exception:
        return False
    doc = muse_document_from_protocol(usage)
    if doc is None:
        return False
    _write_muse_file(path, doc)
    return True

def apply_muse(summary, now, path=None):
    """Copy a parsed Muse snapshot into summary.

    The muse_5h and muse_week pools read these fields. A launch role does not:
    Muse has no chair or builder strength.

    A 5h window whose reset has passed is still stored. The printed line says
    so. A missing file or a shape that does not match drops as_of["muse"],
    records errors["muse"], and leaves numbers already in summary alone.
    """
    if not isinstance(summary, dict):
        return summary
    if path is None:
        path = muse_usage_path()
    as_of = dict(summary.get("as_of") or {})
    errors = dict(summary.get("errors") or {})
    snap = None
    try:
        with open(path) as f:
            snap = _muse_snapshot(json.load(f))
    except Exception:
        snap = None
    if snap is not None:
        summary["muse_5h"] = snap["current"]
        summary["muse_5h_reset_ts"] = snap["window_reset"]
        summary["muse_week"] = snap["weekly"]
        summary["muse_week_reset_ts"] = snap["weekly_reset"]
        as_of["muse"] = snap["captured"]
        errors.pop("muse", None)
    else:
        as_of.pop("muse", None)
        errors["muse"] = "no data yet"
    summary["as_of"] = as_of
    summary["errors"] = errors
    return summary

# Antigravity `agy -p "/usage"`. One tab-separated row per window:
# pool, window label, percent REMAINING, reset time (UTC ISO-8601).
# Remaining is converted to used. Unknown pools and unreadable rows are
# skipped; they are not stored as zero.
AGY_TIMEOUT_S = 15
_AGY_POOL_NAMES = {
    "gemini models": "gemini",
    "claude and gpt models": "claudegpt",
    "gemini 4 argon": "argon",
}
# Printed and drawn in this order: Argon weekly, then Gemini, then Claude/GPT.
GOOGLE_POOLS = (
    ("argon", "Argon", False),
    ("gemini", "Gemini", True),
    ("claudegpt", "Claude/GPT", True),
)
_NOT_SIGNED_IN = re.compile(r"not signed in", re.I)

def agy_binary():
    """agy on PATH, else ~/.local/bin/agy. SEAT_USAGE_AGY wins when set."""
    override = os.environ.get("SEAT_USAGE_AGY")
    if override:
        return override
    found = shutil.which("agy")
    if found:
        return found
    default = os.path.join(H, ".local", "bin", "agy")
    if os.path.isfile(default) and os.access(default, os.X_OK):
        return default
    return None

def _agy_window(label):
    text = (label or "").casefold()
    if "five hour" in text or "5 hour" in text or "5h" in text:
        return "5h"
    if "week" in text:
        return "week"
    return None

def _agy_remaining(text):
    """Remaining percent, 0 to 100, or None when the cell is not a percent."""
    match = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*%?\s*", text or "")
    if not match:
        return None
    number = float(match.group(1))
    if number != number or number < 0 or number > 100:
        return None
    return number

def _agy_used(remaining):
    used = round(100 - remaining, 4)
    if used == int(used):
        return int(used)
    return used

def parse_agy_usage(text):
    """Pools from agy output. Each item is pool, window ('week' or '5h'), used, reset.

    The percent column is remaining. used is 100 - remaining. A row that does
    not match a known pool, a known window, a percent, and an ISO reset is
    left out. An empty result is not a zero reading.
    """
    if not isinstance(text, str) or not text.strip():
        return []
    found = {}
    for raw in text.splitlines():
        if not raw.strip():
            continue
        parts = raw.split("\t")
        if len(parts) < 4:
            continue
        name, label, pct_s, reset_s = (part.strip() for part in parts[:4])
        pool = _AGY_POOL_NAMES.get(name.casefold())
        window = _agy_window(label)
        remaining = _agy_remaining(pct_s)
        if pool is None or window is None or remaining is None:
            continue
        try:
            reset = iso_to_ts(reset_s)
        except (ValueError, TypeError, OSError, OverflowError):
            continue
        found[(pool, window)] = {"pool": pool, "window": window, "used": _agy_used(remaining), "reset": reset}
    return list(found.values())

def _agy_snippet(text):
    text = re.sub(r"\s+", " ", text or "").strip()
    if len(text) > 80:
        text = text[:79].rstrip() + "…"
    return text

def _run_agy_proc(binary, timeout):
    """(returncode, stdout, stderr, launch_error). launch_error is set when agy did not finish."""
    try:
        proc = subprocess.Popen(
            [binary, "-p", "/usage"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
    except FileNotFoundError:
        return None, "", "", "agy not found"
    except OSError as e:
        return None, "", "", e.__class__.__name__
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        _stop_git(proc)
        return None, "", "", "timeout"
    return proc.returncode, out or "", err or "", None

def _google_skipped():
    return (os.environ.get("SEAT_USAGE_SKIP_GOOGLE") == "1"
            or os.environ.get("COUNCIL_VOTER") == "1"
            or os.environ.get("CONCLAVE_VOTER") == "1")

def _google_fail(summary, reason):
    """Record the failure. Leave any numbers already stored; do not write a new one."""
    as_of = summary.get("as_of")
    as_of = dict(as_of) if isinstance(as_of, dict) else {}
    as_of.pop("google", None)
    summary["as_of"] = as_of
    errors = summary.get("errors")
    errors = dict(errors) if isinstance(errors, dict) else {}
    errors["google"] = re.sub(r"\s+", " ", str(reason)).strip()[:120]
    summary["errors"] = errors

def _clear_google_numbers(summary):
    for pool, _label, _has5 in GOOGLE_POOLS:
        for suffix in ("week", "week_reset_ts", "week_pace", "5h", "5h_reset_ts"):
            summary.pop(f"google_{pool}_{suffix}", None)

def _store_google_pools(summary, pools, now):
    """Replace this seat's numbers with the rows agy actually returned."""
    by = {(item["pool"], item["window"]): item for item in pools}
    _clear_google_numbers(summary)
    week_s, five_s = 7 * 86400, 5 * 3600
    for pool, label, has5 in GOOGLE_POOLS:
        week = by.get((pool, "week"))
        if week is not None:
            used, reset = week["used"], week["reset"]
            summary[f"google_{pool}_week"] = used
            summary[f"google_{pool}_week_reset_ts"] = reset
            summary[f"google_{pool}_week_pace"] = pace_code(used, reset, week_s, now)
            record_pool("google", f"google {label} weekly", used, reset, week_s, "agy")
        if not has5:
            continue
        five = by.get((pool, "5h"))
        if five is not None:
            used, reset = five["used"], five["reset"]
            summary[f"google_{pool}_5h"] = used
            summary[f"google_{pool}_5h_reset_ts"] = reset
            record_pool("google", f"google {label} 5h", used, reset, five_s, "agy")
    as_of = summary.get("as_of")
    as_of = dict(as_of) if isinstance(as_of, dict) else {}
    as_of["google"] = now
    summary["as_of"] = as_of
    errors = summary.get("errors")
    errors = dict(errors) if isinstance(errors, dict) else {}
    errors.pop("google", None)
    summary["errors"] = errors

def _agy_rate_path():
    """The agy floor lives beside the usage rate-limit file, not inside it."""
    return f"{CACHE_DIR}/agy-rate.json"

def _load_agy_rate():
    try:
        with open(_agy_rate_path()) as f:
            data = json.load(f)
        if isinstance(data, dict):
            return data
    except Exception:
        pass
    return {}

def _store_agy_rate(limits):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = _agy_rate_path() + ".tmp"
        with open(tmp, "w") as f:
            json.dump(limits, f)
        os.replace(tmp, _agy_rate_path())
    except Exception:
        pass

def _agy_limited(now):
    raw = _load_agy_rate().get("next")
    return isinstance(raw, (int, float)) and not isinstance(raw, bool) and now < raw

def _arm_google(now):
    """Hold the next agy call until USAGE_MIN_INTERVAL_S has passed. Tests set that to 0."""
    try:
        if USAGE_MIN_INTERVAL_S <= 0:
            try:
                os.remove(_agy_rate_path())
            except OSError:
                pass
            return
        limits = _load_agy_rate()
        nxt = now + USAGE_MIN_INTERVAL_S
        prev = limits.get("next")
        if isinstance(prev, (int, float)) and not isinstance(prev, bool) and prev > nxt:
            nxt = prev
        if limits.get("next") == nxt:
            return
        limits["next"] = nxt
        _store_agy_rate(limits)
    except Exception:
        pass

def _classify_agy(code, out, err, launch_error):
    """('ok', pools) or ('error', reason). A non-zero exit is not a reading."""
    if launch_error:
        return "error", launch_error
    parsed = parse_agy_usage(out)
    blob = f"{out}\n{err}"
    if code != 0:
        if _NOT_SIGNED_IN.search(blob):
            return "error", "not signed in"
        reason = f"exit {code}"
        snippet = _agy_snippet(err or out)
        if snippet:
            reason = f"{reason}: {snippet}"
        return "error", reason
    if _NOT_SIGNED_IN.search(blob) and not parsed:
        return "error", "not signed in"
    if not parsed:
        return "error", "unreadable output"
    return "ok", parsed

def apply_google(summary, now=None, binary=None):
    """Read agy and copy used percents into summary, unless the live-check floor is active.

    A missing binary, a not-signed-in session, or any non-zero exit sets
    errors['google'] and drops as_of['google']. Numbers already in summary
    stay; nothing new is written. A parsed reading replaces this seat's
    numbers and clears the error. SEAT_USAGE_SKIP_GOOGLE=1 leaves summary
    unchanged. --cached does not call this.
    """
    if not isinstance(summary, dict) or _google_skipped():
        return summary
    if now is None:
        now = time.time()
    try:
        if _agy_limited(now):
            return summary
        if binary is None:
            binary = agy_binary()
        if not binary:
            _google_fail(summary, "agy not found")
            _arm_google(now)
            return summary
        kind, payload = _classify_agy(*_run_agy_proc(binary, AGY_TIMEOUT_S))
        if kind == "ok":
            _store_google_pools(summary, payload, now)
        else:
            _google_fail(summary, payload)
        _arm_google(now)
    except Exception as e:
        _google_fail(summary, e.__class__.__name__)
    return summary

def _when_at(ts, now):
    if not ts:
        return "?"
    delta = ts - now
    if delta < 0:
        return "reset due"
    if delta < 86400:
        return f"resets in {delta / 3600:.1f}h"
    return f"resets in {delta / 86400:.1f}d"

def _google_usage_line(summary, now):
    parts = []
    for pool, label, has5 in GOOGLE_POOLS:
        used = summary.get(f"google_{pool}_week")
        reset = summary.get(f"google_{pool}_week_reset_ts")
        if _is_number(used) and _is_number(reset):
            parts.append(
                f"{label} weekly {_fmt_pct(used)}%: {pace(used, reset, 7 * 86400, now)}, {_when_at(reset, now)}")
        if not has5:
            continue
        five = summary.get(f"google_{pool}_5h")
        five_reset = summary.get(f"google_{pool}_5h_reset_ts")
        if _is_number(five) and _is_number(five_reset):
            parts.append(f"{label} 5h {_fmt_pct(five)}% ({_when_at(five_reset, now)})")
    if not parts:
        return None
    return f"google   | AI Pro | " + " | ".join(parts)

def google_line(summary, now=None):
    """The Google row, or None when this cache has no Google reading and no error.

    An error wins over leftover numbers so a failed reread is visible. The
    meters still draw the leftover numbers; this line does not invent one.
    """
    if not isinstance(summary, dict):
        return None
    if now is None:
        now = time.time()
    err = (summary.get("errors") or {}).get("google") if isinstance(summary.get("errors"), dict) else None
    if isinstance(err, str) and err.strip():
        return f"google   | usage failed: {err.strip()}"
    return _google_usage_line(summary, now)

def _num(v):
    import math
    return isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)

def lines_from_numbers(d, now=None):
    """Display lines rebuilt from a numbers-only cache (a pushed copy has no
    "lines"). Same layout as the live lines; a field the numbers do not carry
    (plan names, spend, tier, products, an unknown window) is left out, never
    guessed. A non-finite or non-numeric value drops only that part."""
    if now is None:
        now = NOW
    def n(k):
        v = d.get(k)
        return v if _num(v) else None
    def w(ts):
        if ts is None: return "?"
        dd = ts - now
        if dd < 0: return "reset due"
        if dd < 86400: return f"resets in {dd/3600:.1f}h"
        return f"resets in {dd/86400:.1f}d"
    def pc(pct, end, secs):
        return pace(pct, end, secs, now) if end is not None and secs else ""
    def pool(label, pct, reset, secs, seat=None):
        # Validated renewal fields only; Claude's live line shows no term, so it gets none here.
        clean = {"codex_renews_ts": n("codex_renews_ts"), "codex_renews": d.get("codex_renews")}
        end = effective_end(clean, seat, reset) if seat == "chatgpt" and reset is not None else reset
        term = f", term ends {w(end).replace('resets ', '').replace('reset due', 'now')}" if end != reset else ""
        p = pc(pct, end, secs)
        return f"{label} {pct}%: " + (f"{p}, " if p else "") + f"{w(reset)}{term}"
    def head(name, *labels):
        lab = " ".join(str(x) for x in labels if isinstance(x, str) and x)
        return f"{name:8} | " + (f"{lab} | " if lab else "")
    out = []
    parts = []
    if n("claude_5h") is not None:
        parts.append(f"5h {n('claude_5h')}% ({w(n('claude_5h_reset_ts'))})")
    if n("claude_week") is not None:
        parts.append(pool("weekly all", n("claude_week"), n("claude_week_reset_ts"), 7*86400))
    if n("fable") is not None:
        parts.append(pool("weekly Fable", n("fable"), n("fable_reset_ts"), 7*86400))
    if parts:
        out.append(head("claude", d.get("claude_plan"), d.get("claude_status")) + " | ".join(parts))
    parts = []
    if n("codex") is not None:
        secs = n("codex_window_s")
        label = ("weekly" if secs >= 7*86400 else f"{secs/3600:.0f}h") if secs else "window"
        parts.append(pool(label, n("codex"), n("codex_reset_ts"), secs, "chatgpt"))
    if n("codex_5h") is not None:
        parts.append(pool("5h", n("codex_5h"), n("codex_5h_reset_ts"), 5*3600, "chatgpt"))
    if parts:
        plan, src = d.get("codex_plan"), d.get("codex_source")
        out.append(head("chatgpt", f"{plan} ({src})" if isinstance(plan, str) and isinstance(src, str) else plan) + " | ".join(parts))
    bits = []
    if n("cursor_auto_pct") is not None: bits.append(f"cursor models {n('cursor_auto_pct'):.0f}%")
    if n("cursor_api_pct") is not None: bits.append(f"other models {n('cursor_api_pct'):.0f}%")
    if bits or n("cursor_pct") is not None:
        end, secs = n("cursor_reset_ts"), n("cursor_window_s")
        body = ", ".join(bits) or f"{n('cursor_pct'):.0f}%"
        p = pc(n("cursor_pct"), end, secs) if n("cursor_pct") is not None else ""
        out.append(head("cursor") + f"{body}: " + (f"{p}, " if p else "") + w(end))
    if n("bot_pct") is not None:
        end, secs = n("bot_reset_ts"), n("bot_window_s")
        p = pc(n("bot_pct"), end, secs)
        out.append(head("grokbot") + f"week {n('bot_pct'):.1f}%: " + (f"{p}, " if p else "") + w(end)
                   + (" | ALLOWANCE USED" if d.get("bot_exhausted") is True else ""))
    if n("grok_pct") is not None:
        reset, secs = n("grok_reset_ts"), n("grok_window_s")
        p = pc(n("grok_pct"), reset, secs)
        parts = []
        if n("grok_renews_ts") is not None and isinstance(d.get("grok_renews"), bool):
            parts.append(f"sub {'renews' if d['grok_renews'] else 'ends'} {w(n('grok_renews_ts')).replace('resets ', '')}")
        parts.append(f"week {n('grok_pct')}% ({w(reset)}" + (f"; {p})" if p else ")"))
        if d.get("grok_exhausted") is True:
            h = n("grok_402_h")
            parts.append(f"EXHAUSTED: 402 {h}h ago, until the weekly reset" if h is not None else "EXHAUSTED, until the weekly reset")
        elif d.get("grok_exhausted") is False:
            parts.append("no 402 since the last weekly reset")
        out.append(head("grok") + " | ".join(parts))
    return out

# Vendor plan IDs to the names on the vendor's pricing page. An ID missing here
# prints raw, so a new or changed plan shows up instead of being guessed.
PLAN_NAMES = {
    "claude": {"claude_ai": "Pro", "claude_pro": "Pro", "claude_max_5x": "Max 5x", "claude_max_20x": "Max 20x"},
    "chatgpt": {"free": "Free", "plus": "Plus", "prolite": "Pro $100", "pro": "Pro $200"},
    "cursor": {"free": "Free", "pro": "Pro", "pro+": "Pro+", "ultra": "Ultra"},
}
PLAN_KEYS = (("claude", "claude_plan", "claude_renews"), ("chatgpt", "codex_plan", "codex_renews"),
             ("cursor", "cursor", "cursor_renews"), ("grok", "grok", "grok_renews"))

def plans_line(summary, now=None):
    """One line naming each seat's plan as its vendor reported it, or None when no seat has one.

    Google's tier is a fixed label (agy /usage does not report it) and Muse reports none.
    A plan set to end gets its end date while that date is still ahead.
    """
    now = NOW if now is None else now
    parts = []
    for seat, key, renews_key in PLAN_KEYS:
        raw = summary.get(key)
        if not isinstance(raw, str) or not raw or raw == "?":
            continue
        name = PLAN_NAMES.get(seat, {}).get(raw.lower().replace("default_", ""), raw)
        ends = summary.get(f"{renews_key}_ts")
        if summary.get(renews_key) is False and _is_number(ends) and ends > now:
            name += ", ends " + datetime.fromtimestamp(ends).strftime("%Y-%m-%d")
        parts.append(f"{seat} {name}")
    if not parts:
        return None
    if any(k.startswith("google_") for k in summary):
        parts.append("google AI Pro (label, not read)")
    return "plans    | " + " | ".join(parts)

def print_cached():
    """--cached: print the last run's lines from the cache, no network. For the
    synchronous SessionStart hook; the async hook refreshes the cache."""
    try:
        d = json.load(open(CACHE))
        age_m = round((NOW - d["ts"]) / 60)
        if pull_only():
            header = f"[seat-usage] pull-only cached {age_m}m ago; numbers from seat-usage-push --pull"
        else:
            header = f"[seat-usage] cached {age_m}m ago; run ~/.local/bin/seat-usage for live numbers"
        seats = []
        lines = d["lines"] if "lines" in d else lines_from_numbers(d, NOW)
        for l in lines:
            seat = l.split("|")[0].strip()
            l = re.sub(r" \| stale \(reading [\d.]+h old\)$", "", l)   # recomputed below at the current age
            age = seat_age_s(d, seat, NOW)
            tag = " | no reading" if age is None else stale_tag(NOW - age)
            seats.append("  " + l + tag)
        # Recomputed against the current time, so a reset that already passed drops its line.
        burns = ["  " + burn_line(e) for e in burn_entries(d, NOW)]
    except Exception as e:
        if pull_only():
            print(f"[seat-usage] pull-only: no cached line ({e.__class__.__name__}); run seat-usage-push --pull")
        else:
            print(f"[seat-usage] no cached line ({e.__class__.__name__}); run ~/.local/bin/seat-usage")
        print("  " + muse_line())
        return
    print(header)
    pline = plans_line(d, NOW)
    if pline:
        print("  " + pline)
    for line in seats:
        print(line)
    # Cached Google row only. --cached does not run agy.
    gline = google_line(d, NOW)
    if gline:
        print("  " + gline)
    # Conclave's file, not the seat cache. Sits with the usage lines, ahead of burn nudges.
    print("  " + muse_line())
    for line in burns:
        print(line)

def _print_full(lines, burn):
    print("[seat-usage] " + datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%MZ"))
    pline = plans_line(SUMMARY)
    if pline:
        print("  " + pline)
    for l in lines:
        print("  " + l)
    gline = google_line(SUMMARY)
    if gline:
        print("  " + gline)
    print("  " + muse_line())
    for e in burn:
        print("  " + burn_line(e))

def full_run(quiet=False, timeout=LOCK_TIMEOUT):
    """Reread every seat, merge into the cache, and stamp ts to this run.

    Takes the same lock as refresh. A failed seat keeps its last numbers and
    loses as_of. A usage 429 or 401 keeps that seat's as_of and does not call
    again until the backoff deadline. On lock timeout the cache is not
    written; the lines are still printed when not quiet. An inherited lock
    fd is not unlocked.
    """
    global SUMMARY
    if pull_only():
        if not quiet:
            print_cached()
        return _load_cache()
    now = time.time()
    lock = _acquire_lock(timeout)
    if lock is None:
        SUMMARY = {"ts": now, "as_of": {}, "v": 1}
        lines = _read_jobs((claude, codex, cursor, grok))
        SUMMARY["lines"] = lines
        SUMMARY["burn"] = burn_entries(SUMMARY, now)
        if not quiet:
            _print_full(lines, SUMMARY["burn"])
        return SUMMARY
    try:
        base = _load_cache()
        SUMMARY = {"ts": now, "as_of": {}, "v": 1}
        lines = _read_jobs((claude, codex, cursor, grok))
        merged = _store_merged(base, lines, LINE_SEATS, now, stamp_now=True)
    finally:
        _release_lock(lock)
    if not quiet:
        _print_full(merged["lines"], merged["burn"])
    return merged

UPDATE_INTERVAL_S = 24 * 60 * 60
UPDATE_GIT_TIMEOUT_S = 5
_GIT_ENV_DROP = (
    "GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
    "GIT_COMMON_DIR", "GIT_PREFIX", "GIT_NAMESPACE", "GIT_ASKPASS", "SSH_ASKPASS",
)

def _update_skipped():
    if os.environ.get("QUARTERMASTER_NO_UPDATE") == "1":
        return True
    if pull_only():
        return True
    if os.environ.get("QUARTERMASTER_AUTO_UPDATE") != "1":
        return True
    if os.environ.get("COUNCIL_VOTER") == "1" or os.environ.get("CONCLAVE_VOTER") == "1":
        return True
    argv = sys.argv[1:]
    return "--route" in argv or "--quiet" in argv or "--cached" in argv

def _stamp_path():
    return os.path.join(os.path.expanduser("~"), ".cache", "quartermaster", "seat-usage-update")

def _stamp_fresh(path, now):
    try:
        with open(path) as handle:
            stamp = float(handle.read().strip())
    except (OSError, ValueError):
        return False
    return now - stamp < UPDATE_INTERVAL_S

def _write_stamp(path, now):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w") as handle:
            handle.write(f"{now:.3f}\n")
        os.replace(tmp, path)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass

def _git_env():
    env = os.environ.copy()
    for key in _GIT_ENV_DROP:
        env.pop(key, None)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env["GIT_EDITOR"] = "true"
    env["GCM_INTERACTIVE"] = "never"
    if "GIT_SSH_COMMAND" not in env:
        env["GIT_SSH_COMMAND"] = "ssh -o BatchMode=yes -o ConnectTimeout=3"
    return env

def _stop_git(proc):
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except OSError:
        return
    try:
        proc.communicate(timeout=1)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except OSError:
            pass
        proc.communicate()

def _git(root, args):
    proc = subprocess.Popen(
        ["git", "-C", root, *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        env=_git_env(),
        start_new_session=True,
    )
    try:
        out, _ = proc.communicate(timeout=UPDATE_GIT_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        _stop_git(proc)
        return None
    if proc.returncode != 0:
        return None
    return out

def _rev(root, spec):
    out = _git(root, ["rev-parse", spec])
    if out is None:
        return None
    rev = out.strip()
    return rev or None

def _fast_forward_checkout():
    script = os.path.realpath(__file__)
    top = _git(os.path.dirname(script), ["rev-parse", "--show-toplevel"])
    if top is None:
        return
    root = top.strip()
    if not root:
        return
    rel = os.path.relpath(script, root)
    if _git(root, ["ls-files", "--error-unmatch", "--", rel]) is None:
        return
    branch = _git(root, ["symbolic-ref", "--short", "HEAD"])
    if branch is None or branch.strip() != "main":
        return
    status = _git(root, ["status", "--porcelain", "--untracked-files=no"])
    if status is None or status.strip():
        return
    path = _stamp_path()
    now = time.time()
    if _stamp_fresh(path, now):
        return
    _write_stamp(path, now)
    if _git(root, ["fetch", "--quiet"]) is None:
        return
    head = _rev(root, "HEAD")
    upstream = _rev(root, "@{u}")
    if head is None or upstream is None or head == upstream:
        return
    if _git(root, ["merge-base", "--is-ancestor", "HEAD", "@{u}"]) is None:
        return
    pulled = _git(root, ["-c", "pull.rebase=false", "-c", "pull.ff=only", "pull", "--ff-only", "--quiet"])
    if pulled is None:
        return
    if _rev(root, "HEAD") in (None, head):
        return
    print("[seat-usage] updated", flush=True)
    os.execv(sys.executable, [sys.executable, *sys.argv])

def maybe_self_update():
    if _update_skipped():
        return
    try:
        _fast_forward_checkout()
    except Exception:
        return

# Which history pool a council leg draws. Muse has no history pool yet.
DRAW_LEG_POOLS = {"claude": "claude weekly Fable", "opus": "claude weekly all",
                  "codex": "chatgpt weekly", "grok": "grok week"}

def _leg_pool(voter):
    model = voter.get("model") or ""
    if voter.get("name") == "claude" and "thinking" in model:
        return "cursor other models"   # Cursor Fable IDs carry the thinking suffix
    return DRAW_LEG_POOLS.get(voter.get("name"))

def run_draws(runs, history):
    """Percent each pool moved over each finished run, from the history log.

    A run spans ts - elapsed_s to ts. The draw is the first reading at or after
    the end minus the last reading at or before the start, on the same reset.
    Other sessions share the pools, so one draw is an upper bound.
    """
    by_pool = {}
    for h in history:
        if h.get("used_pct") is None or h.get("read_ts") is None:
            continue
        by_pool.setdefault(h["pool"], []).append(h)
    for rows in by_pool.values():
        rows.sort(key=lambda h: h["read_ts"])
    out = []
    for r in runs:
        if r.get("phase") != "after" or not isinstance(r.get("elapsed_s"), (int, float)):
            continue
        end = r["ts"]
        start = end - r["elapsed_s"]
        for v in (r.get("ran") or {}).get("voters") or []:
            pool = _leg_pool(v)
            rows = by_pool.get(pool) or []
            before = [h for h in rows if h["read_ts"] <= start]
            after = [h for h in rows if h["read_ts"] >= end]
            if not before or not after:
                continue
            b, a = before[-1], after[0]
            if abs((a.get("reset_ts") or 0) - (b.get("reset_ts") or 0)) > 3600:
                continue   # the window reset mid-run
            out.append({"run_id": r["run_id"], "kind": r.get("kind"), "leg": v.get("name"),
                        "pool": pool, "draw": round(a["used_pct"] - b["used_pct"], 2),
                        "span_s": round(a["read_ts"] - b["read_ts"])})
    return out

def cmd_draw():
    runs_path = outcomes_files()[1]
    def jsonl(path):
        try:
            with open(path) as f:
                return [json.loads(l) for l in f if l.strip()]
        except OSError:
            return []
    draws = run_draws(jsonl(runs_path), jsonl(HISTORY))
    if not draws:
        print("no measurable draws")
        return
    per = {}
    for d in draws:
        per.setdefault((d["pool"], d["kind"]), []).append(d["draw"])
    print(f"{'pool':22} {'kind':7} {'n':>3} {'median':>7} {'max':>6}")
    for (pool, kind), xs in sorted(per.items()):
        xs.sort()
        med = xs[len(xs) // 2] if len(xs) % 2 else (xs[len(xs) // 2 - 1] + xs[len(xs) // 2]) / 2
        print(f"{pool:22} {kind or '-':7} {len(xs):>3} {med:>7.2f} {xs[-1]:>6.2f}")
    print("upper bounds: other sessions share these pools")

def main():
    maybe_self_update()
    if "--draw" in sys.argv:
        return cmd_draw()
    if "--route" in sys.argv:
        return cmd_route()
    if "--cached" in sys.argv:
        if os.environ.get("COUNCIL_VOTER") == "1":
            return
        return print_cached()
    if pull_only():
        if "--quiet" not in sys.argv:
            print_cached()
        return
    if os.environ.get("SEAT_USAGE_SKIP_MUSE") != "1" and os.environ.get("COUNCIL_VOTER") != "1" and os.environ.get("CONCLAVE_VOTER") != "1":
        try:
            refresh_muse_usage(time.time())
        except Exception:
            pass
    full_run(quiet="--quiet" in sys.argv)

if __name__ == "__main__":
    main()

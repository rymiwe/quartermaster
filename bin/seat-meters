             and isinstance(term, (int, float)) and isinstance(d.get(RESET_KEY.get(p["label"], "")), (int, float))
             and abs(d[RESET_KEY[p["label"]]] - term) < 1]
    if names:
        c["sub"] = (names[0] + " resets then" if len(names) == 1 else

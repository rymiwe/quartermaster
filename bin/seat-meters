    cards[-1]["pools"].append({"label": label, "seat": sid, "title": title,
                               "state": "ended" if label in ENDED else FABLE_STATE if label == "Fable" else None,
                               "ended": label in ENDED,
                               "ghost": FABLE_STATE if label == "Fable" and not m else None,

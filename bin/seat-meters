GAP = 4 * K                                      # .seat row-gap
LH = lambda px: px * 1.5 * K                     # line-height 1.5
tw = lambda s, f: g.textlength(s, font=f) / S
def wrap(text, f, width):
    out, line = [], ""
    for w_ in text.split(" "):
        t = (line + " " + w_).strip()
        if line and tw(t, f) > width: out.append(line); line = w_
        else: line = t
    return out + ([line] if line else [])
def ellipsize(parts, f, width):
    """Trim from the end until the parts fit on one line."""
    parts = list(parts)
    while parts and tw(" \u00b7 ".join(t for t, _ in parts), f) > width:
        t, r = parts[-1]
        if len(t) <= 2: parts.pop(); continue
        parts[-1] = (t[:-2].rstrip() + "\u2026" if not t.endswith("\u2026") else t[:-3].rstrip() + "\u2026", r)
    return parts
def stat_lines(parts, f, width):
    """The .v line, wrapped between parts so nothing is cut off; only a single part
    wider than the card on its own is ellipsized."""
    out, line = [], []
    for part in parts:
        if line and tw(" \u00b7 ".join(t for t, _ in line + [part]), f) > width:
            out.append(line); line = []
        line.append(part)
    if line: out.append(line)
    return [ellipsize(l, f, width) for l in out] or [[]]
g = ImageDraw.Draw(Image.new("RGB", (1, 1)))  # measuring only

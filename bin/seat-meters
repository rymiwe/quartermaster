# ---- geometry, in 1x px (orderly CSS px * K) ----
FRAME_X, FRAME_Y = 6, 8
RPX, RPY = 14 * K, 12 * K                      # .rail padding
CX0, CX1 = FRAME_X + RPX, W - FRAME_X - RPX     # card box, first column
COL_GAP = 10 * K                                 # between columns, as the rail's side padding

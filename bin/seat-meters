#!/usr/bin/env python3
"""Draw seat-usage meters as a PNG from the cached summary, laid out like orderly:
one shared time scale, every row's pace tick on a single "now" line. No network calls."""
import json, os, sys, time
from datetime import datetime
try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    sys.exit("seat-meters needs Pillow: python3 -m pip install --user pillow")

CACHE = os.environ.get("SEAT_USAGE_CACHE", os.path.expanduser("~/.cache/seat-usage/latest.json"))
ARGS = [a for a in sys.argv[1:] if a != "--phone"]; PHONE = "--phone" in sys.argv[1:]
OUT = ARGS[0] if ARGS else os.path.join(os.environ.get("TMPDIR") or "/tmp", "seat-meters.png")
BG, INK, DIM, TRACK = "#141a22", "#e6ebf2", "#8a96a8", "#2a3340"
BLUE, RED = "#5b8fd6", "#c43c3c"
H5, WK = 5 * 3600, 7 * 86400
d = json.load(open(CACHE)); now = time.time()

def seat(pct, reset, window):
    if pct is None or not reset or not window: return None
    e = max(0.0, min(1.0, 1 - (reset - now) / window))
    return {"pct": float(pct), "e": e, "w": float(window), "left": reset - now}

rows = []  # (label, main, five)
def add(label, main, five=None):
    if main or five: rows.append((label, main, five))
add("Claude", seat(d.get("claude_week"), d.get("claude_week_reset_ts"), WK), seat(d.get("claude_5h"), d.get("claude_5h_reset_ts"), H5))
add("ChatGPT", seat(d.get("codex"), d.get("codex_reset_ts"), d.get("codex_window_s") or WK), seat(d.get("codex_5h"), d.get("codex_5h_reset_ts"), H5))
add("Cursor other", seat(d.get("cursor_api_pct"), d.get("cursor_reset_ts"), d.get("cursor_window_s")))
add("Cursor models", seat(d.get("cursor_auto_pct"), d.get("cursor_reset_ts"), d.get("cursor_window_s")))
add("Grok Bot", seat(d.get("bot_pct"), d.get("bot_reset_ts"), d.get("bot_window_s") or WK))
add("SuperGrok", seat(d.get("grok_pct"), d.get("grok_reset_ts"), d.get("grok_window_s") or WK))

# Muse is not in the main cache: read seat-usage's own Muse file. A missing,
# unreadable or stale file (a reset already passed) draws a "no reading" row.
MUSE = os.environ.get("SEAT_USAGE_MUSE_FILE", os.path.expanduser("~/.cache/quartermaster/muse-usage.json"))
def epoch(v):
    if isinstance(v, (int, float)) and not isinstance(v, bool): return float(v)
    try: return datetime.fromisoformat(str(v).strip().replace("Z", "+00:00")).timestamp()
    except ValueError: return None
def muse():
    try:
        m = json.load(open(MUSE)); w, k = m["window"], m["weekly"]
        wr, kr, mins = epoch(w["resets_at"]), epoch(k["resets_at"]), float(w["window_duration_mins"])
        wp, kp = float(w["used_percent"]), float(k["used_percent"])
    except Exception:
        return None
    if None in (wr, kr) or mins <= 0 or wr <= now or kr <= now: return None
    return seat(kp, kr, WK), seat(wp, wr, mins * 60)
mu = muse()
rows.append(("Muse",) + mu if mu else ("Muse", None, None))
errs = {k: v for k, v in (d.get("errors") or {}).items() if k != "muse"}  # the Muse row says it

# Shared scale: the now line sits where the longest past and longest future just fit.
mains = [m for _, m, _ in rows if m]
past = max([m["w"] * m["e"] for m in mains] or [1]); fut = max([m["w"] * (1 - m["e"]) for m in mains] or [1])
span = past + fut; nowfrac = past / span

def font(sz, bold=False):
    p = "/usr/share/fonts/truetype/dejavu/DejaVuSans%s.ttf" % ("-Bold" if bold else "")
    return ImageFont.truetype(p, sz) if os.path.exists(p) else ImageFont.load_default()
if PHONE:  # tall, narrow, big type: label and numbers above full-width bars
    S = 3
    F, FB, FS = font(17 * S), font(17 * S, True), font(14 * S)
    W, PAD, LBL = 390, 18, 0
    MW = W - 2 * PAD
    row_h = lambda r: 70 if r[2] else 56
else:
    S = 2
    F, FB, FS = font(13 * S), font(13 * S, True), font(11 * S)
    W, PAD, LBL, MW, VAL = 600, 14, 112, 330, 120
    row_h = lambda r: 40 if r[2] else 26
X0 = PAD + LBL
NGROUPS = len({{"Cursor models": "c", "Cursor other": "c", "Grok Bot": "c"}.get(r[0], r[0]) for r in rows}) if PHONE else 0
Ht = PAD * 2 + 26 + 32 * NGROUPS + sum(row_h(r) for r in rows) + (16 * len(errs) + 8 if errs else 0)
img = Image.new("RGB", (W * S, Ht * S), BG); g = ImageDraw.Draw(img)
P = lambda v: int(v * S)

def left_txt(s):
    return f"{s/3600:.1f}h" if s < 2 * 86400 else f"{s/86400:.1f}d"

def track(st, y, h, width_frac):
    """Draw one track whose own tick lands on the shared now line."""
    nx = X0 + MW * nowfrac
    tw = MW * width_frac
    tx = nx - tw * st["e"]
    g.rounded_rectangle((P(tx), P(y), P(tx + tw), P(y + h)), radius=P(h / 2), fill=TRACK)
    fw = tw * min(st["pct"], 100) / 100
    if fw > 0:
        col_split = tw * st["e"]
        if st["pct"] >= 100:
            g.rounded_rectangle((P(tx), P(y), P(tx + fw), P(y + h)), radius=P(h / 2), fill=RED)
        else:
            g.rounded_rectangle((P(tx), P(y), P(tx + fw), P(y + h)), radius=P(h / 2), fill=BLUE)
            if fw > col_split:  # the part past the pace tick is red
                a, b = tx + col_split, tx + fw
                if b - a >= h:
                    g.rounded_rectangle((P(a), P(y), P(b), P(y + h)), radius=P(h / 2), fill=RED)
                    g.rectangle((P(a), P(y), P(a + h / 2), P(y + h)), fill=RED)
                else:
                    g.rectangle((P(a), P(y), P(b), P(y + h)), fill=RED)
    return tw

g.text((P(PAD), P(PAD)), "Seat usage", font=FB, fill=INK)
g.text((P(W - PAD), P(PAD)), f"as of {int((now - d.get('ts', now)) / 60)} min ago", font=FS, fill=DIM, anchor="ra")
y = PAD + 30; top = y
for label, m, f in (rows if not PHONE else []):
    h = row_h((label, m, f)); cy = y + 10
    g.text((P(PAD), P(cy)), label, font=F, fill=INK, anchor="lm")
    wf = m["w"] / span if m else 0.5
    if m:
        track(m, cy - 3, 6, wf)
    if f:
        track(f, cy + 8, 4, wf if m else 0.5)
    if not m and not f:
        g.text((P(X0 + MW + 12), P(cy)), "no reading", font=FS, fill=DIM, anchor="lm")
    val = f"{m['pct']:.0f}%" if m else ""
    g.text((P(X0 + MW + 12), P(cy)), val, font=FB, fill=INK, anchor="lm")
    if m: g.text((P(W - PAD), P(cy)), left_txt(m["left"]), font=FS, fill=DIM, anchor="rm")
    if f:
        g.text((P(X0 + MW + 12), P(cy + 14)), f"5h {f['pct']:.0f}%", font=FS, fill=DIM, anchor="lm")
        g.text((P(W - PAD), P(cy + 14)), left_txt(f["left"]), font=FS, fill=DIM, anchor="rm")
    y += h
# Phone layout groups pools by subscription, like orderly (Grok Bot bills the Cursor seat).
CPLAN = {"plus": "Plus", "pro": "Pro"}.get(str(d.get("codex_plan") or ""), str(d.get("codex_plan") or "").title())
GROUP = {"Claude": ("Claude", "Weekly"), "ChatGPT": (("ChatGPT " + CPLAN).strip(), "Weekly"),
         "Cursor models": ("Cursor Pro+", "Cursor Models"), "Cursor other": ("Cursor Pro+", "Other Models"),
         "Grok Bot": ("Cursor Pro+", "Grok Bot"), "SuperGrok": ("SuperGrok", "Weekly"), "Muse": ("Muse", "Weekly")}
ORDER = ["Claude", "ChatGPT", "Cursor models", "Cursor other", "Grok Bot", "SuperGrok", "Muse"]
if PHONE:
    rows.sort(key=lambda r: ORDER.index(r[0]) if r[0] in ORDER else 99)
    # orderly's dark-theme vendor hues: 3px left rule, 16% tint on the header, 9% on the rows
    HUE = {"Claude": "#ff8700", "ChatGPT": "#af87ff", "Cursor": "#00d7af", "SuperGrok": "#5fafff", "Muse": "#ff87d7"}
    def hue(grp): return next((v for k, v in HUE.items() if grp.startswith(k)), DIM)
    def mix(c, a):
        c, b = [int(c[i:i + 2], 16) for i in (1, 3, 5)], [int(BG[i:i + 2], 16) for i in (1, 3, 5)]
        return tuple(round(b[i] + (c[i] - b[i]) * a) for i in range(3))
    y += 4; top = y
    spans, yy, last = [], y, None  # first pass: where each group's panel starts and ends
    for r in rows:
        grp = GROUP.get(r[0], (r[0], ""))[0]
        if grp != last:
            yy += 10; spans.append([grp, yy, yy]); last = grp; yy += 22
        yy += row_h(r); spans[-1][2] = yy
    for grp, a, b in spans:
        X1, X2 = PAD - 8, W - PAD + 8
        g.rounded_rectangle((P(X1), P(a - 2), P(X2), P(b - 4)), radius=P(5), fill=mix(hue(grp), .09))
        g.rounded_rectangle((P(X1), P(a - 2), P(X2), P(a + 20)), radius=P(5), fill=mix(hue(grp), .16))
        g.rectangle((P(X1), P(a + 12), P(X2), P(a + 20)), fill=mix(hue(grp), .16))
        g.rectangle((P(X1), P(a - 2), P(X1 + 3), P(b - 4)), fill=hue(grp))
    last = None
    for label, m, f in rows:
        grp, sub = GROUP.get(label, (label, ""))
        if grp != last:
            y += 10
            g.text((P(PAD), P(y + 9)), grp.upper(), font=FS, fill=hue(grp), anchor="lm"); y += 22; last = grp
        h = row_h((label, m, f)); ty = y + 10
        g.text((P(PAD), P(ty)), sub, font=F, fill=INK, anchor="lm")
        if m:
            g.text((P(W - PAD), P(ty)), f"{m['pct']:.0f}%  \u00b7  {left_txt(m['left'])}", font=FB, fill=INK, anchor="rm")
            track(m, ty + 18, 10, m["w"] / span)
        else:
            g.text((P(W - PAD), P(ty)), "no reading", font=FS, fill=DIM, anchor="rm")
        if f:
            wf = m["w"] / span if m else 0.5
            track(f, ty + 34, 6, wf)
            g.text((P(W - PAD), P(ty + 37)), f"5h {f['pct']:.0f}%  \u00b7  {left_txt(f['left'])}", font=FS, fill=DIM, anchor="rm")
        nxr = X0 + MW * nowfrac  # tick only through this row's bars, never over text
        g.line((P(nxr), P(ty + 14), P(nxr), P(ty + (44 if f else 32))), fill=INK, width=P(1.5))
        y += h
nx = X0 + MW * nowfrac
if not PHONE: g.line((P(nx), P(top - 4), P(nx), P(y - 6)), fill=INK, width=P(1.5))
if not PHONE: g.text((P(nx), P(top - 6)), "now", font=FS, fill=DIM, anchor="mb")
if errs:
    y += 8
    for k, v in errs.items():
        g.text((P(PAD), P(y)), f"{k}: {str(v)[:76]}", font=FS, fill=DIM); y += 16
img.save(OUT); print(OUT)

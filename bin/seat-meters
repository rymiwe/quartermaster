#!/usr/bin/env python3
"""Draw seat-usage meters as a PNG from the cached summary, laid out like orderly's
meters panel. No network calls. A "Next host" line from
`seat-usage --route host --cached --json` (cache only), one card per subscription
with its cached renewal, family chips, and a stats line per pool, every bar on one
shared time scale with its pace tick on a single "now" line. Google AI Pro is its
own card: Argon weekly, plus Gemini and Claude/GPT. The cards run in orderly's order down two
columns (more only if the picture would still be narrower than a 9:19.5 phone screen), so a
phone shows it at full width; the host line and legend span the columns.

--text prints the layout's words as JSON in place of the output path.
--phone is accepted and ignored: this is the only layout (it used to pick it)."""
import json, os, sys, time
from datetime import datetime
try:
    from PIL import Image, ImageChops, ImageDraw, ImageFont
except ImportError:
    sys.exit("seat-meters needs Pillow: python3 -m pip install --user pillow")

CACHE = os.environ.get("SEAT_USAGE_CACHE", os.path.expanduser("~/.cache/seat-usage/latest.json"))
FLAGS = {"--phone", "--text"}
ARGS = [a for a in sys.argv[1:] if a not in FLAGS]  # --phone: a no-op, kept for old callers
TEXT = "--text" in sys.argv[1:]  # print the layout's words as JSON instead of the path
OUT = ARGS[0] if ARGS else os.path.join(os.environ.get("TMPDIR") or "/tmp", "seat-meters.png")
TRACK_A = 0.14  # orderly: color-mix(in srgb, var(--ink) 14%, transparent)
BLUE, RED, GOOGLE = "#5b8fd6", "#c43c3c", "#5468f0"
H5, WK = 5 * 3600, 7 * 86400
d = json.load(open(CACHE)); now = time.time()

def seat(pct, reset, window):
    if pct is None or not reset or not window: return None
    e = max(0.0, min(1.0, 1 - (reset - now) / window))
    return {"pct": float(pct), "e": e, "w": float(window), "left": reset - now}

rows = []  # (label, main, five)
def add(label, main, five=None):
    if main or five: rows.append((label, main, five))
add("Claude", seat(d.get("claude_week"), d.get("claude_week_reset_ts"), WK), seat(d.get("claude_5h"), d.get("claude_5h_reset_ts"), H5))
add("ChatGPT", seat(d.get("codex"), d.get("codex_reset_ts"), d.get("codex_window_s") or WK), seat(d.get("codex_5h"), d.get("codex_5h_reset_ts"), H5))
add("Cursor other", seat(d.get("cursor_api_pct"), d.get("cursor_reset_ts"), d.get("cursor_window_s")))
add("Cursor models", seat(d.get("cursor_auto_pct"), d.get("cursor_reset_ts"), d.get("cursor_window_s")))
add("Grok Bot", seat(d.get("bot_pct"), d.get("bot_reset_ts"), d.get("bot_window_s") or WK))
add("SuperGrok", seat(d.get("grok_pct"), d.get("grok_reset_ts"), d.get("grok_window_s") or WK))
# Google AI Pro. Percents in the cache are already used (100 - agy's remaining).
add("Argon", seat(d.get("google_argon_week"), d.get("google_argon_week_reset_ts"), WK))
add("Gemini", seat(d.get("google_gemini_week"), d.get("google_gemini_week_reset_ts"), WK),
    seat(d.get("google_gemini_5h"), d.get("google_gemini_5h_reset_ts"), H5))
add("Claude/GPT", seat(d.get("google_claudegpt_week"), d.get("google_claudegpt_week_reset_ts"), WK),
    seat(d.get("google_claudegpt_5h"), d.get("google_claudegpt_5h_reset_ts"), H5))

# Muse is not in the main cache: read seat-usage's own Muse file. A missing,
# unreadable or stale file (a reset already passed) draws a "no reading" row.
MUSE = os.environ.get("SEAT_USAGE_MUSE_FILE", os.path.expanduser("~/.cache/quartermaster/muse-usage.json"))
def epoch(v):
    if isinstance(v, (int, float)) and not isinstance(v, bool): return float(v)
    try: return datetime.fromisoformat(str(v).strip().replace("Z", "+00:00")).timestamp()
    except ValueError: return None
def muse():
    try:
        m = json.load(open(MUSE)); w, k = m["window"], m["weekly"]
        wr, kr, mins = epoch(w["resets_at"]), epoch(k["resets_at"]), float(w["window_duration_mins"])
        wp, kp = float(w["used_percent"]), float(k["used_percent"])
    except Exception:
        return None
    if None in (wr, kr) or mins <= 0 or wr <= now or kr <= now: return None
    return seat(kp, kr, WK), seat(wp, wr, mins * 60), epoch(m.get("captured_at"))
mu = muse()
MUSE_AT = mu[2] if mu else None
mu = mu[:2] if mu else None
rows.append(("Muse",) + mu if mu else ("Muse", None, None))
# A 5h window whose reset time has passed has rolled over since the reading: drop its bar.
rows = [(l, m, f if f and f["left"] > 0 else None) for l, m, f in rows]
errs = {k: v for k, v in (d.get("errors") or {}).items() if k != "muse"}  # the Muse row says it

# Shared scale: the now line sits where the longest past and longest future just fit.
mains = [m for _, m, _ in rows if m]
past = max([m["w"] * m["e"] for m in mains] or [1]); fut = max([m["w"] * (1 - m["e"]) for m in mains] or [1])
span = past + fut; nowfrac = past / span


S = 3      # device pixels per 1x px
W = 390    # 1x width of one column: orderly's narrow rail
# Columns of cards: two, or more when the picture would still be narrower than a phone screen
# (9:19.5 portrait), so a phone fits it to its width rather than its height.
MIN_ASPECT = 9 / 19.5
P = lambda v: int(v * S)

SS = 4  # supersample factor for bar shapes: Pillow's rounded_rectangle has no antialiasing
def pill(x0, y0, x1, y1, color, alpha=1.0, split=None, color2=None, alpha2=1.0):
    """Antialiased rounded bar like orderly's (border-radius 3px, clamped to a pill),
    composited onto the image at `alpha`. Past x `split` it is `color2` at `alpha2`, a hard stop."""
    X0, Y0, X1, Y1 = x0 * S, y0 * S, x1 * S, y1 * S
    ox, oy = int(X0), int(Y0); w, h = int(X1 + 1) - ox, int(Y1 + 1) - oy
    # under one supersampled pixel there is nothing to draw (and Pillow rejects the inverted box)
    if (X1 - X0) * SS < 1 or (Y1 - Y0) * SS < 1 or w <= 0 or h <= 0: return
    r = min(3 * S, (X1 - X0) / 2, (Y1 - Y0) / 2) * SS
    m = Image.new("L", (w * SS, h * SS), 0)
    box = ((X0 - ox) * SS, (Y0 - oy) * SS, (X1 - ox) * SS - 1, (Y1 - oy) * SS - 1)
    ImageDraw.Draw(m).rounded_rectangle(box, radius=max(0, r - 0.5), fill=round(255 * alpha))
    c = Image.new("RGB", (w * SS, h * SS), color)
    if split is not None:
        sx = max(0, int((split * S - ox) * SS))
        c.paste(color2, (sx, 0, w * SS, h * SS))
        if alpha2 != alpha:  # the shape past the split, at its own opacity
            m2 = Image.new("L", (w * SS, h * SS), 0)
            ImageDraw.Draw(m2).rounded_rectangle(box, radius=max(0, r - 0.5), fill=round(255 * alpha2))
            m.paste(m2.crop((sx, 0, w * SS, h * SS)), (sx, 0))
    img.paste(c.resize((w, h), Image.BOX), (ox, oy), m.resize((w, h), Image.LANCZOS))

def striped(x0, y0, x1, y1):
    """orderly's .meter .track.ended: repeating-linear-gradient(135deg, ink 22% 0 4px, ink 10%
    4px 8px) on the 3px-radius track (newtab.html:150, 154). At 135deg the stripes run up and
    to the right, and a point's place along the gradient is (x + y) / sqrt 2 from the top left."""
    X0_, Y0_, X1_, Y1_ = x0 * S, y0 * S, x1 * S, y1 * S
    ox, oy = int(X0_), int(Y0_); w, h = int(X1_ + 1) - ox, int(Y1_ + 1) - oy
    if w <= 0 or h <= 0: return
    r = min(3 * S, (X1_ - X0_) / 2, (Y1_ - Y0_) / 2) * SS
    m = Image.new("L", (w * SS, h * SS), 0)
    ImageDraw.Draw(m).rounded_rectangle(((X0_ - ox) * SS, (Y0_ - oy) * SS, (X1_ - ox) * SS - 1, (Y1_ - oy) * SS - 1),
                                        radius=max(0, r - 0.5), fill=255)
    period, a, b = 8 * K * S * SS, round(255 * .22), round(255 * .10)
    sx, sy = (ox - X0_) * SS, (oy - Y0_) * SS
    st = Image.new("L", (w * SS, h * SS))
    st.putdata([a if ((xx + sx + yy + sy) / math.sqrt(2)) % period < period / 2 else b
                for yy in range(h * SS) for xx in range(w * SS)])
    m = ImageChops.multiply(m, st)
    img.paste(Image.new("RGB", (w, h), INK), (ox, oy), m.resize((w, h), Image.LANCZOS))

def track(st, y, h, width_frac, right=None, left=None, fill_alpha=1.0):
    """Draw one track whose own tick lands on the shared now line. Styled after
    orderly's .meter: a translucent ink track (14%), a blue fill that turns red
    past the pace tick, and red throughout when the pool is full."""
    nx = X0 + MW * nowfrac
    tw = MW * width_frac
    # Keep the track inside the meter area: shrink it (tick still on now) if it would spill.
    if st["e"] > 0: tw = min(tw, (nx - (left if left is not None else X0)) / st["e"])
    if st["e"] < 1: tw = min(tw, ((right if right is not None else X0 + MW) - nx) / (1 - st["e"]))
    tx = nx - tw * st["e"]
    if tw < h: return  # no room left for a track that keeps its tick on now
    pill(tx, y, tx + tw, y + h, INK, TRACK_A)
    fw = tw * min(st["pct"], 100) / 100
    if fw > 0:
        split = tx + tw * st["e"]
        if st["pct"] >= 100:
            pill(tx, y, tx + fw, y + h, RED)
        elif fw > tw * st["e"]:  # the part past the pace tick is red, at full strength
            pill(tx, y, tx + fw, y + h, BLUE, fill_alpha, split=split, color2=RED)
        else:
            pill(tx, y, tx + fw, y + h, BLUE, fill_alpha)
    return tw

# Layout: orderly's meters rail at its narrow width (extension/newtab.html
# .rail/.band-hdr/.seat/.chip/.meter, newtab.js renderRail). Sizes are orderly's
# CSS px times K. Every word here comes from the cache, the Muse file, or
# `seat-usage --route host --cached --json`; nothing is filled in to look complete.
import glob, math, re, subprocess
# 1.7, not orderly's own 1: each column is orderly's rail at about 229 CSS px, so the type is
# large enough to read when a phone shows the two-column picture at its width (~1080 px).
K = 1.7
O_BG, O_PANEL2, O_LINE = "#14171c", "#20262e", "#2b323c"
O_INK, O_INK2, O_MUTED, O_CRIT = "#e4e8ee", "#a3acb9", "#6f7987", "#e04b4b"
O_WARN = "#fab219"  # orderly --warn
VHUE = {"claude": "#ff8700", "codex": "#af87ff", "cursor": "#00d7af", "grok": "#5fafff",
        "google": GOOGLE, "muse": "#ff87d7"}
INK = O_INK  # tracks are ink at 14% over the card, as in orderly

def _find_font(names):
    roots = ["/usr/share/fonts", "/usr/local/share/fonts", os.path.expanduser("~/.local/share/fonts"),
             os.path.expanduser("~/.fonts"), "/Library/Fonts", os.path.expanduser("~/Library/Fonts"),
             "/System/Library/Fonts"]
    for n in names:
        for r in roots:
            hit = sorted(glob.glob(os.path.join(r, "**", n), recursive=True))
            if hit: return hit[0]
    return None
# orderly: --sans "IBM Plex Sans", --mono "JetBrains Mono"; DejaVu when they are not installed
SANS = _find_font(["IBMPlexSans-VariableFont*.ttf", "IBMPlexSans-SemiBold.ttf", "DejaVuSans.ttf", "Helvetica.ttc"])
SANS_REG = _find_font(["IBMPlexSans-VariableFont*.ttf", "IBMPlexSans-Regular.ttf", "DejaVuSans.ttf", "Helvetica.ttc"])
MONO = _find_font(["JetBrainsMono-VariableFont_wght.ttf", "JetBrainsMono-Regular.ttf", "DejaVuSansMono.ttf", "Menlo.ttc"])
MONO_FB = _find_font(["DejaVuSansMono.ttf", "Menlo.ttc"])  # for glyphs JetBrains Mono lacks (the star)
if not (SANS and SANS_REG and MONO):
    sys.exit("seat-meters needs a TrueType sans and mono face (IBM Plex Sans and JetBrains Mono, or DejaVu)")
def vfont(path, px, weight=None):
    f = ImageFont.truetype(path, max(1, round(px * S)))
    if weight is not None:
        try:
            axes = f.get_variation_axes()
            f.set_variation_by_axes([weight if a.get("name") in (b"Weight", "Weight") else a["default"] for a in axes])
        except Exception:
            pass  # a static face: its own weight
    return f
F_TITLE = vfont(SANS, 12 * K, 600)      # .seat b
F_HOST = vfont(SANS_REG, 13 * K, 400)   # .host-line
F_WHY = vfont(SANS_REG, 12 * K, 400)    # .host-line .why
F_HDR = vfont(MONO, 10.5 * K, 400)      # .band-hdr, .rail-key
F_CHIP = vfont(MONO, 9.5 * K, 400)      # .seat .lab .chip
F_V = vfont(MONO, 11 * K, 400)          # .seat .v

def rrect(box, radius, fill, corners):
    try:
        g.rounded_rectangle(box, radius=radius, fill=fill, corners=corners)
    except TypeError:  # Pillow before 9.3 has no per-corner radius: square corners
        g.rectangle(box, fill=fill)
def mixhex(c, a, under):
    c, b = [int(c[i:i + 2], 16) for i in (1, 3, 5)], [int(under[i:i + 2], 16) for i in (1, 3, 5)]
    return tuple(round(b[i] + (c[i] - b[i]) * a) for i in range(3))
hexof = lambda t: "#%02x%02x%02x" % t
rnd = lambda v: int(math.floor(float(v) + 0.5))  # Ruby's round, as orderly's pct_text
def fspan(secs):  # orderly formatSpan
    s = max(0, int(secs)); dd, hh, mm = s // 86400, (s % 86400) // 3600, (s % 3600) // 60
    if dd >= 2: return f"{dd}d"
    if dd >= 1: return f"{dd}d {hh}h" if hh else f"{dd}d"
    if hh >= 1: return f"{hh}h {mm}m" if mm else f"{hh}h"
    return f"{mm}m"
def reset_label(t):  # orderly resetLabel: a time within 24h, a weekday within 7 days, else M/D
    if not isinstance(t, (int, float)) or t <= now: return ""
    dt = datetime.fromtimestamp(t)
    if t - now < 86400:
        h = dt.hour % 12 or 12
        return f"{h}" + (f":{dt.minute:02d}" if dt.minute else "") + ("am" if dt.hour < 12 else "pm")
    if t - now < 7 * 86400: return dt.strftime("%a")
    return f"{dt.month}/{dt.day}"

CPLAN = {"plus": "Plus", "pro": "Pro"}.get(str(d.get("codex_plan") or ""), str(d.get("codex_plan") or "").title())
# Is the Claude plan Max? seat-usage's claude_max (bool) first, the plan name second;
# None when the cache can't say. Same rule as seat-usage's claude_max().
PLAN = d.get("claude_plan") if isinstance(d.get("claude_plan"), str) else ""
if "claude_max" in d:
    CLAUDE_MAX = d["claude_max"] if isinstance(d["claude_max"], bool) else None
else:
    tier = PLAN.strip().lower().replace("default_", "")
    CLAUDE_MAX = True if "max" in tier else False if tier in ("claude_ai", "claude_pro") else None
# Subscription each card belongs to: (paid-through key, will-renew key), as orderly's quota_renewal.
SUBS = {"claude": ("claude_renews_ts", "claude_renews"), "codex": ("codex_renews_ts", "codex_renews"),
        "cursor": ("cursor_reset_ts", "cursor_renews"), "grok": ("grok_renews_ts", "grok_renews")}
def renewal(vendor):
    """(text, warn) for the band header, or None when the cache has no date."""
    if vendor not in SUBS: return None
    ts, rn = d.get(SUBS[vendor][0]), d.get(SUBS[vendor][1])
    if not isinstance(ts, (int, float)) or isinstance(ts, bool): return None
    rn = rn if isinstance(rn, bool) else None
    if ts <= now:
        return ("sub ended" if rn is False else "sub renewal due"), False
    verb = "renews" if rn is True else "sub ends" if rn is False else "term ends"
    return f"{verb} {reset_label(ts)}", rn is False and ts - now < 7 * 86400

# Model families each pool can serve: orderly's FAMILIES/METERED/BUILDER_ONLY
# (extension/newtab.js). Google AI Pro's families are data in config/pools.json
# ("google_ai_pro"); orderly gets the same lists through seat_rows and merges
# them into FAMILIES (families(), below).
FAMILIES = [("Fable", ["claude_fable", "claude_weekly", "cursor_other"]), ("Opus", ["claude_weekly", "cursor_other"]),
            ("Astra", ["codex"]), ("Sol", ["codex", "cursor_other"]), ("Grok", ["cursor_models", "supergrok"]),
            ("Grok Bot", ["grokbot"]), ("Wonder full", ["muse"]), ("Wonder", ["muse"])]
METERED, BUILDER_ONLY = {"cursor_other"}, {"supergrok"}
def pools_conf():
    """pools.json as seat-usage finds it (SEAT_USAGE_POOLS, then the repo's config), or {}."""
    path = os.environ.get("SEAT_USAGE_POOLS") or os.path.join(
        os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "config", "pools.json")
    try:
        with open(path) as fh: conf = json.load(fh)
    except (OSError, ValueError): return {}
    return conf if isinstance(conf, dict) else {}
def google_families():
    """{pool: [family]} from pools.json's google_ai_pro block, as seat-usage's GOOGLE_FAMILIES."""
    block = pools_conf().get("google_ai_pro")
    pools = block.get("pools") if isinstance(block, dict) else None
    if not isinstance(pools, dict): return {}
    return {pool: [f for f in rec["families"] if isinstance(f, str) and f] for pool, rec in pools.items()
            if isinstance(rec, dict) and isinstance(rec.get("families"), list)}
GFAM = google_families()

# label -> (orderly seat id, vendor card, title, as_of key)
POOL = {"Claude": ("claude_weekly", "claude", "Claude \u00b7 weekly", "claude"),
        "ChatGPT": ("codex", "codex", "Codex \u00b7 weekly", "chatgpt"),
        "Cursor models": ("cursor_models", "cursor", "Cursor \u00b7 Cursor Models", "cursor"),
        "Cursor other": ("cursor_other", "cursor", "Cursor \u00b7 Other Models", "cursor"),
        "Grok Bot": ("grokbot", "cursor", "Grok Bot \u00b7 weekly", "grokbot"),
        "SuperGrok": ("supergrok", "grok", "SuperGrok \u00b7 weekly", "grok"),
        "Argon": ("google_argon_week", "google", "Google AI Pro \u00b7 Argon", "google"),
        "Gemini": ("google_gemini_week", "google", "Google AI Pro \u00b7 Gemini", "google"),
        "Claude/GPT": ("google_claudegpt_week", "google", "Google AI Pro \u00b7 Claude/GPT", "google"),
        "Muse": ("muse", "muse", "Muse \u00b7 weekly", None)}
RESET_KEY = {"Claude": "claude_week_reset_ts", "ChatGPT": "codex_reset_ts", "Cursor models": "cursor_reset_ts",
             "Cursor other": "cursor_reset_ts", "Grok Bot": "bot_reset_ts", "SuperGrok": "grok_reset_ts"}
# The Fable slice row is always drawn, as orderly's quota_claude_fable (server.rb:2031-2047):
#   live    the cache has a fable percent;
#   absent  the plan is known not to be Max and the Claude read finished (fable_absent?,
#           server.rb:2005-2011): "not on <plan title>", or "not on this plan" with no title;
#   unknown otherwise: "unknown · seat-usage has no value" (unknown_quota_seat, server.rb:1934).
# orderly reads the plan name (claude_plan), and so does this when the cache has one. The
# numbers-only pulled copy has only the claude_max bit: with no plan name, a false claude_max
# counts as a known non-Max plan with no title.
def _isnum(v): return isinstance(v, (int, float)) and not isinstance(v, bool)
as_of = d.get("as_of") if isinstance(d.get("as_of"), dict) else {}
_plan = PLAN if PLAN and PLAN != "?" else None
if _plan is not None: _not_max = "max" not in _plan.lower()
else: _not_max = d.get("claude_max") is False
# claude_plan_title (server.rb:1989): Max, Pro for claude_ai, else the tier name as read
_title = None if not _plan else "Max" if "max" in _plan.lower() else {"claude_ai": "Pro"}.get(_plan, _plan)
FABLE_PCT = d.get("fable") if _isnum(d.get("fable")) else None
FABLE_STATE = ("live" if FABLE_PCT is not None else
               "absent" if _not_max and _isnum(as_of.get("claude")) else "unknown")
FABLE_TEXT = (f"not on {_title}" if _title else "not on this plan") if FABLE_STATE == "absent" else None
rows.append(("Fable", seat(FABLE_PCT, d.get("fable_reset_ts"), WK) if FABLE_PCT is not None else None, None))
POOL["Fable"] = ("claude_fable", "claude", "Claude \u00b7 Fable slice", "claude")
RESET_KEY["Fable"] = "fable_reset_ts"
# An ended subscription, as orderly's subEnded (extension/newtab.js:773-775, termPast 744-747):
# set not to renew (renews false) and its paid-through stamp is now or past. Same keys as
# renewal() above (server.rb:1749-1754, quota_renewal 1770-1796). orderly's date-only Claude term
# (claude_renews_on) is not in the pulled cache, so only the timed stamp counts here.
def sub_ended(vendor):
    if vendor not in SUBS: return False
    ts = d.get(SUBS[vendor][0])
    return d.get(SUBS[vendor][1]) is False and _isnum(ts) and ts <= now
# orderly lists every seat, read or not, so an ended plan's rows are drawn even with no
# usage numbers left in the cache: add the ones add() dropped.
_have = {label for label, _, _ in rows}
rows += [(label, None, None) for label, (_s, vendor, _t, _a) in POOL.items()
         if label not in _have and sub_ended(vendor)]
ENDED = {label for label, _, _ in rows if sub_ended(POOL.get(label, (label, ""))[1])}
# The shared time scale again, now with the Fable row: orderly's renderRail takes every live
# row's window into one span, so Fable's track keeps its full weekly width. An ended row has
# no window there (newtab.js:1169), so it stays out of the span.
mains = [m for l, m, _ in rows if m and l not in ENDED]
past = max([m["w"] * m["e"] for m in mains] or [1]); fut = max([m["w"] * (1 - m["e"]) for m in mains] or [1])
span = past + fut; nowfrac = past / span
ORDER = ["Claude", "Fable", "ChatGPT", "Cursor models", "Cursor other", "Grok Bot", "SuperGrok",
         "Argon", "Gemini", "Claude/GPT", "Muse"]
# Ended plans sink to the bottom, the rest in order (newtab.js:1159-1163); a subscription's rows
# end together, so its card and header move with them.
rows.sort(key=lambda r: (r[0] in ENDED, ORDER.index(r[0]) if r[0] in ORDER else 99))
# seat-usage's cap projection for each row's main pool: <pool>_caps_early_s.
CAPS_KEY = {"Claude": "claude_week", "Fable": "fable", "ChatGPT": "codex", "Cursor models": "cursor_models",
            "Cursor other": "cursor_other", "Grok Bot": "grokbot", "SuperGrok": "grok",
            "Argon": "google_argon_week", "Gemini": "google_gemini_week",
            "Claude/GPT": "google_claudegpt_week", "Muse": "muse_week"}
def roughspan(secs):  # orderly roughSpan
    return fspan(secs if secs < 3600 else math.floor(secs / 3600 + 0.5) * 3600)  # JS Math.round

def read_failed():
    """quota_read (server.rb): no as_of.claude stamp is a failed read; renderRail's red
    "read failed" plus readCode of the error (newtab.js:792, 1222)."""
    if _isnum(as_of.get("claude")): return None
    m_ = re.search(r"\b[A-Z]\w*Error(?: \d{3})?", str((d.get("errors") or {}).get("claude") or ""))
    return ("read failed" + (": " + m_.group(0) if m_ else ""), True)
def fable_stats(m):
    """The Fable row's .v line when it has no drawable bar (renderRail, newtab.js:1205-1231)."""
    at = as_of.get("claude")
    age = now - at if _isnum(at) else None
    rf = read_failed()
    if FABLE_STATE == "absent":  # absent: its text, and "stale" once the read is over 15 minutes old
        return [(FABLE_TEXT, False)] + ([(f"stale {fspan(age)}", False)] if age is not None and age > 15 * 60 else [])
    if FABLE_STATE == "live":    # a percent with no reset: no window, so only the percent
        return ([(f"{rnd(FABLE_PCT)}%", False)] + ([rf] if rf else []) +
                ([(f"stale {fspan(age)}", False)] if age is not None and age > 15 * 60 else []))
    parts = [("unknown", False), ("seat-usage has no value", False)]
    if rf: return [rf] + parts  # not live: first
    return parts + [(f"verified {str(int(max(0, age))) + 's' if age < 60 else fspan(age)}", False)]

def stats(label, m, f):
    """orderly's .v line: percent, 5h, reset, and an old reading. [(text, red)]."""
    # An ended plan's line is only its renewal words, "sub ended", in the muted .renew class
    # (newtab.js:1190-1201, renewalPart 757-759): no usage, pace, reset or read state.
    if label in ENDED: return [("sub ended", False)]
    if label == "Fable" and not m: return fable_stats(m)
    if not m and not f: return [("no reading", False)]
    parts = []
    if m: parts.append((f"{rnd(m['pct'])}%", False))
    early = d.get(CAPS_KEY[label] + "_caps_early_s") if label in CAPS_KEY else None
    # Right after the percentage, as orderly, so a narrow row cuts the reset, not this.
    if m and m["left"] > 0 and isinstance(early, (int, float)) and not isinstance(early, bool) \
            and math.isfinite(early) and early > 0:
        parts.append((f"caps {roughspan(early)} early", True))
    if f:
        hot = f["pct"] >= 100 or f["pct"] > f["e"] * 100
        parts.append((f"5h {rnd(f['pct'])}%", hot))
    sid, vendor, _t, at_key = POOL.get(label, (label, "", label, None))
    rk = RESET_KEY.get(label)
    reset = d.get(rk) if rk else None
    if not isinstance(reset, (int, float)) and m: reset = now + m["left"]
    sub = SUBS.get(vendor)
    term = d.get(sub[0]) if sub else None
    same = isinstance(term, (int, float)) and isinstance(reset, (int, float)) and abs(term - reset) < 1
    lbl = reset_label(reset) if m else ""
    if lbl and not same:
        after = sub and d.get(sub[1]) is False and isinstance(term, (int, float)) and reset > term
        parts.append(((f"pool reset {lbl} (after term)" if after else f"resets {lbl}"), False))
    at = as_of.get(at_key) if at_key else (MUSE_AT if label == "Muse" else None)
    if isinstance(at, (int, float)) and now - at > 15 * 60:
        parts.append((f"stale {fspan(now - at)}", False))
    if label == "Fable" and read_failed():
        # orderly splices "read failed" in after the percent, then the caps warning before it
        parts.insert(2 if len(parts) > 1 and parts[1][0].startswith("caps ") else 1, read_failed())
    return parts

def families():
    """orderly families(): FAMILIES, then the families each Google row names. seat_rows
    (bin/seat-usage) puts them on a Google weekly bar when as_of.google is a number and the
    pool's weekly percent is a number, in the order argon, gemini, claudegpt. A row joins the
    end of a family's sources; a family orderly doesn't know joins the end of the list."""
    out = [(n, list(src)) for n, src in FAMILIES]
    isnum = lambda v: isinstance(v, (int, float)) and not isinstance(v, bool)
    google_ok = isnum((d.get("as_of") if isinstance(d.get("as_of"), dict) else {}).get("google"))
    for pool in ("argon", "gemini", "claudegpt"):
        sid = f"google_{pool}_week"
        if not (google_ok and isnum(d.get(sid))): continue
        for name in GFAM.get(pool, []):
            fam = next((x for x in out if x[0] == name), None)
            if fam is None: out.append(fam := (name, []))
            if sid not in fam[1]: fam[1].append(sid)
    return out
FAMS = families()
def chips(sid):
    """orderly seatLabel: every family whose sources include this seat, in families() order.
    No plan, availability or cap hides one. dashed = metered, dotted = builder only."""
    style = "dashed" if sid in METERED else "dotted" if sid in BUILDER_ONLY else "solid"
    return [(name, style) for name, src in FAMS if sid in src]
def num(v):
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v) else None
def spend(label, m):
    """orderly spendChip: Cursor's on-demand spend as a "$" chip on the Cursor and Grok Bot rows
    (the rows orderly gives on_demand). Shown on a capped pool, or on a Cursor row with spend
    above zero; "over" past the cached limit, "draw" on a capped pool, else plain."""
    sid = POOL.get(label, (label,))[0]
    spent = num(d.get("cursor_ondemand"))
    if sid not in ("cursor_models", "cursor_other", "grokbot") or spent is None or not m: return None
    capped = (sid == "grokbot" and d.get("bot_exhausted") is True) or m["pct"] >= 100
    if not (capped or (sid != "grokbot" and spent > 0)): return None
    limit = num(d.get("cursor_ondemand_limit"))
    return "over" if limit is not None and spent > limit else "draw" if capped else "plain"

# Cards: one per subscription run, Grok Bot on the Cursor bill.
cards = []
for label, m, f in rows:
    sid, vendor, title, _ = POOL.get(label, (label, "", label, None))

        p["stat_l"] = stat_lines(p["stats"], F_V, TX1 - TX0)
pool_h = lambda p: p["chip_lines"] * CHIP_LH + (PADY + LH(12) + GAP + (12 if p["five"] and p["main"] else 6) * K
                                                + GAP + LH(11) * len(p["stat_l"]) + PADY
    if (p["main"] or p["five"] or p["ghost"]) and not p["ended"] else
    PADY + LH(12) + GAP + 6 * K + GAP + LH(11) * len(p["stat_l"]) + PADY if p["ended"] else PADY + LH(12) + GAP + LH(11) * len(p["stat_l"]) + PADY)
for c in cards:

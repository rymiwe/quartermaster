# Next host: seat-usage's own pick from the cache, as orderly's host line.
def route_host():
    exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "seat-usage")
    if not os.path.exists(exe): return None
    # seat-usage reads <SEAT_USAGE_CACHE_DIR>/latest.json: point it at the file these meters read
    if os.path.basename(CACHE) != "latest.json": return None
    env = {**os.environ, "SEAT_USAGE_CACHE_DIR": os.path.dirname(os.path.abspath(CACHE))}
    try:
        r = subprocess.run([sys.executable, exe, "--route", "host", "--cached", "--json"], env=env,
                           capture_output=True, text=True, timeout=15)
        rows_ = json.loads(r.stdout) if r.returncode == 0 else None
    except Exception:
        return None
    if not isinstance(rows_, list): return None
    return next((x for x in rows_ if isinstance(x, dict) and x.get("role") == "host"), None)
def host_lines(s):
    if not isinstance(s, dict): return "Next host: no cached route", ""
    sid, label = s.get("suggestion"), ""
    if sid == "grokbot": label = "Grok Bot"
    elif sid == "opus":
        eff = s.get("effort") if s.get("effort") not in (None, "", "-") else ""
        # orderly says "on Max"; only a Max plan in the cache says so here
        label = "Opus" + (f" {eff}" if eff else "") + (" on Max" if CLAUDE_MAX is True else "")
    elif sid: label = str(s.get("family") or sid)
    reason = str(s.get("reason") or "")
    lean_names = [{"cursor_models": "Cursor Models", "grok": "SuperGrok"}.get(i, str(i)) for i in (s.get("lean") or [])]
    lean = ("lean " + lean_names[0] + "".join(", then " + n for n in lean_names[1:])) if lean_names else ""
    if not label and s.get("mode") == "ask":
        text = "Next host: ask" + (f" ({reason})" if reason else "") + (f" \u00b7 {lean}" if lean else "")
    elif label: text = f"Next host: {label}" + (f" ({reason})" if reason else "")
    else: text = "Next host:" + (f" {reason}" if reason else "")
    names = {"grokbot": "Grok Bot", "opus": "Opus on Max" if CLAUDE_MAX is True else "Opus"}
    wins = {"grokbot": "its weekly allowance",
            "claude_week": "the Max weekly pool" if CLAUDE_MAX is True else "the Claude weekly pool",
            "claude_5h": "the Max 5h window" if CLAUDE_MAX is True else "the Claude 5h window"}
    why = []
    hosts = s.get("hosts") if isinstance(s.get("hosts"), list) else []
    for h in hosts:
        if not isinstance(h, dict): continue
        n, w = names.get(h.get("id"), h.get("id")), wins.get(h.get("binding"), h.get("binding") or "its pool")
        u = h.get("used_pct")
        used = f" at {rnd(u)}%" if isinstance(u, (int, float)) and not isinstance(u, bool) else ""
        st = h.get("state")
        if st == "capped": why.append(f"{n}: {w} is used up{used}.")
        elif st == "ahead": why.append(f"{n}: {w} is{used}" + ("," if used else "") + " ahead of the time elapsed, so it may run out before it resets.")
        elif st == "unknown":
            # unknown because the reading is past the route's freshness limit: an old
            # reading, not a missing one, so say how old it is
            age = h.get("reading_age_s")
            if isinstance(age, (int, float)) and not isinstance(age, bool) and math.isfinite(age) and age > FRESH_S:
                why.append(f"{n}: reading stale, {fspan(age)} old.")
            else: why.append(f"{n}: no reading.")
    if why and s.get("mode") == "ask" and not label:
        why.append("No host is clear, so the router leaves the choice to you.")
        if lean: why.append("If you start one anyway, draw Grok from " + lean[5:] + " first.")
    return text, " ".join(why)
def route_fresh_s():
    """seat-usage's route_fresh_s: how old a reading may be before a route calls it unknown.
    pools.json route_freshness_s, 600 s live / 1200 s on a pulled copy when unset."""
    fresh = pools_conf().get("route_freshness_s")
    fresh = fresh if isinstance(fresh, dict) else {}
    key = "pulled" if isinstance(d.get("pulled_ts"), (int, float)) and not isinstance(d.get("pulled_ts"), bool) else "live"
    v = fresh.get(key)
    return v if isinstance(v, (int, float)) and not isinstance(v, bool) and v > 0 else {"live": 600, "pulled": 1200}[key]
FRESH_S = route_fresh_s()

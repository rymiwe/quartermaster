    if c["header"]:
        yy = top + 3 * K
        head, rest = c["header"].split(" \u00b7 ", 1)
        g.text((P(TX0), P(yy + LH(10.5) / 2)), head + " \u00b7 ", font=F_HDR, fill=O_INK2, anchor="lm")
        g.text((P(TX0 + tw(head + " \u00b7 ", F_HDR)), P(yy + LH(10.5) / 2)), rest, font=F_HDR,
               fill=O_CRIT if c["header_warn"] else O_INK2, anchor="lm")
        for k_, l in enumerate(c["sub_l"]):
            g.text((P(TX0), P(yy + LH(10.5) * (1.5 + k_))), l, font=F_HDR, fill=O_MUTED, anchor="lm")
        y += hdr_h(c)
    for p in c["pools"]:
        yy = y + PADY
        ly = yy + LH(12) / 2
        # .seat.ended b,.seat.absent b{color:var(--muted)} (newtab.html:156)
        g.text((P(TX0), P(ly)), p["title"], font=F_TITLE,
               fill=O_MUTED if p["ghost"] == "absent" or p["ended"] else O_INK, anchor="lm")
        for k_, (name, style, cx, line) in enumerate(p["fit"]):
            sp = p["spend"] if (name == "$" and k_ == len(p["chips"]) - 1) else None
            # orderly: Grok Bot's family chips in Grok blue (.chip.fam); its "$" chip keeps the Cursor hue
            ch = VHUE["grok"] if p["seat"] == "grokbot" and not sp else hue
            chip(cx + dx, ly + line * CHIP_LH, name, style, ch, sp)
        yy += LH(12) + p["chip_lines"] * CHIP_LH + GAP
        m, f = p["main"], p["five"]
        if p["ended"]:
            # An ended plan: a full-width striped grey track, no fill and no now tick
            # (newtab.js:1191-1194; .meter .track.ended, newtab.html:154; .meter height 6px).
            snap = lambda v: round(v * S) / S
            yy = snap(yy); bh = snap(6 * K)
            striped(X0, yy, X0 + MW, yy + bh)
            yy += 6 * K + GAP
        elif m or f:
            snap = lambda v: round(v * S) / S  # whole device pixels: no half-lit rows in a bar
            yy = snap(yy)
            if m:
                track(m, yy, snap(5 * K if f else 6 * K), m["w"] / span)
            if f:
                track(f, yy + (snap(8 * K) if m else 0), snap(3 * K), m["w"] / span if m else 0.5, fill_alpha=.55)
            bh = (12 if (m and f) else 6) * K
            ntick(X0 + MW * nowfrac, yy, yy + bh)
            yy += bh + GAP
        elif p["ghost"]:
            # orderly renderRail with no window: no now tick. absent: a full-width track at ink 8%
            # (.track.absent, newtab.html:155); otherwise the 50% track at left 25% (newtab.js:1240-1243)
            # with a live percent's fill coloured by meterClass (newtab.js:658, 1255).
            snap = lambda v: round(v * S) / S
            yy = snap(yy); bh = snap(6 * K)
            if p["ghost"] == "absent":
                pill(X0, yy, X0 + MW, yy + bh, INK, 0.08)
            else:
                pill(X0 + MW * .25, yy, X0 + MW * .75, yy + bh, INK, TRACK_A)
                if p["ghost"] == "live" and FABLE_PCT > 0:
                    pc = max(0, min(100, FABLE_PCT))
                    pill(X0 + MW * .25, yy, X0 + MW * (.25 + .5 * pc / 100), yy + bh,
                         RED if pc >= 80 else "#c99019" if pc >= 50 else BLUE)
            yy += 6 * K + GAP
        for parts in p["stat_l"]:
            x = TX0
            for j, (t, red) in enumerate(parts):
                if j: g.text((P(x), P(yy + LH(11) / 2)), " \u00b7 ", font=F_V, fill=O_MUTED, anchor="lm"); x += tw(" \u00b7 ", F_V)
                g.text((P(x), P(yy + LH(11) / 2)), t, font=F_V, fill=O_CRIT if red else O_MUTED, anchor="lm"); x += tw(t, F_V)
            yy += LH(11)
        y += pool_h(p)
CX0, CX1, TX0, TX1 = CX0_, CX1_, TX0_, TX1_; X0 = TX0
y = TOP + max(col_h(col) for col in COLS) + 8 * K
star_font = vfont(MONO_FB, 10.5 * K) if MONO_FB else F_HDR
for l in legend_l + notes_l + err_l:
    x = CX0
    for k_, piece in enumerate(l.split("\u2605")):  # the star from a face that has it
        if k_:
            g.text((P(x), P(y + LH(10.5) / 2)), "\u2605", font=star_font, fill=O_MUTED, anchor="lm"); x += tw("\u2605", star_font)
        g.text((P(x), P(y + LH(10.5) / 2)), piece, font=F_HDR, fill=O_MUTED, anchor="lm"); x += tw(piece, F_HDR)
    y += LH(10.5)
img.save(OUT)
if not TEXT: print(OUT)

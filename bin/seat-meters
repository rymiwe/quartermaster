def chip(x, yc, name, style, hue, tone=None):
    """orderly .seat .lab .chip: mono 9.5px, padding 0 4px, 1px border in the vendor hue
    mixed 55% with --line, radius 3px. dashed = metered, dotted = builder only.
    tone: the "$" spend chip's .spend.draw (--warn) or .spend.over (--crit), text and border."""
    w_ = tw(name, F_CHIP) + 8 * K; h_ = 9.5 * 1.35 * K + 2 * K
    y0 = yc - h_ / 2
    toned = {"draw": O_WARN, "over": O_CRIT}.get(tone)
    if toned: hue = toned
    bc = toned or mixhex(hue, .55, O_LINE)
    if style == "solid":
        g.rounded_rectangle((P(x), P(y0), P(x + w_), P(y0 + h_)), radius=P(3 * K), outline=bc, width=max(1, P(1)))
    else:
        dash, gapl = ((4 * K, 2.5 * K) if style == "dashed" else (1 * K, 1.5 * K))
        lw = max(1, P(1))
        def seg(ax, ay, bx, by):
            L = math.hypot(bx - ax, by - ay); t = 0.0
            while t < L:
                e = min(L, t + dash)
                x0_, y0_ = ax + (bx - ax) * t / L, ay + (by - ay) * t / L
                x1_, y1_ = ax + (bx - ax) * e / L, ay + (by - ay) * e / L
                g.rectangle((P(min(x0_, x1_)), P(min(y0_, y1_)), max(P(min(x0_, x1_)) + lw - 1, P(max(x0_, x1_))),
                             max(P(min(y0_, y1_)) + lw - 1, P(max(y0_, y1_)))), fill=bc)
                t = e + gapl
        seg(x + 1, y0, x + w_ - 1, y0); seg(x + 1, y0 + h_ - 1 / S, x + w_ - 1, y0 + h_ - 1 / S)
        seg(x, y0 + 1, x, y0 + h_ - 1); seg(x + w_ - 1 / S, y0 + 1, x + w_ - 1 / S, y0 + h_ - 1)
    g.text((P(x + w_ / 2), P(yc)), name, font=F_CHIP, fill=hue, anchor="mm")
    return w_

def ntick(x, y0, y1):
    """orderly .meter s: 2px ink, 3px past the meter above and below."""
    pill(x - K, y0 - 3 * K, x + K, y1 + 3 * K, O_INK)

y = FRAME_Y + RPY

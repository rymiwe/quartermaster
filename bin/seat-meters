#!/usr/bin/env python3
"""Draw seat-usage meters as a PNG from the cached summary, laid out like orderly:
one shared time scale, every row's pace tick on a single "now" line. No network calls.
Google AI Pro is its own group: Argon weekly, plus Gemini and Claude/GPT.

--phone draws orderly's meters panel: a "Next host" line from
`seat-usage --route host --cached --json` (cache only), one card per subscription
with its cached renewal, family chips, and a stats line per pool. --text also
prints that layout's words as JSON in place of the output path."""
import json, os, sys, time
from datetime import datetime
try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    sys.exit("seat-meters needs Pillow: python3 -m pip install --user pillow")

CACHE = os.environ.get("SEAT_USAGE_CACHE", os.path.expanduser("~/.cache/seat-usage/latest.json"))
FLAGS = {"--phone", "--text"}
ARGS = [a for a in sys.argv[1:] if a not in FLAGS]; PHONE = "--phone" in sys.argv[1:]
TEXT = "--text" in sys.argv[1:]  # also print the phone layout's text lines as JSON instead of the path
OUT = ARGS[0] if ARGS else os.path.join(os.environ.get("TMPDIR") or "/tmp", "seat-meters.png")
BG, INK, DIM = "#141a22", "#e6ebf2", "#8a96a8"
TRACK_A = 0.14  # orderly: color-mix(in srgb, var(--ink) 14%, transparent)
BLUE, RED, GOOGLE = "#5b8fd6", "#c43c3c", "#5468f0"
GOOGLE_LABELS = {"Argon", "Gemini", "Claude/GPT"}
H5, WK = 5 * 3600, 7 * 86400
d = json.load(open(CACHE)); now = time.time()

def seat(pct, reset, window):
    if pct is None or not reset or not window: return None
    e = max(0.0, min(1.0, 1 - (reset - now) / window))
    return {"pct": float(pct), "e": e, "w": float(window), "left": reset - now}

rows = []  # (label, main, five)
def add(label, main, five=None):
    if main or five: rows.append((label, main, five))
add("Claude", seat(d.get("claude_week"), d.get("claude_week_reset_ts"), WK), seat(d.get("claude_5h"), d.get("claude_5h_reset_ts"), H5))
add("ChatGPT", seat(d.get("codex"), d.get("codex_reset_ts"), d.get("codex_window_s") or WK), seat(d.get("codex_5h"), d.get("codex_5h_reset_ts"), H5))
add("Cursor other", seat(d.get("cursor_api_pct"), d.get("cursor_reset_ts"), d.get("cursor_window_s")))
add("Cursor models", seat(d.get("cursor_auto_pct"), d.get("cursor_reset_ts"), d.get("cursor_window_s")))
add("Grok Bot", seat(d.get("bot_pct"), d.get("bot_reset_ts"), d.get("bot_window_s") or WK))
add("SuperGrok", seat(d.get("grok_pct"), d.get("grok_reset_ts"), d.get("grok_window_s") or WK))
# Google AI Pro. Percents in the cache are already used (100 - agy's remaining).
add("Argon", seat(d.get("google_argon_week"), d.get("google_argon_week_reset_ts"), WK))
add("Gemini", seat(d.get("google_gemini_week"), d.get("google_gemini_week_reset_ts"), WK),
    seat(d.get("google_gemini_5h"), d.get("google_gemini_5h_reset_ts"), H5))
add("Claude/GPT", seat(d.get("google_claudegpt_week"), d.get("google_claudegpt_week_reset_ts"), WK),
    seat(d.get("google_claudegpt_5h"), d.get("google_claudegpt_5h_reset_ts"), H5))

# Muse is not in the main cache: read seat-usage's own Muse file. A missing,
# unreadable or stale file (a reset already passed) draws a "no reading" row.
MUSE = os.environ.get("SEAT_USAGE_MUSE_FILE", os.path.expanduser("~/.cache/quartermaster/muse-usage.json"))
def epoch(v):
    if isinstance(v, (int, float)) and not isinstance(v, bool): return float(v)
    try: return datetime.fromisoformat(str(v).strip().replace("Z", "+00:00")).timestamp()
    except ValueError: return None
def muse():
    try:
        m = json.load(open(MUSE)); w, k = m["window"], m["weekly"]
        wr, kr, mins = epoch(w["resets_at"]), epoch(k["resets_at"]), float(w["window_duration_mins"])
        wp, kp = float(w["used_percent"]), float(k["used_percent"])
    except Exception:
        return None
    if None in (wr, kr) or mins <= 0 or wr <= now or kr <= now: return None
    return seat(kp, kr, WK), seat(wp, wr, mins * 60), epoch(m.get("captured_at"))
mu = muse()
MUSE_AT = mu[2] if mu else None
mu = mu[:2] if mu else None
rows.append(("Muse",) + mu if mu else ("Muse", None, None))
# A 5h window whose reset time has passed has rolled over since the reading: drop its bar.
rows = [(l, m, f if f and f["left"] > 0 else None) for l, m, f in rows]
errs = {k: v for k, v in (d.get("errors") or {}).items() if k != "muse"}  # the Muse row says it

# Shared scale: the now line sits where the longest past and longest future just fit.
mains = [m for _, m, _ in rows if m]
past = max([m["w"] * m["e"] for m in mains] or [1]); fut = max([m["w"] * (1 - m["e"]) for m in mains] or [1])
span = past + fut; nowfrac = past / span

def font(sz, bold=False):
    p = "/usr/share/fonts/truetype/dejavu/DejaVuSans%s.ttf" % ("-Bold" if bold else "")
    return ImageFont.truetype(p, sz) if os.path.exists(p) else ImageFont.load_default()
if PHONE:  # tall, narrow, big type: label and numbers above full-width bars
    S = 3
    F, FB, FS = font(17 * S), font(17 * S, True), font(14 * S)
    W, PAD, LBL = 390, 18, 0
    MW = W - 2 * PAD
    row_h = lambda r: 0  # the phone layout measures itself below
else:
    S = 2
    F, FB, FS = font(13 * S), font(13 * S, True), font(11 * S)
    W, PAD, LBL, MW, VAL = 600, 14, 112, 330, 120
    row_h = lambda r: 40 if r[2] else 26
X0 = PAD + LBL
ghead = 16 if (not PHONE and any(r[0] in GOOGLE_LABELS for r in rows)) else 0
Ht = PAD * 2 + 26 + ghead + sum(row_h(r) for r in rows) + (16 * len(errs) + 8 if errs else 0)
img = Image.new("RGB", (W * S, Ht * S), BG); g = ImageDraw.Draw(img)
P = lambda v: int(v * S)

def left_txt(s):
    return f"{s/3600:.1f}h" if s < 2 * 86400 else f"{s/86400:.1f}d"

SS = 4  # supersample factor for bar shapes: Pillow's rounded_rectangle has no antialiasing
def pill(x0, y0, x1, y1, color, alpha=1.0, split=None, color2=None, alpha2=1.0):
    """Antialiased rounded bar like orderly's (border-radius 3px, clamped to a pill),
    composited onto the image at `alpha`. Past x `split` it is `color2` at `alpha2`, a hard stop."""
    X0, Y0, X1, Y1 = x0 * S, y0 * S, x1 * S, y1 * S
    ox, oy = int(X0), int(Y0); w, h = int(X1 + 1) - ox, int(Y1 + 1) - oy
    # under one supersampled pixel there is nothing to draw (and Pillow rejects the inverted box)
    if (X1 - X0) * SS < 1 or (Y1 - Y0) * SS < 1 or w <= 0 or h <= 0: return
    r = min(3 * S, (X1 - X0) / 2, (Y1 - Y0) / 2) * SS
    m = Image.new("L", (w * SS, h * SS), 0)
    box = ((X0 - ox) * SS, (Y0 - oy) * SS, (X1 - ox) * SS - 1, (Y1 - oy) * SS - 1)
    ImageDraw.Draw(m).rounded_rectangle(box, radius=max(0, r - 0.5), fill=round(255 * alpha))
    c = Image.new("RGB", (w * SS, h * SS), color)
    if split is not None:
        sx = max(0, int((split * S - ox) * SS))
        c.paste(color2, (sx, 0, w * SS, h * SS))
        if alpha2 != alpha:  # the shape past the split, at its own opacity
            m2 = Image.new("L", (w * SS, h * SS), 0)
            ImageDraw.Draw(m2).rounded_rectangle(box, radius=max(0, r - 0.5), fill=round(255 * alpha2))
            m.paste(m2.crop((sx, 0, w * SS, h * SS)), (sx, 0))
    img.paste(c.resize((w, h), Image.BOX), (ox, oy), m.resize((w, h), Image.LANCZOS))

def track(st, y, h, width_frac, right=None, left=None, fill_alpha=1.0):
    """Draw one track whose own tick lands on the shared now line. Styled after
    orderly's .meter: a translucent ink track (14%), a blue fill that turns red
    past the pace tick, and red throughout when the pool is full."""
    nx = X0 + MW * nowfrac
    tw = MW * width_frac
    # Keep the track inside the meter area: shrink it (tick still on now) if it would spill.
    if st["e"] > 0: tw = min(tw, (nx - (left if left is not None else X0)) / st["e"])
    if st["e"] < 1: tw = min(tw, ((right if right is not None else X0 + MW) - nx) / (1 - st["e"]))
    tx = nx - tw * st["e"]
    if tw < h: return  # no room left for a track that keeps its tick on now
    pill(tx, y, tx + tw, y + h, INK, TRACK_A)
    fw = tw * min(st["pct"], 100) / 100
    if fw > 0:
        split = tx + tw * st["e"]
        if st["pct"] >= 100:
            pill(tx, y, tx + fw, y + h, RED)
        elif fw > tw * st["e"]:  # the part past the pace tick is red, at full strength
            pill(tx, y, tx + fw, y + h, BLUE, fill_alpha, split=split, color2=RED)
        else:
            pill(tx, y, tx + fw, y + h, BLUE, fill_alpha)
    return tw

def tick(x, y0, y1):
    """orderly's now marker: 2px ink, rounded, 3px past the bars above and below."""
    pill(x - 1, y0 - 3, x + 1, y1 + 3, INK)

if not PHONE:
    g.text((P(PAD), P(PAD)), "Seat usage", font=FB, fill=INK)
    g.text((P(W - PAD), P(PAD)), f"as of {int((now - d.get('ts', now)) / 60)} min ago", font=FS, fill=DIM, anchor="ra")
y = PAD + 30; top = y
g0 = g1 = None
for label, m, f in (rows if not PHONE else []):
    if label in GOOGLE_LABELS and g0 is None:
        g.text((P(PAD), P(y + 8)), "GOOGLE AI PRO", font=FS, fill=GOOGLE, anchor="lm")
        y += 16
        g0 = y
    h = row_h((label, m, f)); cy = y + 10
    g.text((P(PAD), P(cy)), label, font=F, fill=INK, anchor="lm")
    wf = m["w"] / span if m else 0.5
    if m:
        track(m, cy - 3, 5 if f else 6, wf)
    if f:
        track(f, cy + 5, 3, wf if m else 0.5, fill_alpha=.55)
    if not m and not f:
        g.text((P(X0 + MW + 12), P(cy)), "no reading", font=FS, fill=DIM, anchor="lm")
    val = f"{m['pct']:.0f}%" if m else ""
    g.text((P(X0 + MW + 12), P(cy)), val, font=FB, fill=INK, anchor="lm")
    if m: g.text((P(W - PAD), P(cy)), left_txt(m["left"]), font=FS, fill=DIM, anchor="rm")
    if f:
        g.text((P(X0 + MW + 12), P(cy + 14)), f"5h {f['pct']:.0f}%", font=FS, fill=DIM, anchor="lm")
        g.text((P(W - PAD), P(cy + 14)), left_txt(f["left"]), font=FS, fill=DIM, anchor="rm")
    y += h
    if label in GOOGLE_LABELS:
        g1 = y
if g0 is not None and g1 is not None:
    g.rectangle((P(4), P(g0), P(7), P(g1 - 4)), fill=GOOGLE)
if PHONE:
    # Phone layout: orderly's meters rail at its narrow width (extension/newtab.html
    # .rail/.band-hdr/.seat/.chip/.meter, newtab.js renderRail). Sizes are orderly's
    # CSS px times K. Every word here comes from the cache, the Muse file, or
    # `seat-usage --route host --cached --json`; nothing is filled in to look complete.
    import glob, math, subprocess
    K = 1.3
    O_BG, O_PANEL2, O_LINE = "#14171c", "#20262e", "#2b323c"
    O_INK, O_INK2, O_MUTED, O_CRIT = "#e4e8ee", "#a3acb9", "#6f7987", "#e04b4b"
    VHUE = {"claude": "#ff8700", "codex": "#af87ff", "cursor": "#00d7af", "grok": "#5fafff",
            "google": GOOGLE, "muse": "#ff87d7"}
    BG, INK = O_BG, O_INK  # tracks are ink at 14% over the card, as in orderly

    def _find_font(names):
        roots = ["/usr/share/fonts", "/usr/local/share/fonts", os.path.expanduser("~/.local/share/fonts"),
                 os.path.expanduser("~/.fonts"), "/Library/Fonts", os.path.expanduser("~/Library/Fonts")]
        for n in names:
            for r in roots:
                hit = sorted(glob.glob(os.path.join(r, "**", n), recursive=True))
                if hit: return hit[0]
        return None
    # orderly: --sans "IBM Plex Sans", --mono "JetBrains Mono"; DejaVu when they are not installed
    SANS = _find_font(["IBMPlexSans-VariableFont*.ttf", "IBMPlexSans-SemiBold.ttf", "DejaVuSans.ttf"])
    SANS_REG = _find_font(["IBMPlexSans-VariableFont*.ttf", "IBMPlexSans-Regular.ttf", "DejaVuSans.ttf"])
    MONO = _find_font(["JetBrainsMono-VariableFont_wght.ttf", "JetBrainsMono-Regular.ttf", "DejaVuSansMono.ttf"])
    MONO_FB = _find_font(["DejaVuSansMono.ttf"])  # for glyphs JetBrains Mono lacks (the star)
    def vfont(path, px, weight=None):
        if not path: return ImageFont.load_default()
        f = ImageFont.truetype(path, max(1, round(px * S)))
        if weight is not None:
            try:
                axes = f.get_variation_axes()
                f.set_variation_by_axes([weight if a.get("name") in (b"Weight", "Weight") else a["default"] for a in axes])
            except Exception:
                pass  # a static face: its own weight
        return f
    F_TITLE = vfont(SANS, 12 * K, 600)      # .seat b
    F_HOST = vfont(SANS_REG, 13 * K, 400)   # .host-line
    F_WHY = vfont(SANS_REG, 12 * K, 400)    # .host-line .why
    F_HDR = vfont(MONO, 10.5 * K, 400)      # .band-hdr, .rail-key
    F_CHIP = vfont(MONO, 9.5 * K, 400)      # .seat .lab .chip
    F_V = vfont(MONO, 11 * K, 400)          # .seat .v

    def mixhex(c, a, under):
        c, b = [int(c[i:i + 2], 16) for i in (1, 3, 5)], [int(under[i:i + 2], 16) for i in (1, 3, 5)]
        return tuple(round(b[i] + (c[i] - b[i]) * a) for i in range(3))
    hexof = lambda t: "#%02x%02x%02x" % t
    rnd = lambda v: int(math.floor(float(v) + 0.5))  # Ruby's round, as orderly's pct_text
    def fspan(secs):  # orderly formatSpan
        s = max(0, int(secs)); dd, hh, mm = s // 86400, (s % 86400) // 3600, (s % 3600) // 60
        if dd >= 2: return f"{dd}d"
        if dd >= 1: return f"{dd}d {hh}h" if hh else f"{dd}d"
        if hh >= 1: return f"{hh}h {mm}m" if mm else f"{hh}h"
        return f"{mm}m"
    def reset_label(t):  # orderly resetLabel: a time within 24h, a weekday within 7 days, else M/D
        if not isinstance(t, (int, float)) or t <= now: return ""
        dt = datetime.fromtimestamp(t)
        if t - now < 86400:
            h = dt.hour % 12 or 12
            return f"{h}" + (f":{dt.minute:02d}" if dt.minute else "") + ("am" if dt.hour < 12 else "pm")
        if t - now < 7 * 86400: return dt.strftime("%a")
        return f"{dt.month}/{dt.day}"

    CPLAN = {"plus": "Plus", "pro": "Pro"}.get(str(d.get("codex_plan") or ""), str(d.get("codex_plan") or "").title())
    PLAN = d.get("claude_plan") if isinstance(d.get("claude_plan"), str) else ""
    CLAUDE_MAX = "max" in PLAN.lower()
    # Subscription each card belongs to: (paid-through key, will-renew key), as orderly's quota_renewal.
    SUBS = {"claude": ("claude_renews_ts", "claude_renews"), "codex": ("codex_renews_ts", "codex_renews"),
            "cursor": ("cursor_reset_ts", "cursor_renews"), "grok": ("grok_renews_ts", "grok_renews")}
    def renewal(vendor):
        """(text, warn) for the band header, or None when the cache has no date."""
        if vendor not in SUBS: return None
        ts, rn = d.get(SUBS[vendor][0]), d.get(SUBS[vendor][1])
        if not isinstance(ts, (int, float)) or isinstance(ts, bool): return None
        rn = rn if rn in (True, False) else None
        if ts <= now:
            return ("sub ended" if rn is False else "sub renewal due"), False
        verb = "renews" if rn is True else "sub ends" if rn is False else "term ends"
        return f"{verb} {reset_label(ts)}", rn is False and ts - now < 7 * 86400

    # Model families each pool can serve: orderly's FAMILIES/METERED/BUILDER_ONLY
    # (extension/newtab.js). Google AI Pro has no mapping there or in pools.json: no chips.
    FAMILIES = [("Fable", ["claude_fable", "claude_weekly", "cursor_other"]), ("Opus", ["claude_weekly", "cursor_other"]),
                ("Astra", ["codex"]), ("Sol", ["codex", "cursor_other"]), ("Grok", ["cursor_models", "supergrok"]),
                ("Grok Bot", ["grokbot"]), ("Wonder full", ["muse"]), ("Wonder", ["muse"])]
    METERED, BUILDER_ONLY = {"cursor_other"}, {"supergrok"}
    def chips(sid):
        out = []
        for name, src in FAMILIES:
            if sid not in src: continue
            # Claude Pro runs Fable only on usage credits; only Max includes it.
            if name == "Fable" and sid == "claude_weekly" and not CLAUDE_MAX: continue
            out.append((name, "dashed" if sid in METERED else "dotted" if sid in BUILDER_ONLY else "solid"))
        return out

    # label -> (orderly seat id, vendor card, title, as_of key)
    POOL = {"Claude": ("claude_weekly", "claude", "Claude \u00b7 weekly", "claude"),
            "ChatGPT": ("codex", "codex", "Codex \u00b7 weekly", "chatgpt"),
            "Cursor models": ("cursor_models", "cursor", "Cursor \u00b7 Cursor Models", "cursor"),
            "Cursor other": ("cursor_other", "cursor", "Cursor \u00b7 Other Models", "cursor"),
            "Grok Bot": ("grokbot", "cursor", "Grok Bot \u00b7 weekly", "grokbot"),
            "SuperGrok": ("supergrok", "grok", "SuperGrok \u00b7 weekly", "grok"),
            "Argon": ("google_argon", "google", "Google AI Pro \u00b7 Argon", "google"),
            "Gemini": ("google_gemini", "google", "Google AI Pro \u00b7 Gemini", "google"),
            "Claude/GPT": ("google_claudegpt", "google", "Google AI Pro \u00b7 Claude/GPT", "google"),
            "Muse": ("muse", "muse", "Muse \u00b7 weekly", None)}
    RESET_KEY = {"Claude": "claude_week_reset_ts", "ChatGPT": "codex_reset_ts", "Cursor models": "cursor_reset_ts",
                 "Cursor other": "cursor_reset_ts", "Grok Bot": "bot_reset_ts", "SuperGrok": "grok_reset_ts"}
    # The Fable slice: only a Max plan has one, and only a Max plan's cache can say so.
    if CLAUDE_MAX:
        rows.append(("Fable", seat(d.get("fable"), d.get("fable_reset_ts"), WK), None))
        POOL["Fable"] = ("claude_fable", "claude", "Claude \u00b7 Fable slice", "claude")
        RESET_KEY["Fable"] = "fable_reset_ts"
    ORDER = ["Claude", "Fable", "ChatGPT", "Cursor models", "Cursor other", "Grok Bot", "SuperGrok",
             "Argon", "Gemini", "Claude/GPT", "Muse"]
    rows.sort(key=lambda r: ORDER.index(r[0]) if r[0] in ORDER else 99)
    as_of = d.get("as_of") if isinstance(d.get("as_of"), dict) else {}

    def stats(label, m, f):
        """orderly's .v line: percent, 5h, reset, and an old reading. [(text, red)]."""
        if not m and not f: return [("no reading", False)]
        parts = []
        if m: parts.append((f"{rnd(m['pct'])}%", False))
        if f:
            hot = f["pct"] >= 100 or f["pct"] > f["e"] * 100
            parts.append((f"5h {rnd(f['pct'])}%", hot))
        sid, vendor = POOL[label][0], POOL[label][1]
        rk = RESET_KEY.get(label)
        reset = d.get(rk) if rk else None
        if not isinstance(reset, (int, float)) and m: reset = now + m["left"]
        sub = SUBS.get(vendor)
        term = d.get(sub[0]) if sub else None
        same = isinstance(term, (int, float)) and isinstance(reset, (int, float)) and abs(term - reset) < 1
        lbl = reset_label(reset) if m else ""
        if lbl and not same:
            after = sub and d.get(sub[1]) is False and isinstance(term, (int, float)) and reset > term
            parts.append(((f"pool reset {lbl} (after term)" if after else f"resets {lbl}"), False))
        at = as_of.get(POOL[label][3]) if POOL[label][3] else MUSE_AT
        if isinstance(at, (int, float)) and now - at > 15 * 60:
            parts.append((f"stale {fspan(now - at)}", False))
        return parts

    # Cards: one per subscription run, Grok Bot on the Cursor bill.
    cards = []
    for label, m, f in rows:
        sid, vendor, title, _ = POOL.get(label, (label, "", label, None))
        if not cards or cards[-1]["vendor"] != vendor:
            hdr = renewal(vendor)
            names = {"claude": "Claude", "codex": ("Codex " + CPLAN).strip(), "cursor": "Cursor", "grok": "SuperGrok"}
            cards.append({"vendor": vendor, "hue": VHUE.get(vendor, O_MUTED),
                          "header": f"{names[vendor]} \u00b7 {hdr[0]}" if hdr else None,
                          "header_warn": bool(hdr and hdr[1]), "sub": None, "pools": []})
        cards[-1]["pools"].append({"label": label, "seat": sid, "title": title, "chips": chips(sid),
                                   "main": m, "five": f, "stats": stats(label, m, f)})
    for c in cards:  # orderly poolsResetThen: pools whose reset is the renewal instant
        sub = SUBS.get(c["vendor"])
        term = d.get(sub[0]) if sub and c["header"] else None
        names = [p["title"].split(" \u00b7 ", 1)[-1] for p in c["pools"] if p["main"]
                 and isinstance(term, (int, float)) and isinstance(d.get(RESET_KEY.get(p["label"], "")), (int, float))
                 and abs(d[RESET_KEY[p["label"]]] - term) < 1]
        if names:
            c["sub"] = (names[0] + " resets then" if len(names) == 1 else
                        " and ".join(names) + " reset then" if len(names) == 2 else
                        ", ".join(names[:-1]) + ", and " + names[-1] + " reset then")

    # Next host: seat-usage's own pick from the cache, as orderly's host line.
    def route_host():
        exe = os.path.join(os.path.dirname(os.path.realpath(__file__)), "seat-usage")
        if not os.path.exists(exe): return None
        env = dict(os.environ)
        if "SEAT_USAGE_CACHE" in os.environ and "SEAT_USAGE_CACHE_DIR" not in os.environ:
            if os.path.basename(CACHE) != "latest.json": return None  # seat-usage could not read the same file
            env["SEAT_USAGE_CACHE_DIR"] = os.path.dirname(os.path.abspath(CACHE))
        try:
            r = subprocess.run([sys.executable, exe, "--route", "host", "--cached", "--json"], env=env,
                               capture_output=True, text=True, timeout=15)
            rows_ = json.loads(r.stdout) if r.returncode == 0 else None
        except Exception:
            return None
        return next((x for x in rows_ or [] if isinstance(x, dict) and x.get("role") == "host"), None)
    def host_lines(s):
        if not isinstance(s, dict): return "Next host: no cached route", ""
        sid, label = s.get("suggestion"), ""
        if sid == "grokbot": label = "Grok Bot"
        elif sid == "opus":
            eff = s.get("effort") if s.get("effort") not in (None, "", "-") else ""
            # orderly says "on Max"; only a Max plan in the cache says so here
            label = "Opus" + (f" {eff}" if eff else "") + (" on Max" if CLAUDE_MAX else "")
        elif sid: label = str(s.get("family") or sid)
        reason = str(s.get("reason") or "")
        lean_names = [{"cursor_models": "Cursor Models", "grok": "SuperGrok"}.get(i, str(i)) for i in (s.get("lean") or [])]
        lean = ("lean " + lean_names[0] + "".join(", then " + n for n in lean_names[1:])) if lean_names else ""
        if not label and s.get("mode") == "ask":
            text = "Next host: ask" + (f" ({reason})" if reason else "") + (f" \u00b7 {lean}" if lean else "")
        elif label: text = f"Next host: {label}" + (f" ({reason})" if reason else "")
        else: text = "Next host:" + (f" {reason}" if reason else "")
        names = {"grokbot": "Grok Bot", "opus": "Opus on Max" if CLAUDE_MAX else "Opus"}
        wins = {"grokbot": "its weekly allowance",
                "claude_week": "the Max weekly pool" if CLAUDE_MAX else "the Claude weekly pool",
                "claude_5h": "the Max 5h window" if CLAUDE_MAX else "the Claude 5h window"}
        why = []
        for h in s.get("hosts") or []:
            n, w = names.get(h.get("id"), h.get("id")), wins.get(h.get("binding"), h.get("binding") or "its pool")
            used = "" if h.get("used_pct") is None else f" at {rnd(h['used_pct'])}%"
            st = h.get("state")
            if st == "capped": why.append(f"{n}: {w} is used up{used}.")
            elif st == "ahead": why.append(f"{n}: {w} is{used}, ahead of the time elapsed, so it may run out before it resets.")
            elif st == "unknown": why.append(f"{n}: no reading.")
        if why and s.get("mode") == "ask" and not label:
            why.append("No host is clear, so the router leaves the choice to you.")
            if lean: why.append("If you start one anyway, draw Grok from " + lean[5:] + " first.")
        return text, " ".join(why)
    HOST, WHY = host_lines(route_host())
    LEGEND = "dashed = metered \u00b7 dotted = builder only \u00b7 \u2605 first usable pool for the family"
    NOTES = []
    if not PLAN:
        NOTES.append("No Fable chip on Claude: the cache has no Claude plan, and only Max includes Fable.")

    if TEXT:
        print(json.dumps({"host": HOST, "why": WHY, "legend": LEGEND, "notes": NOTES, "errors": list(errs),
                          "cards": [{"header": c["header"], "header_warn": c["header_warn"], "sub": c["sub"],
                                     "pools": [{"title": p["title"], "chips": p["chips"],
                                                "stats": " \u00b7 ".join(t for t, _ in p["stats"]),
                                                "red": [t for t, r in p["stats"] if r]} for p in c["pools"]]}
                                    for c in cards]}))

    # ---- geometry, in 1x px (orderly CSS px * K) ----
    FRAME_X, FRAME_Y = 6, 8
    RPX, RPY = 14 * K, 12 * K                      # .rail padding
    CX0, CX1 = FRAME_X + RPX, W - FRAME_X - RPX     # card box
    BORDER, PADL, PADR, PADY = 3 * K, 8 * K, 10 * K, 6 * K
    TX0, TX1 = CX0 + BORDER + PADL, CX1 - PADR      # card content
    GAP = 4 * K                                      # .seat row-gap
    LH = lambda px: px * 1.5 * K                     # line-height 1.5
    tw = lambda s, f: g.textlength(s, font=f) / S
    def wrap(text, f, width):
        out, line = [], ""
        for w_ in text.split(" "):
            t = (line + " " + w_).strip()
            if line and tw(t, f) > width: out.append(line); line = w_
            else: line = t
        return out + ([line] if line else [])
    def ellipsize(parts, f, width):
        """orderly's .v is nowrap + ellipsis: trim from the end."""
        parts = list(parts)
        while parts and tw(" \u00b7 ".join(t for t, _ in parts), f) > width:
            t, r = parts[-1]
            if len(t) <= 2: parts.pop(); continue
            parts[-1] = (t[:-2].rstrip() + "\u2026" if not t.endswith("\u2026") else t[:-3].rstrip() + "\u2026", r)
        return parts
    g = ImageDraw.Draw(Image.new("RGB", (1, 1)))  # measuring only
    host_l = wrap(HOST, F_HOST, CX1 - CX0 - 16 * K)
    why_l = wrap(WHY, F_WHY, CX1 - CX0 - 16 * K) if WHY else []
    legend_l = wrap(LEGEND, F_HDR, CX1 - CX0)
    notes_l = [l for n in NOTES for l in wrap(n, F_HDR, CX1 - CX0)]
    err_l = [f"{k}: {str(v)[:76]}" for k, v in errs.items()]
    pool_h = lambda p: PADY + LH(12) + GAP + (12 if p["five"] and p["main"] else 6) * K + GAP + LH(11) + PADY \
        if (p["main"] or p["five"]) else PADY + LH(12) + GAP + LH(11) + PADY
    for c in cards:
        c["sub_l"] = wrap(c["sub"], F_HDR, TX1 - TX0) if c["sub"] else []
    hdr_h = lambda c: (3 * K + LH(10.5) * (1 + len(c["sub_l"])) + 2 * K) if c["header"] else 0
    y = FRAME_Y + RPY + LH(13) * len(host_l) + LH(12) * len(why_l) + 8 * K
    for i, c in enumerate(cards):
        y += 6 * K if i else 0
        y += hdr_h(c) + sum(pool_h(p) for p in c["pools"])
    y += 8 * K + LH(10.5) * (len(legend_l) + len(notes_l) + len(err_l)) + RPY
    Ht = int(math.ceil(y + FRAME_Y))
    img = Image.new("RGB", (W * S, Ht * S), O_BG); g = ImageDraw.Draw(img)
    g.rounded_rectangle((P(FRAME_X), P(FRAME_Y), P(W - FRAME_X), P(Ht - FRAME_Y)), radius=P(6 * K),
                        fill=O_PANEL2, outline=O_LINE, width=max(1, P(1)))
    X0, MW = TX0, TX1 - TX0  # the meter spans the card's content width (narrow orderly rail)

    def chip(x, yc, name, style, hue):
        """orderly .seat .lab .chip: mono 9.5px, padding 0 4px, 1px border in the vendor hue
        mixed 55% with --line, radius 3px. dashed = metered, dotted = builder only."""
        w_ = tw(name, F_CHIP) + 8 * K; h_ = 9.5 * 1.35 * K + 2 * K
        y0 = yc - h_ / 2
        bc = mixhex(hue, .55, O_LINE)
        if style == "solid":
            g.rounded_rectangle((P(x), P(y0), P(x + w_), P(y0 + h_)), radius=P(3 * K), outline=bc, width=max(1, P(1)))
        else:
            dash, gapl = ((4 * K, 2.5 * K) if style == "dashed" else (1 * K, 1.5 * K))
            lw = max(1, P(1))
            def seg(ax, ay, bx, by):
                L = math.hypot(bx - ax, by - ay); t = 0.0
                while t < L:
                    e = min(L, t + dash)
                    x0_, y0_ = ax + (bx - ax) * t / L, ay + (by - ay) * t / L
                    x1_, y1_ = ax + (bx - ax) * e / L, ay + (by - ay) * e / L
                    g.rectangle((P(min(x0_, x1_)), P(min(y0_, y1_)), max(P(min(x0_, x1_)) + lw - 1, P(max(x0_, x1_))),
                                 max(P(min(y0_, y1_)) + lw - 1, P(max(y0_, y1_)))), fill=bc)
                    t = e + gapl
            seg(x + 1, y0, x + w_ - 1, y0); seg(x + 1, y0 + h_ - 1 / S, x + w_ - 1, y0 + h_ - 1 / S)
            seg(x, y0 + 1, x, y0 + h_ - 1); seg(x + w_ - 1 / S, y0 + 1, x + w_ - 1 / S, y0 + h_ - 1)
        g.text((P(x + w_ / 2), P(yc)), name, font=F_CHIP, fill=hue, anchor="mm")
        return w_

    def ntick(x, y0, y1):
        """orderly .meter s: 2px ink, 3px past the meter above and below."""
        pill(x - K, y0 - 3 * K, x + K, y1 + 3 * K, O_INK)

    y = FRAME_Y + RPY
    for l in host_l:
        g.text((P(CX0 + 8 * K), P(y + LH(13) / 2)), l, font=F_HOST, fill=O_INK, anchor="lm"); y += LH(13)
    for l in why_l:
        g.text((P(CX0 + 8 * K), P(y + LH(12) / 2)), l, font=F_WHY, fill=O_MUTED, anchor="lm"); y += LH(12)
    y += 8 * K
    for i, c in enumerate(cards):
        y += 6 * K if i else 0
        hue = c["hue"]; top = y; total = hdr_h(c) + sum(pool_h(p) for p in c["pools"])
        R = P(4 * K)
        # .seat: 9% vendor tint; .band-hdr: 16%; 3px vendor stripe on the left; right corners rounded
        g.rounded_rectangle((P(CX0), P(top), P(CX1), P(top + total)), radius=R, fill=mixhex(hue, .09, O_PANEL2),
                            corners=(False, True, True, False))
        if c["header"]:
            g.rounded_rectangle((P(CX0), P(top), P(CX1), P(top + hdr_h(c))), radius=R,
                                fill=mixhex(hue, .16, O_PANEL2), corners=(False, True, False, False))
        g.rectangle((P(CX0), P(top), P(CX0 + BORDER) - 1, P(top + total) - 1), fill=hue)
        if c["header"]:
            yy = top + 3 * K
            head, rest = c["header"].split(" \u00b7 ", 1)
            g.text((P(TX0), P(yy + LH(10.5) / 2)), head + " \u00b7 ", font=F_HDR, fill=O_INK2, anchor="lm")
            g.text((P(TX0 + tw(head + " \u00b7 ", F_HDR)), P(yy + LH(10.5) / 2)), rest, font=F_HDR,
                   fill=O_CRIT if c["header_warn"] else O_INK2, anchor="lm")
            for k_, l in enumerate(c["sub_l"]):
                g.text((P(TX0), P(yy + LH(10.5) * (1.5 + k_))), l, font=F_HDR, fill=O_MUTED, anchor="lm")
            y += hdr_h(c)
        for p in c["pools"]:
            yy = y + PADY
            ly = yy + LH(12) / 2
            g.text((P(TX0), P(ly)), p["title"], font=F_TITLE, fill=O_INK, anchor="lm")
            x = TX0 + tw(p["title"], F_TITLE) + 6 * K
            for name, style in p["chips"]:
                ch = VHUE["grok"] if p["seat"] == "grokbot" else hue  # orderly: Grok Bot chips in Grok blue
                if x + tw(name, F_CHIP) + 8 * K > TX1: break
                x += chip(x, ly, name, style, ch) + 3 * K
            yy += LH(12) + GAP
            m, f = p["main"], p["five"]
            if m or f:
                snap = lambda v: round(v * S) / S  # whole device pixels: no half-lit rows in a bar
                yy = snap(yy)
                if m:
                    track(m, yy, snap(5 * K if f else 6 * K), m["w"] / span)
                if f:
                    track(f, yy + (snap(8 * K) if m else 0), snap(3 * K), m["w"] / span if m else 0.5, fill_alpha=.55)
                bh = (12 if (m and f) else 6) * K
                ntick(X0 + MW * nowfrac, yy, yy + bh)
                yy += bh + GAP
            parts = ellipsize(p["stats"], F_V, TX1 - TX0)
            x = TX0
            for j, (t, red) in enumerate(parts):
                s_ = (" \u00b7 " if j else "") + t
                if j: g.text((P(x), P(yy + LH(11) / 2)), " \u00b7 ", font=F_V, fill=O_MUTED, anchor="lm"); x += tw(" \u00b7 ", F_V)
                g.text((P(x), P(yy + LH(11) / 2)), t, font=F_V, fill=O_CRIT if red else O_MUTED, anchor="lm"); x += tw(t, F_V)
            y += pool_h(p)
    y += 8 * K
    star_font = vfont(MONO_FB, 10.5 * K) if MONO_FB else F_HDR
    for l in legend_l + notes_l + err_l:
        x = CX0
        for k_, piece in enumerate(l.split("\u2605")):  # the star from a face that has it
            if k_:
                g.text((P(x), P(y + LH(10.5) / 2)), "\u2605", font=star_font, fill=O_MUTED, anchor="lm"); x += tw("\u2605", star_font)
            g.text((P(x), P(y + LH(10.5) / 2)), piece, font=F_HDR, fill=O_MUTED, anchor="lm"); x += tw(piece, F_HDR)
        y += LH(10.5)
    img.save(OUT)
    if not TEXT: print(OUT)
    sys.exit(0)
nx = X0 + MW * nowfrac
if not PHONE: pill(nx - 1, top - 4, nx + 1, y - 6, INK)
if not PHONE: g.text((P(nx), P(top - 6)), "now", font=FS, fill=DIM, anchor="mb")
if errs:
    y += 8
    for k, v in errs.items():
        t = f"{k}: {str(v)[:76]}"
        while len(t) > 4 and g.textlength(t, font=FS) > P(W - 2 * PAD): t = t[:-2].rstrip() + "\u2026"
        g.text((P(PAD), P(y)), t, font=FS, fill=DIM); y += 16
img.save(OUT); print(OUT)

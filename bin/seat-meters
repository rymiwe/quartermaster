card_h = lambda c: hdr_h(c) + sum(pool_h(p) for p in c["pools"])
col_h = lambda cs: sum(card_h(c) for c in cs) + 6 * K * max(0, len(cs) - 1)
def columns(cs, n):
    """The cards in reading order, cut into n runs (top to bottom, then the next column) so the
    tallest column is as short as it can be. Order is kept, so ended plans stay last."""
    if n <= 1 or len(cs) <= 1: return [list(cs)] + [[] for _ in range(n - 1)]
    best = None
    for k_ in range(1, len(cs)):
        rest = columns(cs[k_:], n - 1)
        h_ = max(col_h(cs[:k_]), *(col_h(r) for r in rest))
        if best is None or h_ < best[0]: best = (h_, [list(cs[:k_])] + rest)
    return best[1]
NCOL = 2
